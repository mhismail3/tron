# Deterministic Apple CI and release-validation toolchains. The CI Xcode pin is
# not an upper bound for local Mac builds; later Xcode releases are admitted
# only when the generated project, Release build, and signed-artifact validators
# all pass.
# Downloaded tools are verified by scripts/install-ci-tools.sh before use.
TRON_CI_XCODE_VERSION=26.6
TRON_CI_IOS_RUNTIME_VERSION=26.5
TRON_CI_IOS_SIMULATOR_NAME='iPhone 17 Pro'
# Stable release-validation reference. These values do not archive or upload an
# app; production delivery is a manual maintainer action. Xcode 27 beta remains
# a direct physical-device development toolchain only.
TRON_RELEASE_IOS_XCODE_VERSION=26.6
TRON_RELEASE_IOS_XCODE_BUILD=17F113
TRON_RELEASE_IOS_SDK_VERSION=26.5
TRON_RELEASE_IOS_DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
TRON_RELEASE_IOS_DEPLOYMENT_TARGET=26.0
TRON_RELEASE_IOS_MIN_FREE_GB=40

TRON_CI_XCODEGEN_VERSION=2.45.3
TRON_CI_XCODEGEN_URL=https://github.com/yonaskolb/XcodeGen/releases/download/2.45.3/xcodegen.zip
TRON_CI_XCODEGEN_SHA256=0c90f4d28ca57335f9fa78cf5bf6dabfe20a232036dabe36de2eef79cb7c0878
TRON_CI_XCODEGEN_BINARY_SHA256=cf75fdc425f2938aae27fc830cb6233a4dd51467d73a7df74fc0e069a4ccd7a0
TRON_CI_XCODEGEN_PRESETS_SHA256=eebf2958aa8c6b097b6252ec0bcd6a721edbd237d9f694a62ad8961b8c287900
# SHA-256 of the complete symlink-free npm/10.9.4 tree extracted from each
# checksum-verified Node v22.22.0 archive. The arm64 and x64 trees are equal.
# SHA-256 of each pinned Node v22.22.0 macOS binary. Bundle assembly, payload
# verification and DMG packaging read these instead of repeating the digests.
TRON_NODE_ARM64_RUNTIME_SHA256=913b144fdb40638b1acef7974ab3c33fbd527cc0974cb5da467ab1e6ac51b4d4
TRON_NODE_X64_RUNTIME_SHA256=bf0e0ff20d4e5a16436d1ec372e47161e52be8e487db8070ae3f06b01efbba0c
TRON_NODE_NPM_VERSION=10.9.4
TRON_NODE_NPM_TREE_SHA256=adc24b0737566f66bc2ce18251f0bb8168c9cc9177c20fa3379cf129d6091cff
