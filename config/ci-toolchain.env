# Deterministic Apple and release toolchain used by authoritative and shadow CI.
# Downloaded tools are verified by scripts/install-ci-tools.sh before use.
TRON_CI_XCODE_VERSION=26.3
TRON_CI_IOS_RUNTIME_VERSION=26.2
TRON_CI_IOS_SIMULATOR_NAME='iPhone 17 Pro'
TRON_CI_MAC_RUSTFLAGS='-D warnings'
TRON_CI_RUST_IMAGE='rust:1.94.1-bookworm@sha256:6ae102bdbf528294bc79ad6e1fae682f6f7c2a6e6621506ba959f9685b308a55'
TRON_CI_ACTIONLINT_IMAGE='rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667'

# The same checksum-pinned Buildkite agent parses both provider definitions.
# Runtime agents may be newer, but must retain fail-closed secret rejection.
TRON_CI_BUILDKITE_AGENT_VERSION=3.136.2
TRON_CI_BUILDKITE_AGENT_LINUX_AMD64_URL=https://github.com/buildkite/agent/releases/download/v3.136.2/buildkite-agent-linux-amd64-3.136.2.tar.gz
TRON_CI_BUILDKITE_AGENT_LINUX_AMD64_SHA256=3a10ff051d7ea08dfcf16e29f7cbe96370e1929f26eec36621ca3802fecf94e9
TRON_CI_BUILDKITE_AGENT_DARWIN_ARM64_URL=https://github.com/buildkite/agent/releases/download/v3.136.2/buildkite-agent-darwin-arm64-3.136.2.tar.gz
TRON_CI_BUILDKITE_AGENT_DARWIN_ARM64_SHA256=5e0160bdf509c422bbe78e0f5836acc6e9404196c33bf42a9434470ad2fb935a

# Exact self-hosted TestFlight archive toolchain. App Store Connect rejects beta
# SDKs, so live delivery stays on Apple's latest supported stable/RC Xcode pin.
# Xcode 27 beta remains a direct physical-device development toolchain only.
TRON_RELEASE_IOS_XCODE_VERSION=26.6
TRON_RELEASE_IOS_XCODE_BUILD=17F113
TRON_RELEASE_IOS_SDK_VERSION=26.5
TRON_RELEASE_IOS_DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
TRON_RELEASE_IOS_DEPLOYMENT_TARGET=26.0
TRON_RELEASE_IOS_MIN_FREE_GB=40
TRON_RELEASE_RUNNER_VERSION=2.336.0
TRON_RELEASE_RUNNER_URL=https://github.com/actions/runner/releases/download/v2.336.0/actions-runner-osx-arm64-2.336.0.tar.gz
TRON_RELEASE_RUNNER_SHA256=8e8839c49b7060b6b2154f4931f815df330c27f167d53ef2239ee3dfce28b079
TRON_RELEASE_APPLE_ROOT_URL=https://www.apple.com/appleca/AppleIncRootCertificate.cer
TRON_RELEASE_APPLE_ROOT_SHA256=b0b1730ecbc7ff4505142c49f1295e6eda6bcaed7e2c68c5be91b5a11001f024
TRON_RELEASE_APPLE_WWDR_G3_URL=https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer
TRON_RELEASE_APPLE_WWDR_G3_SHA256=dcf21878c77f4198e4b4614f03d696d89c66c66008d4244e1b99161aac91601f

TRON_CI_XCODEGEN_VERSION=2.45.3
