# Deterministic Apple and release toolchain used by GitHub CI.
# Downloaded tools are verified by scripts/install-ci-tools.sh before use.
TRON_CI_XCODE_VERSION=26.3
TRON_CI_IOS_RUNTIME_VERSION=26.2
TRON_CI_IOS_SIMULATOR_NAME='iPhone 17 Pro'

# Exact self-hosted TestFlight archive toolchain. Stable hosted CI above proves
# the iOS 26 deployment floor; this pin supplies iOS 27 SDK-linked UI behavior.
TRON_RELEASE_IOS_XCODE_VERSION=27.0
TRON_RELEASE_IOS_XCODE_BUILD=27A5218g
TRON_RELEASE_IOS_SDK_VERSION=27.0
TRON_RELEASE_IOS_DEVELOPER_DIR=/Applications/Xcode-beta.app/Contents/Developer
TRON_RELEASE_IOS_DEPLOYMENT_TARGET=26.0
TRON_RELEASE_IOS_MIN_FREE_GB=40
TRON_RELEASE_RUNNER_VERSION=2.336.0
TRON_RELEASE_RUNNER_URL=https://github.com/actions/runner/releases/download/v2.336.0/actions-runner-osx-arm64-2.336.0.tar.gz
TRON_RELEASE_RUNNER_SHA256=8e8839c49b7060b6b2154f4931f815df330c27f167d53ef2239ee3dfce28b079

TRON_CI_XCODEGEN_VERSION=2.45.3
TRON_CI_XCODEGEN_URL=https://github.com/yonaskolb/XcodeGen/releases/download/2.45.3/xcodegen.zip
TRON_CI_XCODEGEN_SHA256=0c90f4d28ca57335f9fa78cf5bf6dabfe20a232036dabe36de2eef79cb7c0878

TRON_CI_CREATE_DMG_VERSION=1.3.0
