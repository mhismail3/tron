# Deterministic Apple and release toolchain used by CI.
# Downloaded tools are verified by scripts/install-ci-tools.sh before use.
TRON_CI_XCODE_VERSION=26.3
TRON_CI_IOS_RUNTIME_VERSION=26.2
TRON_CI_IOS_SIMULATOR_NAME='iPhone 17 Pro'
# Exact GitHub-hosted TestFlight archive toolchain. App Store Connect rejects
# beta SDKs, so live delivery stays on Apple's latest supported stable/RC pin.
# Xcode 27 beta remains a direct physical-device development toolchain only.
TRON_RELEASE_IOS_XCODE_VERSION=26.6
TRON_RELEASE_IOS_XCODE_BUILD=17F113
TRON_RELEASE_IOS_SDK_VERSION=26.5
TRON_RELEASE_IOS_DEVELOPER_DIR=/Applications/Xcode_26.6.app/Contents/Developer
TRON_RELEASE_IOS_DEPLOYMENT_TARGET=26.0
TRON_RELEASE_IOS_MIN_FREE_GB=40
TRON_RELEASE_APPLE_WWDR_G3_URL=https://www.apple.com/certificateauthority/AppleWWDRCAG3.cer
TRON_RELEASE_APPLE_WWDR_G3_SHA256=dcf21878c77f4198e4b4614f03d696d89c66c66008d4244e1b99161aac91601f

TRON_CI_XCODEGEN_VERSION=2.45.3
TRON_CI_XCODEGEN_URL=https://github.com/yonaskolb/XcodeGen/releases/download/2.45.3/xcodegen.zip
TRON_CI_XCODEGEN_SHA256=0c90f4d28ca57335f9fa78cf5bf6dabfe20a232036dabe36de2eef79cb7c0878

TRON_CI_ASC_VERSION=3.5.0
TRON_CI_ASC_MACOS_AMD64_URL=https://github.com/rorkai/App-Store-Connect-CLI/releases/download/3.5.0/asc_3.5.0_macOS_amd64
TRON_CI_ASC_MACOS_AMD64_SHA256=f4692760e8ec1a8c188b7ca78a549957f271f1802e0c56e22d7d9e3677c00dfc
