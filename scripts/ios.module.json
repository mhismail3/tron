{
  "layer": "L5",
  "purpose": "iOS test and device tooling: leased simulators and host slots, the xcodebuild wrapper, the real-Gateway E2E and Mac Terminal harnesses, device install and over-the-air share, and artifact and push-config validation.",
  "owns": [
    "ios-gateway-e2e-test",
    "ios-gateway-e2e-fixture.sh",
    "ios-gateway-fault-proxy.mjs",
    "ios-mac-terminal-journey",
    "ios-release-toolchain-doctor.sh",
    "ios-share-publish.py",
    "ios-share-server.py",
    "ios-test-build-identity.py",
    "ios-test-lock.py",
    "ios-test-process.py",
    "ios-test-simulator.py",
    "ios.module.json",
    "patch-ios-gateway-e2e-xctestrun.py",
    "test-ios-artifact-validator.sh",
    "test-ios-process-evidence.py",
    "test-ios-share-browser.js",
    "test-ios-share-concurrency.py",
    "test-ios-test-infrastructure.py",
    "test-tron-ios-device-share.py",
    "tron-ios-device",
    "tron-ios-device-bind.mjs",
    "tron-ios-device-bind.test.mjs",
    "tron-ios-simulator",
    "tron-ios-test",
    "tron-xcodebuild",
    "validate-ios-artifact.py",
    "validate-push-service-config.sh",
    "xcresult-failures.py"
  ],
  "interfaces": [
    {
      "name": "scripts/ios-gateway-e2e-test",
      "kind": "exec",
      "consumers": [
        "ios-app/e2e-tests",
        "ios-app/package",
        "ios-app/ui-tests",
        "repo/mac",
        "repo/verify"
      ],
      "external": "agents and maintainer through the tron-ios skill"
    },
    {
      "name": "scripts/ios-mac-terminal-journey",
      "kind": "exec",
      "consumers": [
        "ios-app/hosted-fixtures",
        "ios-app/ui-tests",
        "repo/verify"
      ]
    },
    {
      "name": "scripts/ios-release-toolchain-doctor.sh",
      "kind": "exec",
      "external": "maintainer before an iOS release (packages/ios-app/docs/development.md)"
    },
    {
      "name": "scripts/ios-share-publish.py",
      "kind": "exec",
      "consumers": [
        "gateway/apps"
      ]
    },
    {
      "name": "scripts/ios-test-build-identity.py",
      "kind": "exec",
      "consumers": [
        "repo/layers",
        "repo/profile",
        "repo/verify"
      ]
    },
    {
      "name": "scripts/ios-test-lock.py",
      "kind": "exec",
      "consumers": [
        "repo/profile",
        "repo/verify"
      ]
    },
    {
      "name": "scripts/ios-test-process.py",
      "kind": "exec",
      "consumers": [
        "repo/mac",
        "repo/profile"
      ]
    },
    {
      "name": "scripts/ios-test-simulator.py",
      "kind": "exec",
      "consumers": [
        "repo/profile"
      ]
    },
    {
      "name": "scripts/test-ios-test-infrastructure.py",
      "kind": "exec",
      "consumers": [
        "repo/policy"
      ]
    },
    {
      "name": "scripts/tron-ios-device",
      "kind": "exec",
      "consumers": [
        "ios-app/ui-tests",
        "repo/cli",
        "repo/ownership",
        "repo/verify"
      ],
      "external": "maintainer device installs (tron-ios skill)"
    },
    {
      "name": "scripts/tron-ios-device-bind.mjs",
      "kind": "exec",
      "external": "maintainer binds a paired device to its CoreDevice id (packages/gateway/src/admin/host-control.md)"
    },
    {
      "name": "scripts/tron-ios-device-bind.test.mjs",
      "kind": "exec",
      "consumers": [
        "gateway/package"
      ]
    },
    {
      "name": "scripts/tron-ios-simulator",
      "kind": "exec",
      "external": "agents and maintainer through the tron-ios skill"
    },
    {
      "name": "scripts/tron-ios-test",
      "kind": "exec",
      "consumers": [
        "ios-app/ui-tests",
        "repo/cli",
        "repo/layers",
        "repo/profile",
        "repo/verify"
      ],
      "external": "agents and maintainer through the tron-ios skill"
    },
    {
      "name": "scripts/tron-xcodebuild",
      "kind": "exec",
      "consumers": [
        "repo/mac",
        "repo/profile",
        "repo/verify"
      ]
    },
    {
      "name": "scripts/validate-ios-artifact.py",
      "kind": "exec",
      "consumers": [
        "ios-app/package"
      ]
    },
    {
      "name": "scripts/validate-push-service-config.sh",
      "kind": "exec",
      "consumers": [
        "ios-app/package",
        "mac-app/gateway-payload",
        "mac-app/package",
        "repo/dev"
      ]
    }
  ],
  "uses": [
    {
      "name": "Library/Developer/Tron/ios",
      "kind": "fs"
    },
    {
      "name": "DEVELOPER_DIR",
      "kind": "env"
    },
    {
      "name": "simctl",
      "kind": "cli"
    },
    {
      "name": "devicectl",
      "kind": "cli"
    }
  ]
}
