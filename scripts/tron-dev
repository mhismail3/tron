#!/usr/bin/env bash
# Developer-owned immutable Gateway lifecycle for port 9848.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEPLOY="$ROOT/scripts/gateway-payload-deploy.mjs"
NODE_VERSION_FILE="$ROOT/.node-version"
[[ -f "$NODE_VERSION_FILE" ]] || { echo "missing canonical Node version file: $NODE_VERSION_FILE" >&2; exit 127; }
NODE_VERSION="$(<"$NODE_VERSION_FILE")"
NODE_VERSION_LINES="$(awk 'END { print NR }' "$NODE_VERSION_FILE")"
[[ "$NODE_VERSION_LINES" == 1 && "$NODE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "canonical Node version must be one strict x.y.z line" >&2; exit 127; }
if [[ -n "${NVM_DIR:-}" && "$NVM_DIR" != /* ]]; then
  echo "relative NVM_DIR is not allowed" >&2
  exit 127
fi
command="${1:-start}"; [[ $# -eq 0 ]] || shift
HOST=""
HOST_EXPLICIT=no
while (($#)); do
  case "$1" in
    --loopback) HOST=127.0.0.1; HOST_EXPLICIT=yes ;;
    --tailscale) HOST=tailscale; HOST_EXPLICIT=yes ;;
    *) echo "unknown Debug Gateway option: $1" >&2; exit 64 ;;
  esac
  shift
done
case "$command" in
  __supervise|status|preflight|start|restart|stop|handoff) ;;
  *) echo "usage: scripts/tron dev [start|restart|status|preflight|stop|handoff] [--tailscale|--loopback]" >&2; exit 64 ;;
esac

node_matches_pin() {
  local candidate="$1" actual
  [[ -x "$candidate" ]] || return 1
  actual="$("$candidate" --version 2>/dev/null || true)"
  [[ "$actual" == "v${NODE_VERSION}" ]]
}
resolve_pinned_node() {
  local candidate nvm_node
  if [[ -n "${TRON_NODE_BIN:-}" ]]; then
    candidate="$TRON_NODE_BIN"
    [[ "$candidate" == /* ]] && node_matches_pin "$candidate" || { echo "TRON_NODE_BIN is not exact Node v${NODE_VERSION}" >&2; exit 127; }
    printf '%s\n' "$candidate"; return
  fi
  candidate="$(command -v node 2>/dev/null || true)"
  if [[ "$candidate" == /* ]] && node_matches_pin "$candidate"; then printf '%s\n' "$candidate"; return; fi
  nvm_node="${NVM_DIR:-${HOME:-}/.nvm}/versions/node/v${NODE_VERSION}/bin/node"
  if [[ "$nvm_node" == /* ]] && node_matches_pin "$nvm_node"; then printf '%s\n' "$nvm_node"; return; fi
  for candidate in "/opt/homebrew/bin/node" "/usr/local/bin/node"; do
    if node_matches_pin "$candidate"; then printf '%s\n' "$candidate"; return; fi
  done
  echo "unable to find exact Node v${NODE_VERSION}; refusing to mutate Debug state" >&2
  exit 127
}
NODE_BIN="$(resolve_pinned_node)"
NPM_BIN="$(dirname "$NODE_BIN")/npm"
[[ "$NODE_BIN" == /* && "$NPM_BIN" == /* && -x "$NPM_BIN" ]] || { echo "missing npm sibling of pinned Node: $NPM_BIN" >&2; exit 127; }
export PATH="$(dirname "$NODE_BIN")${PATH:+:$PATH}"
STATE_DIR="$HOME/.tron-dev/gateway"
STATE_FILE="$STATE_DIR/lifecycle.json"
PID_FILE="$STATE_DIR/dev.pid"
LOG_FILE="$STATE_DIR/dev.log"
COMMAND_LOCK="$STATE_DIR/command.lock"
COMMAND_LOCK_HELD=no
STATE_HELPER="$ROOT/scripts/tron-dev-state.mjs"
LAUNCHER="/Applications/Tron.app/Contents/Library/LoginItems/Tron Agent.app/Contents/MacOS/tron"
require_installed_launcher() {
  [[ -x "$LAUNCHER" ]] || {
    echo "Debug Gateway requires the installed signed launcher at $LAUNCHER; install /Applications/Tron.app first" >&2
    return 1
  }
  /usr/bin/codesign --verify --strict "$LAUNCHER" >/dev/null 2>&1 || {
    echo "Debug Gateway refused an invalid installed launcher signature: $LAUNCHER" >&2
    return 1
  }
}

pid_current() {
  local pid="${1:-}" identity="${2:-}"
  [[ "$pid" =~ ^[0-9]+$ && -n "$identity" ]] || return 1
  [[ "$("$NODE_BIN" "$STATE_HELPER" pid-current "$pid" "$identity")" == yes ]]
}

kill_child() {
  local pid="${1:-}" identity="${2:-}"
  # Revalidate immediately before every signal; PID reuse must never turn a
  # stale lifecycle record into a signal for an unrelated process.
  pid_current "$pid" "$identity" || return 0
  kill -TERM "$pid" 2>/dev/null || true
}

supervisor_live() {
  [[ -f "$STATE_FILE" ]] || return 1
  pid_current "$("$NODE_BIN" "$STATE_HELPER" get "$STATE_FILE" supervisorPid)" "$("$NODE_BIN" "$STATE_HELPER" get "$STATE_FILE" supervisorStartIdentity)"
}

status() {
  "$NODE_BIN" "$STATE_HELPER" status "$STATE_FILE" "$HOST" 9848
}

acquire_command_lock() {
  if ! /usr/bin/shlock -f "$COMMAND_LOCK" -p "$$"; then
    echo "Debug Gateway command is already running; refusing concurrent mutator" >&2
    return 75
  fi
  COMMAND_LOCK_HELD=yes
  trap 'if [[ "$COMMAND_LOCK_HELD" == yes ]]; then rm -f "$COMMAND_LOCK"; fi' EXIT
}

stop_dev() {
  local supervisor_pid="" supervisor_identity="" child_pid="" child_identity=""
  if [[ -f "$STATE_FILE" ]]; then
    supervisor_pid="$("$NODE_BIN" "$STATE_HELPER" get "$STATE_FILE" supervisorPid)"
    supervisor_identity="$("$NODE_BIN" "$STATE_HELPER" get "$STATE_FILE" supervisorStartIdentity)"
    child_pid="$("$NODE_BIN" "$STATE_HELPER" get "$STATE_FILE" childPid)"
    child_identity="$("$NODE_BIN" "$STATE_HELPER" get "$STATE_FILE" childStartIdentity)"
  fi
  "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" stopping intentionalExit=true 2>/dev/null || true
  kill_child "$child_pid" "$child_identity"
  pid_current "$supervisor_pid" "$supervisor_identity" && kill -TERM "$supervisor_pid" 2>/dev/null || true
  for _ in $(seq 1 80); do
    pid_current "$child_pid" "$child_identity" || child_pid=""
    pid_current "$supervisor_pid" "$supervisor_identity" || supervisor_pid=""
    [[ -z "$child_pid" && -z "$supervisor_pid" ]] && break
    sleep 0.05
  done
  [[ -z "$child_pid" && -z "$supervisor_pid" ]] || { echo "Debug Gateway stop timed out; inspect $LOG_FILE" >&2; return 1; }
  rm -f "$PID_FILE"
  "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" stopped intentionalExit=true supervisorPid= supervisorStartIdentity= childPid= childStartIdentity=
}

supervise() {
  local failures=0 child="" child_identity="" supervisor_identity expected_epoch expected_revision expected_fingerprint terminating=0
  require_installed_launcher
  mkdir -p "$STATE_DIR"
  supervisor_identity="$("$NODE_BIN" "$STATE_HELPER" pid-start "$$")"
  "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" starting expectedHost="$HOST" expectedPort=9848 expectedHome="$HOME/.tron-dev" supervisorPid="$$" supervisorStartIdentity="$supervisor_identity" intentionalExit=false restartCount=0
  handle_termination() {
    terminating=1
    "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" stopping intentionalExit=true 2>/dev/null || true
    if pid_current "$child" "$child_identity"; then
      kill_child "$child" "$child_identity"
      set +e; wait "$child"; set -e
    fi
    "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" stopped intentionalExit=true childPid= childStartIdentity= supervisorPid= supervisorStartIdentity= 2>/dev/null || true
    rm -f "$PID_FILE"
    exit 0
  }
  trap handle_termination TERM INT
  trap '' HUP
  while true; do
    if ! read -r expected_epoch expected_revision expected_fingerprint <<<"$("$NODE_BIN" "$STATE_HELPER" selected-identity "$HOME/.tron-dev" dev)"; then
      "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" failed intentionalExit=false
      exit 1
    fi
    "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" starting childPid= childStartIdentity=
    TRON_HOME_NAME=.tron-dev TRON_AGENT_DIR_NAME=agent-dev TRON_GATEWAY_CHANNEL=dev TRON_GATEWAY_SUPERVISED=1 "$LAUNCHER" --host "$HOST" --port 9848 &
    child=$!
    child_identity="$("$NODE_BIN" "$STATE_HELPER" pid-start "$child")"
    "$NODE_BIN" "$STATE_HELPER" write "$STATE_FILE" childPid="$child" childStartIdentity="$child_identity"
    ready=0
    for _ in $(seq 1 80); do
      health="$("$NODE_BIN" "$STATE_HELPER" health "$HOST" 9848)"
      if [[ "$health" == *'"readiness":"ready"'* ]]; then
        ready=1
        read -r runtime_epoch source_revision build_fingerprint <<<"$(printf '%s' "$health" | "$NODE_BIN" -e 'let b="";process.stdin.on("data",d=>b+=d).on("end",()=>{const x=JSON.parse(b);console.log([x.runtimeEpoch??"",x.sourceRevision??"",x.buildFingerprint??""].join(" "))})')"
        [[ "$runtime_epoch" == "$expected_epoch" && "$source_revision" == "$expected_revision" && "$build_fingerprint" == "$expected_fingerprint" ]] || { kill_child "$child" "$child_identity"; break; }
        "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" ready readiness=ready epoch="$runtime_epoch" sourceRevision="$source_revision" buildFingerprint="$build_fingerprint"
        break
      fi
      pid_current "$child" "$child_identity" || break
      sleep 0.25
    done
    ((ready == 1)) || kill_child "$child" "$child_identity"
    set +e; wait "$child"; code=$?; set -e
    ((terminating == 0)) || exit 0
    "$NODE_BIN" "$STATE_HELPER" write "$STATE_FILE" childPid= childStartIdentity= exitCode="$code"
    if ((code == 75)); then
      failures=0
      "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" restarting intentionalExit=true
      sleep 0.2
      continue
    fi
    failures=$((failures + 1))
    if ((failures >= 5 || ready == 0)); then
      "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" failed intentionalExit=false restartCount="$failures"
      exit 1
    fi
    "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" restarting intentionalExit=false restartCount="$failures"
    sleep "$failures"
  done
}

recover_orphan_child() {
  local child_pid="$1" child_identity="$2"
  echo "Debug Gateway supervisor is stale; recovering owned child $child_pid" >&2
  "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" stopping intentionalExit=true
  kill_child "$child_pid" "$child_identity"
  for _ in $(seq 1 80); do
    pid_current "$child_pid" "$child_identity" || {
      "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" stopped intentionalExit=true supervisorPid= supervisorStartIdentity= childPid= childStartIdentity=
      return 0
    }
    sleep 0.05
  done
  echo "Debug Gateway owned orphan $child_pid did not stop; inspect $LOG_FILE" >&2
  return 1
}

build_candidate() {
  (cd "$ROOT/packages/gateway" && "$NPM_BIN" run build) >&2
  if [[ -x "$ROOT/packages/mac-app/Sources/Resources/Gateway/runtime/node-arm64" && -x "$ROOT/packages/mac-app/Sources/Resources/Gateway/runtime/node-x64" ]]; then
    TRON_NODE_BIN="$NODE_BIN" "$ROOT/packages/mac-app/scripts/bundle-gateway.sh" --skip-install --skip-download >&2
  else
    TRON_NODE_BIN="$NODE_BIN" "$ROOT/packages/mac-app/scripts/bundle-gateway.sh" --skip-install >&2
  fi
  local revision version result
  revision="$(git -C "$ROOT" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)"
  [[ -z "$(git -C "$ROOT" status --porcelain --untracked-files=no 2>/dev/null || true)" ]] || revision="${revision}-dirty"
  version="debug-${revision}-$(date -u +%Y%m%d%H%M%S)"
  result="$("$NODE_BIN" "$DEPLOY" stage --channel dev --home "$HOME/.tron-dev" --source "$ROOT/packages/mac-app/Sources/Resources/Gateway" --version "$version" --source-revision "$revision")"
  printf '%s' "$result" | "$NODE_BIN" -e 'let b="";process.stdin.on("data",d=>b+=d).on("end",()=>{const x=JSON.parse(b);console.log(`${x.manifest.version} ${x.manifest.payloadFingerprint}`)})'
}

if supervisor_live; then SUPERVISOR_LIVE=yes; else SUPERVISOR_LIVE=no; fi
HOST="$("$NODE_BIN" "$STATE_HELPER" resolve-command-host "$STATE_FILE" "$HOST" "$HOST_EXPLICIT" "$SUPERVISOR_LIVE")" || exit 64
case "$command" in
  start|restart|handoff) require_installed_launcher ;;
esac
case "$command" in
  start|restart|stop|handoff)
    mkdir -p "$STATE_DIR"
    acquire_command_lock || exit $?
    ;;
esac
case "$command" in
  __supervise) supervise ;;
  status|preflight) status ;;
  stop) stop_dev ;;
  handoff)
    supervisor_live || { echo "Debug Gateway is not supervised and ready" >&2; exit 1; }
    [[ "$(status)" == *'"readiness":"ready"'* ]] || { echo "Debug Gateway is not ready" >&2; exit 1; }
    "$NODE_BIN" "$DEPLOY" handoff-debug --host "$HOST" --dev-home "$HOME/.tron-dev" --stable-home "$HOME/.tron" --stable-bundled-root /Applications/Tron.app/Contents/Resources/Gateway
    ;;
  start|restart)
    identity_line="$(build_candidate)"
    identity_line="$("$NODE_BIN" "$STATE_HELPER" validate-build-identity "$identity_line")" || exit 78
    read -r version payload_fingerprint <<<"$identity_line"
    if supervisor_live; then
      token_args=(--channel dev --home "$HOME/.tron-dev" --version "$version" --fingerprint "$payload_fingerprint" --host "$HOST" --port 9848 --command-id "debug-update-$(date +%s)-$$")
      TRON_GATEWAY_CHANNEL=dev TRON_GATEWAY_SUPERVISED=1 "$NODE_BIN" "$DEPLOY" promote "${token_args[@]}" >&2
      echo "Debug Gateway ready on 9848 (version $version, fingerprint ${payload_fingerprint:0:12})" >&2
      printf '%s %s\n' "$version" "$payload_fingerprint"
    else
      recorded_lifecycle="$("$NODE_BIN" "$STATE_HELPER" get "$STATE_FILE" lifecycle)"
      recorded_child_pid="$("$NODE_BIN" "$STATE_HELPER" get "$STATE_FILE" childPid)"
      recorded_child_identity="$("$NODE_BIN" "$STATE_HELPER" get "$STATE_FILE" childStartIdentity)"
      if pid_current "$recorded_child_pid" "$recorded_child_identity"; then child_recorded_live=yes; else child_recorded_live=no; fi
      if /usr/sbin/lsof -nP -iTCP:9848 -sTCP:LISTEN >/dev/null 2>&1; then listener_present=yes; else listener_present=no; fi
      admission="$("$NODE_BIN" "$STATE_HELPER" start-admission "$recorded_lifecycle" "$SUPERVISOR_LIVE" "$child_recorded_live" "$listener_present")"
      case "$admission" in
        recover-orphan)
          recover_orphan_child "$recorded_child_pid" "$recorded_child_identity" || exit 1
          if /usr/sbin/lsof -nP -iTCP:9848 -sTCP:LISTEN >/dev/null 2>&1; then
            echo "Port 9848 is already owned by another process; refusing Debug takeover" >&2
            exit 65
          fi
          ;;
        foreign-listener)
          echo "Port 9848 is already owned by another process; refusing Debug takeover" >&2
          exit 65
          ;;
        mark-failed) "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" failed intentionalExit=false ;;
        finish-stopping) "$NODE_BIN" "$STATE_HELPER" transition "$STATE_FILE" stopped intentionalExit=true ;;
        start) ;;
        invalid-lifecycle)
          echo "Debug Gateway has invalid lifecycle state; refusing start" >&2
          exit 78
          ;;
        *) echo "Debug Gateway start admission failed; refusing start" >&2; exit 78 ;;
      esac
      TRON_DEV_STOPPED=1 "$NODE_BIN" "$DEPLOY" select-dev --channel dev --home "$HOME/.tron-dev" --version "$version" --fingerprint "$payload_fingerprint" >&2
      if [[ "$HOST" == tailscale ]]; then supervisor_host_arg=--tailscale; else supervisor_host_arg=--loopback; fi
      nohup "$0" __supervise "$supervisor_host_arg" >"$LOG_FILE" 2>&1 &
      supervisor_pid=$!
      printf '%s\n' "$supervisor_pid" >"$PID_FILE"
      for _ in $(seq 1 80); do
        if supervisor_live && [[ "$(status)" == *'"readiness":"ready"'* ]]; then
          echo "Debug Gateway ready on 9848 (version $version, fingerprint ${payload_fingerprint:0:12})" >&2
          printf '%s %s\n' "$version" "$payload_fingerprint"
          exit 0
        fi
        sleep 0.25
      done
      echo "Debug Gateway failed readiness; inspect $LOG_FILE" >&2
      exit 1
    fi
    ;;
  *) echo "usage: scripts/tron dev [start|restart|status|preflight|stop|handoff] [--tailscale|--loopback]" >&2; exit 64 ;;
esac
