#!/usr/bin/env bash
# Generate the disposable iOS Xcode project with the repository-pinned XcodeGen.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$ROOT/.ci-tools/bin:/opt/homebrew/bin:$PATH"
command -v xcodegen >/dev/null || {
  echo "error: pinned XcodeGen is missing; run scripts/install-ci-tools.sh xcodegen" >&2
  exit 74
}
"$ROOT/scripts/verify-ci-toolchain.sh" xcodegen
(cd "$ROOT/packages/ios-app" && exec xcodegen generate "$@")
