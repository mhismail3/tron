#!/usr/bin/env python3
"""Deterministic iOS scenario profiler behind `scripts/tron-profile ios`.

Builds the optimized `DevicePerformance` hosted-test products for this
worktree, runs one selected scenario test per report on the repository-owned
test simulator under the same lease as `scripts/tron-ios-test`, reads the
per-iteration `com.tron.profile.*` XCTMetric values back from the xcresult, and
hands them to `scripts/tron_profile_report.py`, which owns the report schema and
comparison policy. A value the process could not measure is omitted with a
warning; a run that did not execute the scenario fails with evidence paths.

With `--trace TEMPLATE` it also records an xctrace capture of the hosted test
process: the scenario waits (bounded) until the recording is confirmed started,
reports each measured window's wall-clock bounds, and waits after its last
iteration until the recording is stopped. Instruments' kernel profiling is
exclusive to one session per Mac, so traced runs serialize on a host-wide lock
and wait (bounded) for any other Instruments session to end. `scripts/tron_profile_attribution.py`
turns the trace into `attribution.json`/`attribution.md`. Instruments overhead
distorts the resource metrics of a traced run, so its report is marked traced
and `scripts/tron-profile compare` refuses it.
"""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import json
import fcntl
import os
from pathlib import Path
import re
import secrets
import shlex
import signal
import subprocess
import sys
import threading
import time
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))
import tron_profile_attribution as attribution  # noqa: E402

ROOT = Path(__file__).resolve().parent.parent
IOS = ROOT / "packages/ios-app"
REPORT = ROOT / "scripts/tron_profile_report.py"
LOCKER = ROOT / "scripts/ios-test-lock.py"
SIMULATOR = ROOT / "scripts/ios-test-simulator.py"
PROCESS = ROOT / "scripts/ios-test-process.py"
IDENTITY = ROOT / "scripts/ios-test-build-identity.py"
SCHEME = "Tron Device Performance"
CONFIGURATION = "DevicePerformance"
METRIC_PREFIX = "com.tron.profile."

EXIT_OK = 0
EXIT_USAGE = 2
EXIT_SCENARIO_FAILURE = 65
EXIT_DESTINATION = 66
EXIT_BUILD_FAILURE = 70
EXIT_LOCKED = 73
EXIT_RUNNER = 74
EXIT_TIMEOUT = 75
EXIT_SELF_TEST = 77

# name -> (test identifier, default window seconds, description). The Swift
# tests skip unless TRON_PROFILE_SCENARIO names them, so these must match.
SCENARIOS: dict[str, tuple[str, float, str]] = {
    "idle-dashboard": (
        "ProfileDashboardScenarioTests/testIdleDashboard", 30.0,
        "Dashboard mounted over 60 sessions in 6 workspaces; 3 running sessions send a session.summary heartbeat every 10 s.",
    ),
    "idle-chat": (
        "ProfileChatScenarioTests/testIdleChat", 30.0,
        "Chat mounted on a 200-row transcript; no events.",
    ),
    "streaming-reply": (
        "ProfileChatScenarioTests/testStreamingReply", 12.0,
        "Chat on history; cumulative session.progress frames (thinking, then Markdown text) at the Gateway's 150 ms leading+trailing cadence.",
    ),
    "tool-loop": (
        "ProfileChatScenarioTests/testToolLoop", 15.0,
        "Chat near the 512-item/600 KB page bound; a session.snapshot per canonical append, session.toolProgress at 5/s per running tool, a session.summary per snapshot.",
    ),
    "composer-typing": (
        "ProfileComposerScenarioTests/testComposerTyping", 10.0,
        "Typing into the composer through ComposerDraftCoordinator and the real ComposerDraftStore while 4 drafts hold image attachments; 400 ms pauses.",
    ),
    "summary-storm": (
        "ProfileDashboardScenarioTests/testSummaryStorm", 15.0,
        "Dashboard mounted; 5 running sessions each send a session.summary every 750 ms (snapshot rate).",
    ),
}
CONTROL_SCENARIOS: dict[str, tuple[str, float, str]] = {
    "control": ("ProfileControlScenarioTests/testControl", 2.0, "Fixed synthetic 10 Hz main-thread workload."),
    "control-cpu": ("ProfileControlScenarioTests/testControlExtraCPU", 2.0, "control plus the same arithmetic again each tick."),
    "control-disk": ("ProfileControlScenarioTests/testControlExtraDisk", 2.0, "control plus a synced 256 KiB file write each tick."),
    "control-wakeups": ("ProfileControlScenarioTests/testControlExtraWakeups", 2.0, "control plus a 200 Hz main-run-loop timer."),
}
ALL_SCENARIOS = {**SCENARIOS, **CONTROL_SCENARIOS}
# Self-test: each variant must regress its metric beyond the noise bound
# against `control`. CPU falls back to process CPU time only where the kernel
# exposes no instruction counter.
SELF_TEST_EXPECTATIONS = {
    "control-cpu": ("cpu.instructions", "cpu.time"),
    "control-disk": ("disk.logical_writes",),
    "control-wakeups": ("wakeups.interrupt",),
}

# Report metadata for every value the Swift ProfileResourceMetric emits.
METRICS: dict[str, tuple[str, str]] = {
    "cpu.instructions": ("instructions", "Instructions retired by the whole app process in the window (primary CPU metric; least sensitive to host contention)."),
    "cpu.cycles": ("cycles", "CPU cycles of the whole app process in the window."),
    "cpu.time": ("ns", "Process CPU time, user plus system, all threads."),
    "cpu.main_thread_time": ("ns", "CPU time of the main thread."),
    "energy.cpu": ("nJ", "Kernel-estimated CPU energy of the process (host CPU, not device battery)."),
    "wakeups.interrupt": ("wakeups", "Times a thread of the process was woken by an interrupt (timers, I/O)."),
    "wakeups.idle": ("wakeups", "Wakeups that brought the CPU package out of idle; near zero on a busy host."),
    "disk.bytes_written": ("B", "Bytes the process wrote to storage (physical I/O attributed at write-back)."),
    "disk.bytes_read": ("B", "Bytes the process read from storage (cache hits are free)."),
    "disk.logical_writes": ("B", "Bytes the process wrote through the file system, before caching."),
    "memory.peak_footprint": ("B", "Peak physical footprint during the window."),
    "time.wall": ("ns", "Wall time of the measured window."),
}
ESSENTIAL_METRICS = ("time.wall", "cpu.time")

# Tracing handshake bounds (seconds), passed to the hosted test so both sides
# give up at the same time: attaching and starting the recording, and stopping
# and saving it after the last window.
TRACE_RECORDING_TIMEOUT = 300
TRACE_STOP_TIMEOUT = 600
# How long a traced run waits for the host-wide trace lock and for another
# session's Instruments processes to exit before failing.
TRACE_HOST_WAIT = int(os.environ.get("TRON_PROFILE_TRACE_HOST_WAIT_SECONDS", 900))
TRACE_HOST_LOCK = Path.home() / "Library/Developer/Tron/profiles-instruments.lock"
# Recording clients. Their DTServiceHub helpers are not matched on their own:
# xcodebuild test runs of every session spawn DTServiceHub too, and idle
# orphans linger for minutes without recording.
INSTRUMENTS_PROCESS = re.compile(r"(/usr/bin/xctrace |/Instruments\.app/Contents/MacOS/Instruments)")
KPERF_LOCKED = "could not lock kperf"
# The CPU control variant's workload function
# (ProfileControlScenarioTests.swift); `--self-test --trace time-profiler`
# requires it among the top self-time symbols of a traced control-cpu run.
CONTROL_WORKLOAD_SYMBOL = "controlExtraCPUWorkload"
CONTROL_WORKLOAD_RANK = 5
TRACED_WARNING = (
    "traced run: Instruments overhead distorts every resource metric in this report; use it only to attribute "
    "cost (attribution.md), never for compare decisions (compare refuses traced reports)"
)


class ProfileError(Exception):
    def __init__(self, message: str, code: int = EXIT_RUNNER) -> None:
        super().__init__(message)
        self.code = code


# ---------------------------------------------------------------- xcresult ---

def _walk(value: Any):
    if isinstance(value, dict):
        yield value
        for child in value.values():
            yield from _walk(child)
    elif isinstance(value, list):
        for child in value:
            yield from _walk(child)


def extract_measurements(metrics_document: Any, test_identifier: str) -> dict[str, dict[str, Any]]:
    """Return {metric id: {unit, polarity, values}} for one test's profile metrics.

    `xcresulttool get test-results metrics` lists each test with its runs and
    every measurement's per-iteration values. Only `com.tron.profile.*`
    identifiers are read; XCTest's own metrics are ignored.
    """
    found: dict[str, dict[str, Any]] = {}
    tests = [
        node for node in _walk(metrics_document)
        if isinstance(node.get("testIdentifier"), str)
        and node["testIdentifier"].removesuffix("()") == test_identifier
    ]
    for test in tests:
        for node in _walk(test):
            identifier = node.get("identifier")
            if not isinstance(identifier, str) or not identifier.startswith(METRIC_PREFIX):
                continue
            values = node.get("measurements")
            if not isinstance(values, list) or not values:
                raise ProfileError(f"measurement {identifier} in the xcresult has no per-iteration values")
            numbers = []
            for value in values:
                if isinstance(value, bool) or not isinstance(value, (int, float)):
                    raise ProfileError(f"measurement {identifier} has a non-numeric value {value!r}")
                numbers.append(float(value))
            metric_id = identifier[len(METRIC_PREFIX):]
            if metric_id in found:
                raise ProfileError(f"measurement {identifier} appears more than once for {test_identifier}")
            found[metric_id] = {
                "unit": node.get("unitOfMeasurement"),
                "polarity": node.get("polarity"),
                "values": numbers,
            }
    return found


def build_samples(
    measurements: dict[str, dict[str, Any]],
    iterations: int,
    context: dict[str, Any],
) -> dict[str, Any]:
    """Map extracted values to a tron.profile-samples.v1 document.

    Fails when the run did not measure the essentials or produced a different
    iteration count; omits (with a warning) any known metric the process could
    not provide, instead of reporting it as zero.
    """
    if not measurements:
        raise ProfileError("the xcresult contains no com.tron.profile measurements; the scenario did not measure anything")
    for metric_id in ESSENTIAL_METRICS:
        if metric_id not in measurements:
            raise ProfileError(f"the xcresult lacks the essential metric {metric_id}")
    warnings = list(context.get("warnings", []))
    metrics: dict[str, Any] = {}
    for metric_id, measurement in sorted(measurements.items()):
        values = measurement["values"]
        if len(values) != iterations:
            raise ProfileError(
                f"{metric_id} has {len(values)} values for {iterations} requested iterations; refusing a partial run"
            )
        if metric_id in METRICS:
            unit, description = METRICS[metric_id]
            if measurement["unit"] not in (None, unit):
                raise ProfileError(f"{metric_id} arrived in unit {measurement['unit']!r}, expected {unit!r}")
        elif metric_id.startswith("scenario.render."):
            unit = measurement["unit"] or "count"
            description = ("How the mounted surface rendered the workload at the end of the window (the scenario's "
                           "render check); every reported iteration passed it.")
        elif metric_id.startswith("scenario."):
            unit = measurement["unit"] or "count"
            description = "Workload applied by the scenario's scripted transport or driver in the window."
        else:
            raise ProfileError(f"unknown profile metric {metric_id}; add it to METRICS with its unit and meaning")
        metrics[metric_id] = {"unit": unit, "better": "lower", "values": values, "description": description}
    if all(value == 0 for value in metrics["cpu.time"]["values"]):
        raise ProfileError("process CPU time is zero in every iteration; the measurement path is broken")
    for metric_id in METRICS:
        if metric_id not in metrics:
            warnings.append(f"{metric_id} not measured: this process does not expose it (omitted, not zero)")
    return {"schema": "tron.profile-samples.v1", "metrics": metrics, "context": {**context, "warnings": warnings}}


def validate_summary(summary: Any, scenario: str) -> None:
    if not isinstance(summary, dict):
        raise ProfileError("invalid XCTest summary")
    counts = {key: summary.get(key) for key in ("passedTests", "failedTests", "skippedTests", "totalTestCount")}
    if any(not isinstance(value, int) or isinstance(value, bool) for value in counts.values()):
        raise ProfileError(f"XCTest summary lacks test counts: {counts}")
    if counts["failedTests"]:
        failures = [
            str(item.get("failureText", "")).strip()
            for item in summary.get("testFailures", []) if isinstance(item, dict)
        ]
        raise ProfileError(
            f"scenario {scenario} failed: " + ("; ".join(failures) or "see the xcresult"), EXIT_SCENARIO_FAILURE
        )
    if counts["passedTests"] != 1 or counts["totalTestCount"] != 1:
        raise ProfileError(
            f"scenario {scenario} did not execute exactly one passing test (counts {counts}); "
            "a skipped test means the scenario selection did not reach the test process",
            EXIT_SCENARIO_FAILURE,
        )


def self_test_verdicts(comparisons: dict[str, dict[str, Any]]) -> list[tuple[str, str, str, bool]]:
    """Return (variant, metric, verdict, passed) for each self-test expectation."""
    rows = []
    for variant, candidates in SELF_TEST_EXPECTATIONS.items():
        comparison = comparisons.get(variant)
        metrics = (comparison or {}).get("metrics", {})
        metric = next((name for name in candidates if name in metrics and "delta" in metrics[name]), None)
        if metric is None:
            rows.append((variant, "/".join(candidates), "not measured", False))
            continue
        verdict = metrics[metric]["verdict"]
        rows.append((variant, metric, verdict, verdict == "regression"))
    return rows


# ------------------------------------------------------------------ runner ---

def development_state_path() -> Path:
    """The remembered Development simulator's marker, as the runner names it."""
    return Path(
        os.environ.get("TRON_IOS_SIMULATOR_STATE_DIR", Path.home() / ".tron/internal/run")
    ) / "ios-simulator-udid"


def run(command: list[str], **kwargs: Any) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, text=True, **kwargs)


class Lane:
    """The lane scripts/tron-ios-test would use for this worktree and selection.

    Asked of the one selection owner the runner and the Gateway E2E harness use,
    so a profile run leases, releases and reclaims exactly the runner's lane.
    """

    def __init__(self, requested: str | None) -> None:
        command = [sys.executable, str(SIMULATOR), "lane", "--worktree", str(ROOT)]
        if requested is not None:
            command += ["--lane", requested]
        result = run(command, capture_output=True)
        fields = result.stdout.splitlines()
        if result.returncode != 0 or len(fields) != 5:
            raise ProfileError(result.stderr.strip() or "cannot select the iOS test lane", EXIT_RUNNER)
        self.label = fields[0]
        self.state_root = Path(fields[1])
        self.device_name = fields[2]
        self.lane_root = Path(fields[3])
        self.default_state_root = Path(fields[4])


def bounded(log: Path, evidence: Path, overall: float, no_output: float, artifact: Path, command: list[str],
            environment: dict[str, str] | None = None) -> int:
    """Run under scripts/ios-test-process.py; the complete output goes only to `log`."""
    process = [
        sys.executable, str(PROCESS), "--log", str(log), "--evidence-dir", str(evidence),
        "--overall-seconds", str(int(overall)), "--no-output-seconds", str(int(no_output)),
        "--artifact", str(artifact), "--", *command,
    ]
    child = subprocess.Popen(
        process, env={**os.environ, "NSUnbufferedIO": "YES", **(environment or {})}, stdout=subprocess.DEVNULL
    )
    # The lease holder signals this command's whole process group, but
    # xcodebuild runs in the bounded runner's own session; relay the signal to
    # the runner, which stops that session.
    def forward(signum: int, _frame: object) -> None:
        if child.poll() is None:
            child.send_signal(signum)

    previous = {signum: signal.signal(signum, forward) for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)}
    try:
        return child.wait()
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)


class TraceRecorder:
    """Owns one `xctrace record --attach` of the hosted test process.

    A background thread waits for the test's `process.json`, starts xctrace
    against that pid on the owned simulator, confirms the recording through
    xctrace's `--notify-tracing-started` Darwin notification, then writes
    `recording`. When the test writes `measured` (or `finish()` is called) it
    stops xctrace with SIGINT so the trace is saved, and writes `stopped`.
    Only processes this object started are ever signalled.
    """

    def __init__(self, template: str, simulator_id: str, handshake: Path, output: Path, log: Path,
                 time_limit: float) -> None:
        self.template = template
        self.simulator_id = simulator_id
        self.handshake = handshake
        self.output = output
        self.log = log
        self.time_limit = time_limit
        self.pid: int | None = None
        self.error: str | None = None
        self.recording_started = False
        self._finish = threading.Event()
        self._xctrace: subprocess.Popen[bytes] | None = None
        self._notifier: subprocess.Popen[bytes] | None = None
        self._thread = threading.Thread(target=self._run, name="xctrace-recorder", daemon=True)

    def start(self) -> None:
        self.handshake.mkdir(parents=True)
        self._thread.start()

    def command(self, pid: int, notification: str) -> list[str]:
        mode, template, instruments = attribution.TEMPLATES[self.template]
        # Host mode samples every process and attribution keeps only `pid`.
        target = ["--all-processes"] if mode == "host" else ["--device", self.simulator_id, "--attach", str(pid)]
        command = ["xcrun", "xctrace", "record", *target, "--output", str(self.output), "--no-prompt",
                   "--notify-tracing-started", notification, "--time-limit", f"{int(self.time_limit)}s"]
        if template:
            command += ["--template", template]
        for instrument in instruments:
            command += ["--instrument", instrument]
        return command

    def _marker(self, name: str, content: str = "") -> None:
        temporary = self.handshake / f".{name}.tmp"
        temporary.write_text(content)
        temporary.replace(self.handshake / name)

    def _abort(self, reason: str) -> None:
        self.error = reason
        self._marker("abort", reason)

    def _wait_for(self, name: str, timeout: float) -> bool:
        deadline = time.monotonic() + timeout
        while not (self.handshake / name).exists():
            if self._finish.is_set() or time.monotonic() > deadline:
                return False
            if self._xctrace is not None and self._xctrace.poll() is not None:
                return False
            time.sleep(0.2)
        return True

    def _run(self) -> None:
        try:
            if not self._wait_for("process.json", self.time_limit):
                if not self._finish.is_set():
                    self._abort("the hosted test never reported its process id")
                return
            self.pid = int(json.loads((self.handshake / "process.json").read_text())["pid"])
            notification = f"com.tron.profile.recording.{secrets.token_hex(8)}"
            self._notifier = subprocess.Popen(["notifyutil", "-1", notification],
                                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.5)  # let notifyutil register before xctrace can post
            with self.log.open("ab") as log:
                self._xctrace = subprocess.Popen(
                    self.command(self.pid, notification), stdout=log, stderr=subprocess.STDOUT,
                    stdin=subprocess.DEVNULL, start_new_session=True,
                )
            print(f"Recording {self.template} trace of pid {self.pid}: {self.output}", flush=True)
            deadline = time.monotonic() + TRACE_RECORDING_TIMEOUT - 30
            while self._notifier.poll() is None:
                if self._xctrace.poll() is not None:
                    self._abort(f"xctrace exited with status {self._xctrace.returncode} before recording; log: {self.log}")
                    return
                if self._finish.is_set() or time.monotonic() > deadline:
                    self._abort(f"xctrace did not confirm recording in time; log: {self.log}")
                    return
                time.sleep(0.1)
            self.recording_started = True
            self._marker("recording")
            self._wait_for("measured", self.time_limit)
            if self._xctrace.poll() is not None:
                self._abort(f"xctrace exited with status {self._xctrace.returncode} during the measured windows; "
                            f"log: {self.log}")
                return
        except (OSError, ValueError, KeyError) as error:
            self._abort(f"trace recorder failed: {error}")
        finally:
            self._stop()

    def _stop(self) -> None:
        if self._notifier is not None and self._notifier.poll() is None:
            self._notifier.kill()
            self._notifier.wait()
        process = self._xctrace
        helpers = self._helpers()
        if process is not None and process.poll() is None:
            process.send_signal(signal.SIGINT)
            # A started recording needs time to save; one that never started
            # has nothing to save.
            try:
                process.wait(timeout=TRACE_STOP_TIMEOUT - 60 if self.recording_started else 30)
            except subprocess.TimeoutExpired:
                self._kill_group(process)
                self.error = self.error or f"xctrace did not stop within its bound; log: {self.log}"
        self._reap_helpers(helpers)
        if process is not None and process.returncode not in (0, None) and self.error is None:
            detail = self.log.read_text(errors="replace") if self.log.exists() else ""
            if KPERF_LOCKED in detail:
                self.error = ("another Instruments session holds this Mac's kernel profiling (kperf) and the "
                              f"recording is empty; retry when it ends; log: {self.log}")
            else:
                self.error = f"xctrace exited with status {process.returncode}; log: {self.log}"
        self._marker("stopped")

    def _helpers(self) -> list[int]:
        """DTServiceHub helpers of our running xctrace (their own process
        groups, so signalling xctrace's group does not reach them)."""
        if self._xctrace is None or self._xctrace.poll() is not None:
            return []
        children = run(["pgrep", "-P", str(self._xctrace.pid)], capture_output=True, timeout=30).stdout.split()
        return [int(pid) for pid in children if pid.isdigit()]

    @staticmethod
    def _reap_helpers(helpers: list[int]) -> None:
        """xctrace leaves its DTServiceHub behind for minutes after exiting;
        stop the ones this recording started (re-checked by name, so a reused
        pid is never signalled)."""
        for pid in helpers:
            command = run(["ps", "-o", "command=", "-p", str(pid)], capture_output=True, timeout=30).stdout
            if "DTServiceHub" in command:
                try:
                    os.kill(pid, signal.SIGKILL)  # it ignores SIGTERM
                except ProcessLookupError:
                    pass

    @staticmethod
    def _kill_group(process: subprocess.Popen[bytes]) -> None:
        """Kill xctrace with the helpers it spawned (its own session)."""
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()

    def finish(self) -> None:
        """Stop and reap everything this recorder started (idempotent)."""
        self._finish.set()
        self._thread.join(timeout=TRACE_STOP_TIMEOUT)
        if self._thread.is_alive():
            # The thread is stuck; reclaim its processes directly.
            if self._notifier is not None and self._notifier.poll() is None:
                self._notifier.kill()
            if self._xctrace is not None and self._xctrace.poll() is None:
                self._kill_group(self._xctrace)
            self.error = self.error or "the trace recorder did not finish within its bound"


def foreign_instruments(own_groups: set[int]) -> list[str]:
    """Host Instruments processes (xctrace, Instruments, DTServiceHub) that do
    not belong to this profiler's own process groups."""
    listing = run(["ps", "-axo", "pid=,pgid=,command="], capture_output=True, timeout=30).stdout
    # (A traced run holds the host lock before starting xctrace, so none of
    # this profiler's own processes match while it waits.)
    found = []
    for line in listing.splitlines():
        fields = line.strip().split(None, 2)
        if len(fields) != 3 or not fields[1].isdigit():
            continue
        if int(fields[1]) in own_groups or int(fields[0]) == os.getpid():
            continue
        if INSTRUMENTS_PROCESS.search(fields[2]):
            found.append(f"pid {fields[0]}: {fields[2][:160]}")
    return found


class HostTraceLock:
    """Serializes traced runs on this Mac (kperf admits one session) and
    waits, bounded and logged, for other sessions' Instruments to finish."""

    def __init__(self, wait_seconds: float) -> None:
        self.wait_seconds = wait_seconds
        self.handle: Any = None

    def __enter__(self) -> "HostTraceLock":
        TRACE_HOST_LOCK.parent.mkdir(parents=True, exist_ok=True)
        self.handle = TRACE_HOST_LOCK.open("a+")
        deadline = time.monotonic() + self.wait_seconds
        announced = False
        while True:
            try:
                fcntl.flock(self.handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    self.handle.close()
                    raise ProfileError(f"another traced profile run held {TRACE_HOST_LOCK} for "
                                       f"{self.wait_seconds:.0f} s", EXIT_LOCKED)
                if not announced:
                    print(f"Waiting (up to {self.wait_seconds:.0f} s) for another traced run ({TRACE_HOST_LOCK})",
                          flush=True)
                    announced = True
                time.sleep(2)
        announced = False
        while foreign := foreign_instruments(set()):
            if time.monotonic() > deadline:
                self.__exit__()
                raise ProfileError(
                    "another Instruments session holds the host (kernel profiling admits one): "
                    + "; ".join(foreign[:3]), EXIT_LOCKED)
            if not announced:
                print(f"Waiting (up to {self.wait_seconds:.0f} s) for another session's Instruments to finish: "
                      + "; ".join(foreign[:3]), flush=True)
                announced = True
            time.sleep(5)
        return self

    def __exit__(self, *_: object) -> None:
        if self.handle is not None:
            fcntl.flock(self.handle, fcntl.LOCK_UN)
            self.handle.close()
            self.handle = None


class Profiler:
    def __init__(self, arguments: argparse.Namespace, lane: Lane) -> None:
        self.arguments = arguments
        toolchain = self._toolchain()
        self.runtime = toolchain["TRON_CI_IOS_RUNTIME_VERSION"]
        self.device_type = toolchain["TRON_CI_IOS_SIMULATOR_NAME"]
        self.lane = lane
        self.development_state = development_state_path()
        worktree_key = run(
            [sys.executable, str(IDENTITY), "worktree-key", "--worktree", str(ROOT)],
            capture_output=True, check=True,
        ).stdout.strip()
        build_root = Path.home() / "Library/Developer/Tron/ios"
        self.derived_data = Path(
            os.environ.get("TRON_PROFILE_IOS_DERIVED_DATA", build_root / "profile-derived-data" / worktree_key)
        )
        self.results_root = Path(
            os.environ.get("TRON_PROFILE_RESULTS_DIR", Path.home() / "Library/Developer/Tron/profiles")
        ).expanduser() / "ios"
        self.simulator_id = ""
        self.build_log: Path | None = None

    @staticmethod
    def _toolchain() -> dict[str, str]:
        output = run(
            ["bash", "-c", f"source {shlex.quote(str(ROOT / 'config/ci-toolchain.env'))} && "
             "printf '%s\\n%s\\n' \"$TRON_CI_IOS_RUNTIME_VERSION\" \"$TRON_CI_IOS_SIMULATOR_NAME\""],
            capture_output=True, check=True,
        ).stdout.splitlines()
        return {"TRON_CI_IOS_RUNTIME_VERSION": output[0], "TRON_CI_IOS_SIMULATOR_NAME": output[1]}

    def simulator_arguments(self) -> list[str]:
        return [
            "--marker", str(self.lane.state_root / "simulator.json"), "--runtime", self.runtime,
            "--device-type", self.device_type, "--name", self.lane.device_name,
            "--development-state", str(self.development_state),
            # The lane root, the default lane and this worktree, so this lane is
            # discovered by the sweep, reported by the lane tables and recorded
            # as this worktree's. The owned directories and the Development
            # simulator are resolved by the shared owner, not here.
            "--discovery-root", str(self.lane.lane_root),
            "--default-state-dir", str(self.lane.default_state_root),
            "--worktree", str(ROOT),
        ]

    def sweep(self) -> None:
        """Release orphaned owned lanes before this run boots anything.

        The same sweep as `scripts/tron-ios-test`, with the same rule: this
        run's own lane is leased, so the sweep never touches it. A sweep that
        cannot complete warns and never replaces the run's status.
        """
        result = run(
            [sys.executable, str(SIMULATOR), "sweep",
             "--discovery-root", str(self.lane.lane_root),
             "--default-state-dir", str(self.lane.default_state_root),
             "--development-state", str(self.development_state)],
            capture_output=True,
        )
        sys.stdout.write(result.stdout)
        sys.stderr.write(result.stderr)
        if result.returncode:
            print("warning: the orphaned-simulator sweep did not complete; continuing", file=sys.stderr)

    def provision(self) -> None:
        result = run([sys.executable, str(SIMULATOR), "provision", *self.simulator_arguments()],
                     capture_output=True, timeout=600)
        sys.stderr.write(result.stderr)
        udid = result.stdout.strip()
        if result.returncode == EXIT_LOCKED:
            # The shared provisioner's "not now": a lane a live process holds, or
            # a Mac too short of memory to admit the boot. Reported and kept as
            # its own exit, not as a broken destination - the caller decides
            # whether to wait.
            raise ProfileError("the shared provisioner refused the boot (73); the Mac is short of memory or the lane is leased", EXIT_LOCKED)
        if result.returncode != 0 or len(udid) != 36:
            raise ProfileError("cannot provision the owned test simulator", EXIT_DESTINATION)
        self.simulator_id = udid

    def destination(self) -> str:
        return f"platform=iOS Simulator,id={self.simulator_id}"

    def owned_directory(self, directory: Path) -> None:
        if directory.is_symlink() or directory in (Path("/"), Path.home(), ROOT, IOS):
            raise ProfileError(f"refusing unsafe profiler-owned directory: {directory}")
        directory.mkdir(parents=True, exist_ok=True)
        (directory / ".tron-profile-owned").write_text("tron.profile-ios-owned.v1\n")

    def products_match_source(self) -> bool:
        return (self.derived_data / "Build/Products").is_dir() and run(
            [sys.executable, str(IDENTITY), "verify", "--worktree", str(ROOT), "--derived-data", str(self.derived_data)],
            capture_output=True,
        ).returncode == 0

    def build(self) -> None:
        self.owned_directory(self.derived_data)
        if run([str(ROOT / "scripts/verify-ci-toolchain.sh"), "ios", "xcodegen"],
               env={**os.environ, "PATH": f"{Path(os.environ.get('TRON_CI_TOOLS_DIR') or ROOT / '.ci-tools') / 'bin'}:/opt/homebrew/bin:{os.environ.get('PATH', '')}"}).returncode:
            raise ProfileError("the Apple toolchain does not match the repository pins", EXIT_BUILD_FAILURE)
        identity = run([sys.executable, str(IDENTITY), "show", "--worktree", str(ROOT)],
                       capture_output=True, check=True).stdout
        if run([str(ROOT / "scripts/generate-xcode-project"), "ios", "--quiet"]).returncode:
            raise ProfileError("project generation failed", EXIT_BUILD_FAILURE)
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        logs = self.derived_data / "tron-profile-builds" / f"{stamp}-{secrets.token_hex(3)}"
        self.build_log = logs / "build.log"
        print(f"Building {SCHEME} ({CONFIGURATION}, Swift -O whole-module); log: {self.build_log}", flush=True)
        status = bounded(
            self.build_log, logs / "evidence",
            float(os.environ.get("TRON_PROFILE_IOS_BUILD_TIMEOUT_SECONDS", 2400)),
            # One whole-module compile prints nothing until it finishes.
            float(os.environ.get("TRON_PROFILE_IOS_BUILD_NO_OUTPUT_SECONDS", 1500)),
            self.derived_data / "Build/Products",
            ["xcodebuild", "build-for-testing", "-project", str(IOS / "TronMobile.xcodeproj"),
             "-scheme", SCHEME, "-configuration", CONFIGURATION, "-destination", self.destination(),
             "-derivedDataPath", str(self.derived_data), "-parallel-testing-enabled", "NO"],
        )
        if status == 124:
            raise ProfileError(f"the build exceeded its deadline; evidence: {logs / 'evidence'}", EXIT_TIMEOUT)
        if status >= 128:
            raise ProfileError(f"the build was interrupted (status {status})", status)
        if status:
            raise ProfileError(f"the {CONFIGURATION} build failed; log: {self.build_log}", EXIT_BUILD_FAILURE)
        stamped = run([sys.executable, str(IDENTITY), "write", "--worktree", str(ROOT),
                       "--derived-data", str(self.derived_data)], input=identity)
        if stamped.returncode:
            raise ProfileError("cannot stamp the profiling products with their source identity")

    def ensure_products(self) -> None:
        if self.arguments.no_build:
            if not self.products_match_source():
                raise ProfileError(
                    f"--no-build refused: the products at {self.derived_data} were not built from this worktree's "
                    "current source state; run without --no-build"
                )
            print(f"Reusing profiling products built from this source state: {self.derived_data}", flush=True)
            return
        self.build()

    def xcresult_json(self, result_bundle: Path, *arguments: str) -> Any:
        output = run(["xcrun", "xcresulttool", "get", "test-results", *arguments, "--path", str(result_bundle)],
                     capture_output=True, timeout=300)
        if output.returncode:
            raise ProfileError(f"xcresulttool {' '.join(arguments)} failed: {output.stderr.strip()}")
        return json.loads(output.stdout)

    def run_scenario(self, scenario: str, trace: str | None = None) -> Path:
        test, default_window, description = ALL_SCENARIOS[scenario]
        iterations = self.arguments.iterations
        window = self.arguments.window_seconds or default_window
        run_id = (f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{scenario}"
                  f"{'-trace-' + trace if trace else ''}-{secrets.token_hex(3)}")
        run_dir = self.results_root / run_id
        run_dir.mkdir(parents=True)
        result_bundle = run_dir / "TestResults.xcresult"
        log = run_dir / "test.log"
        print(f"\n== {scenario}: {iterations} iteration(s) x {window:g} s window -> {run_dir}", flush=True)
        environment = {
            "TEST_RUNNER_TRON_PROFILE_SCENARIO": scenario,
            "TEST_RUNNER_TRON_PROFILE_ITERATIONS": str(iterations),
        }
        if self.arguments.window_seconds:
            environment["TEST_RUNNER_TRON_PROFILE_WINDOW_SECONDS"] = f"{window:g}"
        # Launch and installation dominate short scenarios; every iteration
        # also gets its readiness and teardown allowance.
        overall = 420 + iterations * (window + 120)
        recorder: TraceRecorder | None = None
        if trace:
            # The hosted test waits for these markers; both sides share the bounds.
            overall += TRACE_RECORDING_TIMEOUT + TRACE_STOP_TIMEOUT
            recorder = TraceRecorder(trace, self.simulator_id, run_dir / "trace-handshake",
                                     run_dir / f"{scenario}.trace", run_dir / "xctrace.log", overall)
            environment.update({
                "TEST_RUNNER_TRON_PROFILE_TRACE_HANDSHAKE_DIR": str(recorder.handshake),
                "TEST_RUNNER_TRON_PROFILE_TRACE_RECORDING_TIMEOUT_SECONDS": str(TRACE_RECORDING_TIMEOUT),
                "TEST_RUNNER_TRON_PROFILE_TRACE_STOP_TIMEOUT_SECONDS": str(TRACE_STOP_TIMEOUT),
            })
        lock = HostTraceLock(TRACE_HOST_WAIT) if recorder else None
        if lock:
            lock.__enter__()
            recorder.start()
        try:
            status = bounded(
                log, run_dir / "test-evidence", overall, overall, result_bundle,
                ["xcodebuild", "test-without-building", "-project", str(IOS / "TronMobile.xcodeproj"),
                 "-scheme", SCHEME, "-configuration", CONFIGURATION, "-destination", self.destination(),
                 "-derivedDataPath", str(self.derived_data), "-resultBundlePath", str(result_bundle),
                 "-parallel-testing-enabled", "NO", "-collect-test-diagnostics", "never",
                 f"-only-testing:TronMobileTests/{test}"],
                environment,
            )
        finally:
            if recorder:
                recorder.finish()
            if lock:
                lock.__exit__()
        if status == 124:
            raise ProfileError(f"{scenario} exceeded its {overall:.0f} s deadline; evidence: {run_dir / 'test-evidence'}", EXIT_TIMEOUT)
        if status >= 128:
            raise ProfileError(f"{scenario} was interrupted (status {status}); evidence: {run_dir}", status)
        if not result_bundle.is_dir():
            raise ProfileError(f"{scenario} produced no xcresult (xcodebuild status {status}); log: {log}")
        if recorder and (recorder.error or not recorder.recording_started):
            raise ProfileError(f"{scenario}: tracing failed: {recorder.error or 'recording never started'}; "
                               f"evidence: {run_dir}")
        summary = self.xcresult_json(result_bundle, "summary")
        (run_dir / "xctest-summary.json").write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n")
        try:
            validate_summary(summary, scenario)
        except ProfileError as error:
            raise ProfileError(f"{error}; evidence: {run_dir}", error.code) from error
        if status:
            raise ProfileError(f"{scenario}: xcodebuild exited {status} although the test passed; log: {log}")
        traced: dict[str, Any] | None = None
        if recorder:
            try:
                windows, discarded = attribution.load_windows(recorder.handshake / "windows.jsonl", iterations, skip=1)
                traced = attribution.attribute(recorder.output, trace, recorder.pid, windows,
                                               discarded_epoch=discarded,
                                               host_wide=attribution.records_all_processes(trace))
            except attribution.AttributionError as error:
                raise ProfileError(f"{scenario}: attribution failed: {error}; trace kept at {recorder.output}") from error
            attribution_paths = attribution.write(traced, run_dir)
        metrics_document = self.xcresult_json(result_bundle, "metrics")
        (run_dir / "xcresult-metrics.json").write_text(json.dumps(metrics_document, indent=2, sort_keys=True) + "\n")
        context = {
            "scenario_description": description,
            "iterations": iterations,
            "window_seconds": window,
            "configuration": CONFIGURATION,
            "scheme": SCHEME,
            "test": f"TronMobileTests/{test}",
            "simulator": {"device_type": self.device_type, "runtime": self.runtime},
            "xcode": run(["xcodebuild", "-version"], capture_output=True).stdout.strip().replace("\n", " "),
            "products": str(self.derived_data),
            "warnings": [
                "simulator values measure host CPU work of the app process; they are a proxy, not device battery",
            ],
        }
        if traced is not None:
            context["trace"] = {"template": trace, "trace": str(recorder.output), "pid": recorder.pid}
            context["warnings"].append(TRACED_WARNING)
        retries = [line for line in log.read_text(errors="replace").splitlines()
                   if line.startswith("TRON_PROFILE_SETUP_RETRY ")]
        if retries:
            context["setup_retries"] = retries
            context["warnings"].append(
                f"{len(retries)} scenario setup(s) did not reach readiness and were rebuilt before measuring; "
                "see setup_retries (usually a chat opening that did not settle on a loaded host)"
            )
        rerenders = [line for line in log.read_text(errors="replace").splitlines()
                     if line.startswith("TRON_PROFILE_RENDER_RETRY ")]
        if rerenders:
            context["render_retries"] = rerenders
            context["warnings"].append(
                f"{len(rerenders)} measured window(s) failed the scenario's render check and were discarded and "
                "measured again on a fresh instance; see render_retries"
            )
        try:
            samples = build_samples(extract_measurements(metrics_document, test), iterations, context)
        except ProfileError as error:
            raise ProfileError(f"{scenario}: {error}; evidence: {run_dir}", error.code) from error
        samples_path = run_dir / "samples.json"
        samples_path.write_text(json.dumps(samples, indent=2, sort_keys=True) + "\n")
        artifacts = [
            f"xcresult={result_bundle}", f"test_log={log}", f"samples={samples_path}",
            f"xcresult_metrics={run_dir / 'xcresult-metrics.json'}",
        ]
        if self.build_log:
            artifacts.append(f"build_log={self.build_log}")
        if traced is not None:
            artifacts += [f"trace={recorder.output}", f"xctrace_log={recorder.log}",
                          f"attribution={attribution_paths[0]}", f"attribution_summary={attribution_paths[1]}"]
        written = run(
            [sys.executable, str(REPORT), "write", "--tool", "ios", "--scenario", scenario,
             "--samples", str(samples_path), "--run-dir", str(run_dir), "--worktree", str(ROOT),
             *[item for artifact in artifacts for item in ("--artifact", artifact)]],
        )
        if written.returncode:
            raise ProfileError(f"the report module rejected the samples; evidence: {run_dir}")
        if traced is not None:
            print(f"\n{attribution.markdown(traced, top=10)}\nAttribution: {attribution_paths[1]}", flush=True)
        return run_dir

    def self_test(self) -> int:
        reports = {name: self.run_scenario(name) for name in CONTROL_SCENARIOS}
        traced_row: tuple[str, str, str, bool] | None = None
        if self.arguments.trace:
            traced = self.run_scenario("control-cpu", self.arguments.trace)
            document = json.loads((traced / "attribution.json").read_text())
            traced_row = control_attribution_verdict(document)
            reports["control-cpu (traced)"] = traced
        comparisons = {}
        for variant in SELF_TEST_EXPECTATIONS:
            compared = run(
                [sys.executable, str(REPORT), "compare", str(reports["control"]), str(reports[variant]),
                 "--json", "--allow-mismatch"],
                capture_output=True,
            )
            if compared.returncode not in (0, 3):
                raise ProfileError(f"compare failed for {variant}: {compared.stderr.strip()}")
            comparisons[variant] = json.loads(compared.stdout)
        rows = self_test_verdicts(comparisons)
        if traced_row:
            rows.append(traced_row)
        print("\nSelf-test (control vs. known-bad variant):")
        for variant, metric, verdict, passed in rows:
            detail = comparisons.get(variant, {}).get("metrics", {}).get(metric, {})
            delta = f" {detail['relative'] * 100:+.1f}% (noise bound {detail['noise_bound']:.4g})" if "relative" in detail else ""
            print(f"  {'PASS' if passed else 'FAIL'}  {variant:<16} {metric:<20} {verdict}{delta}")
        if traced_row:
            print(f"  (attribution: {CONTROL_WORKLOAD_SYMBOL} must rank within the top {CONTROL_WORKLOAD_RANK} "
                  "self-time symbols of the traced control-cpu windows)")
        for name, directory in reports.items():
            print(f"  {name}: {directory}")
        if all(passed for *_, passed in rows):
            print("Self-test passed: every known cost was detected beyond the noise bound.")
            return EXIT_OK
        print("Self-test FAILED: the measurement path did not detect a known cost; do not trust product numbers.",
              file=sys.stderr)
        return EXIT_SELF_TEST


def control_attribution_verdict(document: dict[str, Any]) -> tuple[str, str, str, bool]:
    """Self-test row: the traced control-cpu run must rank the known workload
    function among the top self-time symbols inside the measured windows,
    resolved by name, and (since it runs only inside them) must be all but
    absent from the samples just outside the windows."""
    profile = document.get("time_profile", {})
    ranking = profile.get("all_threads", {}).get("self", [])
    for rank, row in enumerate(ranking[:CONTROL_WORKLOAD_RANK], start=1):
        if CONTROL_WORKLOAD_SYMBOL in row.get("symbol", ""):
            leaked = sum(item.get("ms", 0.0) for item in profile.get("outside_windows_self", [])
                         if CONTROL_WORKLOAD_SYMBOL in item.get("symbol", ""))
            if leaked > 0.01 * row["ms"] + 2.0:
                return ("control-cpu", "trace windows", f"{leaked:.0f} ms of {CONTROL_WORKLOAD_SYMBOL} fell outside "
                        f"the measured windows ({row['ms']:.0f} ms inside); window placement is wrong", False)
            return ("control-cpu", "trace self time",
                    f"rank {rank} ({row['share'] * 100:.1f}%), {leaked:.0f} ms outside windows", True)
    top = ", ".join(row.get("symbol", "?") for row in ranking[:CONTROL_WORKLOAD_RANK]) or "no samples"
    return ("control-cpu", "trace self time", f"{CONTROL_WORKLOAD_SYMBOL} not in top {CONTROL_WORKLOAD_RANK}: {top}", False)


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="scripts/tron-profile ios",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Profile deterministic iOS scenarios on the owned test simulator (optimized DevicePerformance build).",
        epilog=(
            "Exit status: 0 success, 2 usage, 65 scenario failed or did not run, 66 destination, 70 build failure,\n"
            "73 simulator lease busy or the Mac refused the boot, 74 runner or extraction failure, 75 deadline exceeded,\n"
            "77 self-test failed.\n"
            "Shares the lane, the sweep, the lease, the release and the memory admission of scripts/tron-ios-test:\n"
            "--lane (or TRON_IOS_TEST_LANE) selects the lane exactly as the runner does - without one, a linked\n"
            "worktree uses its own lane and the primary checkout the default lane, which the pre-lane\n"
            "TRON_IOS_TEST_STATE_DIR and TRON_IOS_TEST_DEVICE_NAME also select - the scenario run releases the\n"
            "simulator it booted, and it refuses (73) rather than boot when the Mac is short of memory.\n"
            "TRON_PROFILE_RESULTS_DIR and TRON_PROFILE_IOS_DERIVED_DATA own its own reports and products."
        ),
    )
    parser.add_argument("--list", action="store_true", help="list scenarios and exit")
    parser.add_argument("--lane", metavar="NAME",
                        help="the simulator lane, as scripts/tron-ios-test --lane (default: this checkout's lane)")
    parser.add_argument("--scenario", action="append", default=[], metavar="NAME",
                        help="scenario to run (repeatable); 'all' runs every product scenario")
    parser.add_argument("--iterations", type=int, default=5, help="measured iterations per scenario (default 5)")
    parser.add_argument("--window-seconds", type=float, help="override each scenario's measured window")
    parser.add_argument("--no-build", action="store_true",
                        help="reuse products only if they were built from this worktree's current source state")
    parser.add_argument("--self-test", action="store_true",
                        help="run the control scenario and its known-bad variants and verify the expected deltas")
    parser.add_argument("--trace", choices=sorted(attribution.TEMPLATES), metavar="TEMPLATE",
                        help="also record an xctrace capture of the measured windows and write attribution.json/.md "
                             f"({', '.join(sorted(attribution.TEMPLATES))}); the report is marked traced and "
                             "compare refuses it; with --self-test (time-profiler only) also verify attribution")
    arguments = parser.parse_args(argv)
    if not 1 <= arguments.iterations <= 50:
        parser.error("--iterations must be 1...50")
    if arguments.window_seconds is not None and not 0.5 <= arguments.window_seconds <= 600:
        parser.error("--window-seconds must be 0.5...600")
    names = []
    for name in arguments.scenario:
        if name == "all":
            names.extend(SCENARIOS)
        elif name in ALL_SCENARIOS:
            names.append(name)
        else:
            parser.error(f"unknown scenario {name!r}; see --list")
    arguments.scenario = list(dict.fromkeys(names))
    if not arguments.list and not arguments.self_test and not arguments.scenario:
        parser.error("choose --scenario NAME, --scenario all, --self-test, or --list")
    if arguments.self_test and arguments.scenario:
        parser.error("--self-test runs only the control scenarios; run product scenarios separately")
    if arguments.self_test and arguments.trace not in (None, "time-profiler"):
        parser.error("--self-test verifies attribution only with --trace time-profiler")
    return arguments


def main(argv: list[str]) -> int:
    arguments = parse_arguments(argv)
    if arguments.list:
        for group, table in (("Scenarios", SCENARIOS), ("Self-test controls", CONTROL_SCENARIOS)):
            print(f"{group}:")
            for name, (_, window, description) in table.items():
                print(f"  {name:<16} {window:>5g} s  {description}")
        return EXIT_OK
    try:
        lane = Lane(arguments.lane)
    except ProfileError as error:
        print(f"error: {error}", file=sys.stderr)
        return error.code
    if os.environ.get("TRON_IOS_TEST_LOCK_HELD") != "1":
        # The same lease, and the same release, as scripts/tron-ios-test: when
        # this run ends, on success, failure, deadline or signal, the holder
        # shuts down the lane's simulator unless it was already booted under a
        # keep-booted lease - and it never touches the remembered Development
        # simulator. Profiling and tests therefore never share one simulator.
        # The holder is exec'd, not spawned: CPython's subprocess.run kills its
        # child with SIGKILL when a Ctrl-C raises KeyboardInterrupt, so a holder
        # started that way is killed before it can release the simulator. As the
        # same process, this run's signal goes to the holder, which forwards it
        # to the command tree and releases the lane's simulator afterwards.
        # The lane travels with the run, as in scripts/tron-ios-test: the run the
        # holder starts re-derives the lane it leased.
        lane.state_root.mkdir(parents=True, exist_ok=True)
        os.chmod(lane.state_root, 0o700)
        try:
            os.execv(sys.executable, [
                sys.executable, str(LOCKER), "--lock", str(lane.state_root / "lease.lock"),
                "--marker", str(lane.state_root / "simulator.json"),
                "--development-state", str(development_state_path()), "--", str(Path(__file__).resolve()),
                *argv, "--lane", lane.label,
            ])
        except OSError as error:
            print(f"error: cannot start the iOS test lease holder: {error}", file=sys.stderr)
            return EXIT_RUNNER
    # The runner's refusal (74), from the same owner: an inherited lease that
    # does not cover this lane would leave this run on it unleased.
    verified = run([sys.executable, str(LOCKER), "--lock", str(lane.state_root / "lease.lock"),
                    "--verify-inherited", lane.label])
    if verified.returncode != 0:
        return verified.returncode
    try:
        profiler = Profiler(arguments, lane)
        profiler.sweep()
        profiler.provision()
        profiler.ensure_products()
        if arguments.self_test:
            return profiler.self_test()
        # A failing scenario does not hide the others' measurements; the first
        # failure's status is the command's status.
        written: list[Path] = []
        failures: list[tuple[str, ProfileError]] = []
        for name in arguments.scenario:
            try:
                written.append(profiler.run_scenario(name, arguments.trace))
            except ProfileError as error:
                print(f"error: {error}", file=sys.stderr)
                failures.append((name, error))
                if error.code >= 128:
                    break  # interrupted: stop instead of starting the next scenario
        if len(arguments.scenario) > 1:
            print("\nReports:")
            for directory in written:
                print(f"  {directory}")
            for name, error in failures:
                print(f"  {name}: FAILED ({error.code})")
        return failures[0][1].code if failures else EXIT_OK
    except ProfileError as error:
        print(f"error: {error}", file=sys.stderr)
        return error.code
    except subprocess.CalledProcessError as error:
        print(f"error: {' '.join(map(str, error.cmd))} failed with status {error.returncode}", file=sys.stderr)
        return EXIT_RUNNER


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
