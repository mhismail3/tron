#!/usr/bin/env bash
# Tron contributor entry point. Production deployment is intentionally absent;
# releases are performed manually by the repository owner.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATEWAY="$ROOT/packages/gateway"

usage() {
  cat <<'EOF'
Usage: scripts/tron <command> [options]

Commands:
  dev                                Deprecated and fail-closed; use the installed LaunchAgent
                                    and scripts/gateway-payload-deploy.mjs
  chat [--session <id>] [--cwd <path>] [--host <host>] [--port <port>]
                                    Attach terminal chat to the Gateway-owned runtime
  ci [check|test|all]               Validate the gateway and repository policy
  bundle gateway                    Stage the Mac gateway payload and Node runtimes
  ios generate                      Regenerate the iOS Xcode project
  mac generate                      Regenerate the macOS Xcode project
  mac verify                        Verify installed app, payload, LaunchAgent, and PID
  version                           Print the canonical Tron version

There is no deploy command. Production deployment is manual-only.
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  version)
    if (($# == 0)); then
      awk -F= '/^TRON_VERSION=/{gsub(/"/,"",$2); print $2}' "$ROOT/VERSION.env"
    else
      exec "$ROOT/scripts/tron-version" "$@"
    fi
    ;;
  __dev-supervise)
    echo "scripts/tron development supervision is deprecated and fail-closed; LaunchAgent owns Gateway processes." >&2
    exit 64
    host="${1:?missing development Gateway host}"
    source_revision="${2:-unknown}"; payload_fingerprint="${3:-unknown}"; supervisor_epoch="${4:-$(date +%s)}"
    state="$HOME/.tron-dev/gateway"; state_file="$state/lifecycle.json"; child_file="$state/dev.child.pid"; log="$state/dev.log"
    helper="$ROOT/scripts/tron-dev-state.mjs"; child=""; child_identity=""; stopping=0; failures=0; readiness_failed=0
    state_patch() { node "$helper" patch "$state_file" "$@"; }
    pid_current() {
      local pid="$1" identity="$2"
      [[ "$pid" =~ ^[0-9]+$ && -n "$identity" ]] || return 1
      [[ "$(node "$helper" pid-current "$pid" "$identity")" == yes ]]
    }
    stop_supervisor() {
      trap - TERM INT; stopping=1
      state_patch lifecycle=draining intentionalExit=true exitCode=0
      if pid_current "$child" "$child_identity"; then
        kill -TERM "$child" 2>/dev/null || true
        for _ in $(seq 1 40); do pid_current "$child" "$child_identity" || break; sleep 0.05; done
        if pid_current "$child" "$child_identity"; then kill -KILL "$child" 2>/dev/null || true; fi
      fi
      wait "$child" 2>/dev/null || true
      state_patch lifecycle=stopped childPid= childStartIdentity= supervisorPid= supervisorStartIdentity=
      rm -f "$child_file"
      exit 0
    }
    mkdir -p "$state"
    supervisor_identity="$(node "$helper" pid-start "$$")"
    state_patch lifecycle=starting expectedHost="$host" expectedPort=9848 expectedHome="$HOME/.tron-dev" supervisorPid="$$" supervisorStartIdentity="$supervisor_identity" supervisorEpoch="$supervisor_epoch" sourceRevision="$source_revision" buildFingerprint="$payload_fingerprint" intentionalExit=false exitCode= restartCount=0
    trap stop_supervisor TERM INT
    trap '' HUP
    while ((stopping == 0)); do
      child_epoch="$(node -e 'console.log(require("node:crypto").randomUUID())')"
      state_patch lifecycle=starting epoch="$child_epoch" childPid= childStartIdentity= intentionalExit=false exitCode=
      TRON_GATEWAY_SUPERVISED=1 TRON_HOME_NAME=.tron-dev TRON_GATEWAY_SOURCE_REVISION="$source_revision" TRON_GATEWAY_BUILD_FINGERPRINT="$payload_fingerprint" TRON_GATEWAY_RUNTIME_EPOCH="$child_epoch" node "$GATEWAY/dist/index.js" --host "$host" --port 9848 &
      child=$!
      child_identity="$(node "$helper" pid-start "$child")"
      echo "$child" >"$child_file"
      state_patch lifecycle=starting childPid="$child" childStartIdentity="$child_identity"
      ready=0
      readiness_failed=0
      for _ in $(seq 1 60); do
        health="$(node "$helper" health "$host" 9848)"
        if [[ "$health" == *'"readiness":"ready"'* ]] && [[ "$health" == *"\"runtimeEpoch\":\"$child_epoch\""* ]] && [[ "$health" == *"\"sourceRevision\":\"$source_revision\""* ]] && [[ "$health" == *"\"buildFingerprint\":\"$payload_fingerprint\""* ]]; then ready=1; state_patch lifecycle=ready healthStatus=ok readiness=ready; break; fi
        [[ "$(node "$helper" pid-current "$child" "$child_identity")" == yes ]] || break
        sleep 0.5
      done
      if ((ready == 0)); then
        readiness_failed=1
        state_patch lifecycle=failed healthStatus=not-ready readiness=unknown
        kill -TERM "$child" 2>/dev/null || true
      fi
      set +e; wait "$child"; exit_code=$?; set -e
      child=""; rm -f "$child_file"
      if ((readiness_failed)); then
        state_patch lifecycle=failed intentionalExit=false exitCode="$exit_code" readiness=unknown childPid= childStartIdentity=
        printf '=== Tron development Gateway failed readiness; supervisor stopped code=%s ===\n' "$exit_code" >&2
        exit 1
      fi
      if ((stopping)); then break; fi
      if ((exit_code == 0)); then state_patch lifecycle=stopped intentionalExit=true exitCode=0 childPid= childStartIdentity=; exit 0; fi
      if ((exit_code == 75)); then
        failures=0
        state_patch lifecycle=restarting intentionalExit=true exitCode=75 childPid= childStartIdentity=
        printf '=== Tron development Gateway drained for restart %s ===\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        sleep 0.25
        continue
      fi
      failures=$((failures + 1))
      state_patch lifecycle=restarting intentionalExit=false exitCode="$exit_code" restartCount="$failures" childPid= childStartIdentity=
      if ((failures >= 5)); then
        state_patch lifecycle=failed intentionalExit=false exitCode="$exit_code" readiness=unknown
        printf '=== Tron development Gateway crashed; restart budget exhausted code=%s ===\n' "$exit_code" >&2
        exit 1
      fi
      backoff=$((2 ** (failures - 1))); ((backoff > 8)) && backoff=8
      sleep "$backoff"
    done
    ;;
  dev)
    echo "scripts/tron dev is deprecated and fail-closed: use the LaunchAgent-owned Gateway and scripts/gateway-payload-deploy.mjs." >&2
    exit 64
    action=run; background=0; host=127.0.0.1; host_explicit=0; json=0; command_id=""
    while (($#)); do
      case "$1" in
        --stop)
          [[ "$action" == run || "$action" == stop ]] || { echo "dev lifecycle actions are mutually exclusive" >&2; exit 64; }
          action=stop ;;
        --restart)
          [[ "$action" == run || "$action" == restart ]] || { echo "dev lifecycle actions are mutually exclusive" >&2; exit 64; }
          action=restart ;;
        --status|--preflight)
          [[ "$action" == run || "$action" == status ]] || { echo "dev lifecycle actions are mutually exclusive" >&2; exit 64; }
          action=status ;;
        --json) json=1 ;;
        --command-id) shift; command_id="${1:?missing command id}" ;;
        --background|-b) background=1 ;;
        --tailscale) host=tailscale; host_explicit=1 ;;
        *) echo "unknown dev option: $1" >&2; exit 64 ;;
      esac; shift
    done
    state="$HOME/.tron-dev/gateway"; state_file="$state/lifecycle.json"; pid_file="$state/dev.pid"; child_file="$state/dev.child.pid"; log="$state/dev.log"
    helper="$ROOT/scripts/tron-dev-state.mjs"
    if [[ "$action" == status ]]; then
      # This branch is intentionally before the build: status/preflight are read-only.
      if ((json)); then
        if ((host_explicit)); then node "$helper" status "$state_file" "$host"; else node "$helper" status "$state_file"; fi
      else
        if ((host_explicit)); then status_json_cmd=(node "$helper" status "$state_file" "$host"); else status_json_cmd=(node "$helper" status "$state_file"); fi
        "${status_json_cmd[@]}" | node -e 'let b="";process.stdin.on("data",d=>b+=d).on("end",()=>{const x=JSON.parse(b); console.log(`${x.lifecycle} supervisor=${x.supervisor.pid ?? "-"} child=${x.child.pid ?? "-"} readiness=${x.health.readiness}`); process.exit(x.lifecycle === "ready" ? 0 : 1)})'
      fi
      exit $?
    fi
    if [[ "$action" == stop ]]; then
      pid_current() {
        local pid="$1" identity="$2"
        [[ "$pid" =~ ^[0-9]+$ && -n "$identity" ]] || return 1
        [[ "$(node "$helper" pid-current "$pid" "$identity")" == yes ]]
      }
      supervisor_pid=""; supervisor_identity=""; child_pid=""; child_identity=""
      if [[ -f "$state_file" ]]; then
        supervisor_pid="$(node "$helper" get "$state_file" supervisorPid)"
        supervisor_identity="$(node "$helper" get "$state_file" supervisorStartIdentity)"
        child_pid="$(node "$helper" get "$state_file" childPid)"
        child_identity="$(node "$helper" get "$state_file" childStartIdentity)"
      fi
      # Refuse a stop requested by a Gateway-owned tool, but only trust a
      # recorded child after its start identity has been matched.
      gateway_pid="$child_pid"
      [[ -n "$gateway_pid" ]] || [[ ! -f "$child_file" ]] || gateway_pid="$(cat "$child_file")"
      if [[ "$gateway_pid" =~ ^[0-9]+$ ]] && pid_current "$gateway_pid" "$child_identity"; then
        ancestor="$PPID"
        while [[ "$ancestor" =~ ^[0-9]+$ ]] && ((ancestor > 1)); do
          if [[ "$ancestor" == "$gateway_pid" ]]; then
            echo "The deprecated development owner cannot stop a Gateway. Use authenticated gateway.restart through the LaunchAgent-owned deployment core." >&2; exit 65
          fi
          ancestor="$(ps -o ppid= -p "$ancestor" 2>/dev/null | tr -d ' ' || true)"
        done
      fi
      stop_failed=0
      if [[ -n "$supervisor_pid" && -z "$supervisor_identity" ]]; then
        echo "cannot safely stop development Gateway: supervisor PID has no start identity" >&2
        stop_failed=1
      fi
      if [[ -n "$child_pid" && -z "$child_identity" ]]; then
        echo "cannot safely stop development Gateway: child PID has no start identity" >&2
        stop_failed=1
      fi
      if [[ -f "$pid_file" ]]; then
        recorded_supervisor_file="$(cat "$pid_file")"
        if [[ -n "$recorded_supervisor_file" && "$recorded_supervisor_file" != "$supervisor_pid" ]]; then
          echo "cannot safely stop development Gateway: supervisor PID record is inconsistent" >&2
          stop_failed=1
        elif [[ -n "$recorded_supervisor_file" && -z "$supervisor_identity" ]]; then
          echo "cannot safely stop development Gateway: supervisor PID record has no start identity" >&2
          stop_failed=1
        fi
      fi
      if [[ -f "$child_file" ]]; then
        recorded_child_file="$(cat "$child_file")"
        if [[ -n "$recorded_child_file" && "$recorded_child_file" != "$child_pid" ]]; then
          echo "cannot safely stop development Gateway: child PID record is inconsistent" >&2
          stop_failed=1
        elif [[ -n "$recorded_child_file" && -z "$child_identity" ]]; then
          echo "cannot safely stop development Gateway: child PID record has no start identity" >&2
          stop_failed=1
        fi
      fi
      [[ -f "$state_file" ]] && node "$helper" patch "$state_file" lifecycle=draining intentionalExit=true exitCode=0
      # Signal the child independently of the supervisor. This closes the
      # orphan window if the supervisor already died or exits during draining.
      if pid_current "$child_pid" "$child_identity"; then
        kill -TERM "$child_pid" 2>/dev/null || true
      fi
      if pid_current "$supervisor_pid" "$supervisor_identity"; then
        kill -TERM "$supervisor_pid" 2>/dev/null || true
      fi
      for _ in $(seq 1 40); do
        child_live=0; supervisor_live=0
        pid_current "$child_pid" "$child_identity" && child_live=1
        pid_current "$supervisor_pid" "$supervisor_identity" && supervisor_live=1
        ((child_live == 0 && supervisor_live == 0)) && break
        sleep 0.05
      done
      # Escalate only after rechecking the original PID/start-identity pair.
      if pid_current "$child_pid" "$child_identity"; then kill -KILL "$child_pid" 2>/dev/null || true; fi
      if pid_current "$supervisor_pid" "$supervisor_identity"; then kill -KILL "$supervisor_pid" 2>/dev/null || true; fi
      for _ in $(seq 1 40); do
        child_live=0; supervisor_live=0
        pid_current "$child_pid" "$child_identity" && child_live=1
        pid_current "$supervisor_pid" "$supervisor_identity" && supervisor_live=1
        ((child_live == 0 && supervisor_live == 0)) && break
        sleep 0.05
      done
      if pid_current "$child_pid" "$child_identity" || pid_current "$supervisor_pid" "$supervisor_identity"; then
        echo "development Gateway stop timed out; inspect $log" >&2
        [[ -f "$state_file" ]] && node "$helper" patch "$state_file" lifecycle=failed intentionalExit=false readiness=unknown
        exit 1
      fi
      if ((stop_failed != 0)); then
        [[ -f "$state_file" ]] && node "$helper" patch "$state_file" lifecycle=failed intentionalExit=false readiness=unknown
        echo "development Gateway stop did not clear unverifiable PID records; inspect $log" >&2
        exit 1
      fi
      rm -f "$pid_file" "$child_file"
      [[ -f "$state_file" ]] && node "$helper" patch "$state_file" lifecycle=stopped intentionalExit=true exitCode=0 supervisorPid=supervisorStartIdentity= childPid=childStartIdentity=
      exit 0
    fi
    mkdir -p "$state"
    source_revision="$(git -C "$ROOT" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)"
    [[ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null || true)" ]] && source_revision="${source_revision}-dirty"
    (cd "$GATEWAY" && npm run build)
    payload_fingerprint="$(node "$helper" fingerprint "$GATEWAY/dist")"
    if [[ "$action" == restart ]]; then
      old_epoch="$(node "$helper" get "$state_file" epoch)"; [[ -n "$command_id" ]] || command_id="$(node -e 'console.log(require("node:crypto").randomUUID())')"
      node "$helper" patch "$state_file" lifecycle=restarting commandId="$command_id" sourceRevision="$source_revision" buildFingerprint="$payload_fingerprint"
      reconcile_restart_failure() {
        local failure_code="$1" failure_reason="$2" status_json status_patch
        status_json="$(node "$helper" status "$state_file" "$host" 2>/dev/null || true)"
        if [[ -n "$status_json" ]]; then
          status_patch="$(printf '%s' "$status_json" | FAILURE_CODE="$failure_code" node -e '
            let body = "";
            process.stdin.on("data", (chunk) => { body += chunk; }).on("end", () => {
              try {
                const status = JSON.parse(body);
                const health = status.health ?? {};
                const ready = status.supervisor?.live === true && status.child?.live === true
                  && health.readiness === "ready" && typeof health.runtimeEpoch === "string"
                  && health.runtimeEpoch === status.epoch;
                const patch = {
                  lifecycle: ready ? "ready" : "failed",
                  intentionalExit: false,
                  exitCode: Number(process.env.FAILURE_CODE) || 1,
                  readiness: ready ? "ready" : "unknown",
                  healthStatus: ready ? "ok" : "not-ready",
                };
                if (ready) {
                  patch.epoch = health.runtimeEpoch;
                  if (typeof health.sourceRevision === "string") patch.sourceRevision = health.sourceRevision;
                  if (typeof health.buildFingerprint === "string") patch.buildFingerprint = health.buildFingerprint;
                }
                process.stdout.write(JSON.stringify(patch));
              } catch { process.exitCode = 1; }
            });
          ' 2>/dev/null || true)"
        fi
        if [[ -n "$status_patch" ]]; then
          node "$helper" update "$state_file" "$status_patch" || node "$helper" patch "$state_file" lifecycle=failed intentionalExit=false exitCode="$failure_code" readiness=unknown
        else
          node "$helper" patch "$state_file" lifecycle=failed intentionalExit=false exitCode="$failure_code" readiness=unknown
        fi
        echo "development Gateway restart failed ($failure_reason, exit=$failure_code); lifecycle reconciled; inspect $log" >&2
      }
      set +e
      restart_output="$(TRON_HOME_NAME=.tron-dev node "$GATEWAY/dist/client/restart-gateway.js" --host "$host" --port 9848 --command-id "$command_id" 2>&1)"
      restart_exit=$?
      set -e
      [[ -z "$restart_output" ]] || printf '%s\n' "$restart_output"
      if ((restart_exit != 0)); then
        reconcile_restart_failure "$restart_exit" "restart client rejected or failed"
        exit "$restart_exit"
      fi
      for _ in $(seq 1 90); do
        lifecycle="$(node "$helper" get "$state_file" lifecycle)"; epoch="$(node "$helper" get "$state_file" epoch)"
        health="$(node "$helper" health "$host" 9848)"
        if [[ "$lifecycle" == ready && -n "$epoch" && "$epoch" != "$old_epoch" ]] \
          && [[ "$health" == *'"readiness":"ready"'* ]] \
          && [[ "$health" == *"\"runtimeEpoch\":\"$epoch\""* ]] \
          && [[ "$health" == *"\"sourceRevision\":\"$source_revision\""* ]] \
          && [[ "$health" == *"\"buildFingerprint\":\"$payload_fingerprint\""* ]]; then
          printf 'Tron Gateway restart ready (readiness=ready epoch=%s sourceRevision=%s buildFingerprint=%s)\n' "$epoch" "$source_revision" "$payload_fingerprint"
          exit 0
        fi
        if [[ "$lifecycle" == failed ]]; then
          reconcile_restart_failure 1 "supervisor reported failure"
          exit 1
        fi
        sleep 0.5
      done
      reconcile_restart_failure 1 "readiness timeout"
      exit 1
    fi
    args=("$GATEWAY/dist/index.js" --host "$host" --port 9848)
    if ((background)); then
      if [[ -f "$state_file" ]]; then
        supervisor_pid="$(node "$helper" get "$state_file" supervisorPid)"; supervisor_identity="$(node "$helper" get "$state_file" supervisorStartIdentity)"
        if [[ -n "$supervisor_pid" ]] && [[ "$(node "$helper" pid-current "$supervisor_pid" "$supervisor_identity")" == yes ]]; then echo "Tron development Gateway supervisor is already running" >&2; exit 65; fi
      fi
      supervisor_epoch="$(node -e 'console.log(require("node:crypto").randomUUID())')"
      nohup "$ROOT/scripts/tron" __dev-supervise "$host" "$source_revision" "$payload_fingerprint" "$supervisor_epoch" >"$log" 2>&1 &
      supervisor_pid=$!; supervisor_identity="$(node "$helper" pid-start "$supervisor_pid")"
      printf '%s\n' "$supervisor_pid" >"$pid_file"
      echo "Tron development Gateway supervisor started (pid $supervisor_pid, log $log)"
    else
      TRON_GATEWAY_SUPERVISED=0 TRON_HOME_NAME=.tron-dev TRON_GATEWAY_SOURCE_REVISION="$source_revision" TRON_GATEWAY_BUILD_FINGERPRINT="$payload_fingerprint" TRON_GATEWAY_RUNTIME_EPOCH="$(node -e 'console.log(require("node:crypto").randomUUID())')" exec node "${args[@]}"
    fi
    ;;
  chat)
    (cd "$GATEWAY" && npm run build >/dev/null)
    exec node "$GATEWAY/dist/client/terminal-chat.js" "$@"
    ;;
  ci)
    scope="${1:-all}"
    case "$scope" in
      check) (cd "$GATEWAY" && npm ci && npm run build && npm audit --omit=dev) ;;
      test) (cd "$GATEWAY" && npm test) ;;
      all)
        (cd "$GATEWAY" && npm ci && npm run build && npm test && npm audit --omit=dev)
        "$ROOT/scripts/personal-info-guard.sh"
        ;;
      *) echo "unknown ci scope: $scope" >&2; exit 64 ;;
    esac
    ;;
  bundle)
    [[ "${1:-}" == gateway ]] || { usage >&2; exit 64; }
    exec "$ROOT/packages/mac-app/scripts/bundle-gateway.sh" "${@:2}"
    ;;
  ios)
    [[ "${1:-}" == generate ]] || { usage >&2; exit 64; }
    (cd "$ROOT/packages/ios-app" && xcodegen generate)
    ;;
  mac)
    case "${1:-}" in
      generate)
        (cd "$ROOT/packages/mac-app" && xcodegen generate)
        ;;
      verify)
        exec "$ROOT/scripts/verify-mac-install.sh"
        ;;
      *) usage >&2; exit 64 ;;
    esac
    ;;
  *) usage >&2; exit 64 ;;
esac
