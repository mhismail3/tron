#!/usr/bin/env bash
# Tron contributor entry point. Production deployment is intentionally absent;
# releases are performed manually by the repository owner.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATEWAY="$ROOT/packages/gateway"

usage() {
  cat <<'EOF'
Usage: scripts/tron <command> [options]

Commands:
  dev [--tailscale] [--background]  Build and run an isolated gateway on port 9848
  dev --stop                        Stop the background isolated gateway
  dev --status                      Report isolated gateway status
  ci [check|test|all]               Validate the gateway and repository policy
  bundle gateway                    Stage the Mac gateway payload and Node runtimes
  ios generate                      Regenerate the iOS Xcode project
  mac generate                      Regenerate the macOS Xcode project
  version                           Print the canonical Tron version

There is no deploy command. Production deployment is manual-only.
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  version)
    if (($# == 0)); then
      awk -F= '/^TRON_VERSION=/{gsub(/"/,"",$2); print $2}' "$ROOT/VERSION.env"
    else
      exec "$ROOT/scripts/tron-version" "$@"
    fi
    ;;
  dev)
    action=run; background=0; host=127.0.0.1
    while (($#)); do
      case "$1" in
        --stop) action=stop ;;
        --status) action=status ;;
        --background|-b) background=1 ;;
        --tailscale) host=tailscale ;;
        *) echo "unknown dev option: $1" >&2; exit 64 ;;
      esac; shift
    done
    state="$HOME/.tron-dev/gateway"; pid_file="$state/dev.pid"; log="$state/dev.log"
    mkdir -p "$state"
    if [[ "$action" == stop ]]; then
      if [[ -f "$pid_file" ]]; then kill "$(cat "$pid_file")" 2>/dev/null || true; rm -f "$pid_file"; fi
      exit 0
    fi
    if [[ "$action" == status ]]; then
      if [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then echo "running pid $(cat "$pid_file")"; else echo "stopped"; exit 1; fi
      exit 0
    fi
    (cd "$GATEWAY" && npm run build)
    args=("$GATEWAY/dist/index.js" --host "$host" --port 9848)
    if ((background)); then
      TRON_HOME_NAME=.tron-dev nohup node "${args[@]}" >"$log" 2>&1 & echo $! >"$pid_file"
      echo "Tron development gateway started (pid $(cat "$pid_file"), log $log)"
    else
      TRON_HOME_NAME=.tron-dev exec node "${args[@]}"
    fi
    ;;
  ci)
    scope="${1:-all}"
    case "$scope" in
      check) (cd "$GATEWAY" && npm ci && npm run build && npm audit --omit=dev) ;;
      test) (cd "$GATEWAY" && npm test) ;;
      all)
        (cd "$GATEWAY" && npm ci && npm run build && npm test && npm audit --omit=dev)
        "$ROOT/scripts/personal-info-guard.sh"
        ;;
      *) echo "unknown ci scope: $scope" >&2; exit 64 ;;
    esac
    ;;
  bundle)
    [[ "${1:-}" == gateway ]] || { usage >&2; exit 64; }
    exec "$ROOT/packages/mac-app/scripts/bundle-gateway.sh" "${@:2}"
    ;;
  ios)
    [[ "${1:-}" == generate ]] || { usage >&2; exit 64; }
    (cd "$ROOT/packages/ios-app" && xcodegen generate)
    ;;
  mac)
    [[ "${1:-}" == generate ]] || { usage >&2; exit 64; }
    (cd "$ROOT/packages/mac-app" && xcodegen generate)
    ;;
  *) usage >&2; exit 64 ;;
esac
