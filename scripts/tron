#!/usr/bin/env bash
# Tron contributor entry point. Production deployment is intentionally absent;
# releases are performed manually by the repository owner.
set -euo pipefail
# Subcommands here run the pinned npm, whose native builds start node-gyp's Python.
# That Python must not write __pycache__ into the npm tree, which the npm digest
# in config/ci-toolchain.env pins by content (#638).
export PYTHONDONTWRITEBYTECODE=1
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATEWAY="$ROOT/packages/gateway"

usage() {
  cat <<'EOF'
Usage: scripts/tron <command> [options]

Commands:
  dev [start|restart|status|preflight|stop|handoff]
                                    Own the immutable Debug Gateway on port 9848
                                    status/preflight are read-only; users initiate
                                    every mutating Gateway lifecycle transition
  chat [--session <id>] [--cwd <path>] [--host <host>] [--port <port>]
                                    Attach terminal chat to the Gateway-owned runtime
  ci [check|test|all]               Validate the gateway and repository policy
  diagnose [--since <1..9999><s|m|h|d>] [--out <path>]
                                    Write one read-only redacted diagnostic bundle
                                    to <path>, or to a new file in the system temp
                                    directory; default window is 2h
  bundle gateway                    Stage the Mac gateway payload and Node runtimes
  ios generate                      Regenerate iOS with pinned XcodeGen
  mac generate                      Regenerate macOS with pinned XcodeGen
  mac verify [--require-bundled]    Verify installed app, payload, LaunchAgent, and PID
  mac reinstall --app <Release.app> [--select-bundled-offline|--confirm-offline|--verify|--status|--restart|--abandon|--finish]
  mac reinstall --recovery-relocate --operation-id <id> --source <root>
  mac reinstall --recovery-verify --operation-id <id>
                                    Resumable preparation or archive-only recovery
                                    registration; app replacement remains manual
  version                           Print the canonical Tron version
  work bootstrap [--apply] [--report <path>]
                                    Plan or converge GitHub labels and the tracking
                                    Project to .github/work.json (tools/work)
  work start <issue> [--session <id>]
                                    Claim an open, unclaimed issue: remote branch,
                                    Project status, claim comment, and its worktree
  work verify [--tests "<command>"]...
                                    Run the local checks the branch diff requires,
                                    plus each --tests command, on the current commit
  work dashboard [--html <path>] [--json <path>]
                                    Read-only live view of all work: epics, claims,
                                    queue, stale, orphans
  work comment <issue> --body-file <md>
                                    Privacy-check and audit a public issue comment
  work issue create --title <t> --body-file <md> [--kind <label>]
                     [--visibility <label>] [--area <label>]... [--type task|epic]
                                    File a task or epic; labels are optional
  work issue labels <issue> [--add <label>] [--remove <label>]
                                    Change only declared work labels
  work issue close <issue> --reason completed|not_planned --comment-file <md>
                                    Comment, close, and set Status Done
  work project add <issue>
                                    Add an issue to the configured work Project
  work project set <issue> [--status Proposed|Ready|Blocked]
                     [--priority P0|P1|P2|P3]
                                    Set work classification fields
  work issue parent <issue> --epic <epic>
  work issue block <issue> --blocked-by <issue>
                                    Create native parent or blocker links
  work land --summary-file <md> [--title <t>] [--tests "<command>"]...
            [--dry-run]             From a task worktree: merge origin/main in, verify
                                    the merged tree, push, open or update the pull
                                    request (body = the summary verbatim), squash-merge
                                    it at the verified commit, delete the branch, and
                                    close the issue as completed with Status Done
  work cleanup [--all] [--dry-run]  Remove this task worktree and its branches once its
                                    PR merged at its head; --all: every one under the
                                    worktree root, naming why each other is kept

There is no deploy command. Production deployment is manual-only.
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  version)
    if (($# == 0)); then
      awk -F= '/^TRON_VERSION=/{gsub(/"/,"",$2); print $2}' "$ROOT/VERSION.env"
    else
      exec "$ROOT/scripts/tron-version" "$@"
    fi
    ;;
  __dev-supervise|dev)
    exec "$ROOT/scripts/tron-dev" "$@"
    ;;
  chat)
    (cd "$GATEWAY" && npm run build >/dev/null)
    exec node "$GATEWAY/dist/client/terminal-chat.js" "$@"
    ;;
  ci)
    scope="${1:-all}"
    case "$scope" in
      check) (cd "$GATEWAY" && npm ci && npm run build && npm audit --omit=dev) ;;
      test) (cd "$GATEWAY" && npm test) ;;
      all)
        (cd "$GATEWAY" && npm ci && npm run build && npm test && npm audit --omit=dev)
        "$ROOT/scripts/personal-info-guard.sh"
        ;;
      *) echo "unknown ci scope: $scope" >&2; exit 64 ;;
    esac
    ;;
  diagnose)
    if [[ ! -f "$GATEWAY/dist/admin/diagnose.js" ]]; then
      echo "missing prepared diagnostic artifact: $GATEWAY/dist/admin/diagnose.js" >&2
      echo "prepare it explicitly with: (cd packages/gateway && npm run build)" >&2
      exit 66
    fi
    exec node "$GATEWAY/dist/admin/diagnose.js" "$@"
    ;;
  work)
    exec python3 "$ROOT/tools/work/cli.py" "$@"
    ;;
  bundle)
    [[ "${1:-}" == gateway ]] || { usage >&2; exit 64; }
    exec "$ROOT/packages/mac-app/scripts/bundle-gateway.sh" "${@:2}"
    ;;
  ios)
    [[ "${1:-}" == generate ]] || { usage >&2; exit 64; }
    exec "$ROOT/scripts/generate-xcode-project" ios "${@:2}"
    ;;
  mac)
    case "${1:-}" in
      generate)
        exec "$ROOT/scripts/generate-xcode-project" mac "${@:2}"
        ;;
      verify)
        exec "$ROOT/scripts/verify-mac-install.sh" "${@:2}"
        ;;
      reinstall)
        exec python3 "$ROOT/scripts/tron_mac_reinstall.py" "${@:2}"
        ;;
      *) usage >&2; exit 64 ;;
    esac
    ;;
  *) usage >&2; exit 64 ;;
esac
