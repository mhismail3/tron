#!/usr/bin/env bash
# Tron contributor entry point. Production deployment is intentionally absent;
# releases are performed manually by the repository owner.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATEWAY="$ROOT/packages/gateway"

usage() {
  cat <<'EOF'
Usage: scripts/tron <command> [options]

Commands:
  dev [start|restart|status|preflight|stop|handoff]
                                    Own the immutable Debug Gateway on port 9848
                                    status/preflight are read-only; users initiate
                                    every mutating Gateway lifecycle transition
  agent-home-preflight --source <absolute-path> --destination <absolute-path>
                                    Read-only assessment of an agent-home move
  agent-home-migrate <stage|verify|cleanup> ...
                                    Explicit, bounded offline staging operations
  internal-migrate <preflight|stage|verify|publish|recover|cleanup> ...
                                    Explicit machine-identity/internal-root migration
  connection-migrate <preflight|prepare|stage|publish|recover> ...
                                    Offline Knowledge catalog/ConnectionOwner migration
  delegated-migrate <preflight|stage|verify|publish|recover|cleanup> ...
                                    Explicit retained pi-subagents root cutover
  agent-home-cutover --app <Release.app> [--confirm-offline|--verify|--status]
                                    One-time offline cutover; manual app activation
                                    See --help for reviewed pre-helper bootstrap
  wizard-migrate <stage|verify|publish|recover|cleanup> ...
                                    Manually stage the legacy Mac wizard key
                                    into internal/mac/wizard-state.json
  chat [--session <id>] [--cwd <path>] [--host <host>] [--port <port>]
                                    Attach terminal chat to the Gateway-owned runtime
  ci [check|test|all]               Validate the gateway and repository policy
  bundle gateway                    Stage the Mac gateway payload and Node runtimes
  ios generate                      Regenerate iOS with pinned XcodeGen
  mac generate                      Regenerate macOS with pinned XcodeGen
  mac verify                        Verify installed app, payload, LaunchAgent, and PID
  mac reinstall --app <Release.app> [--confirm-offline|--verify|--status]
                                    Resumable local preparation; manual replacement
  version                           Print the canonical Tron version

There is no deploy command. Production deployment is manual-only.
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  version)
    if (($# == 0)); then
      awk -F= '/^TRON_VERSION=/{gsub(/"/,"",$2); print $2}' "$ROOT/VERSION.env"
    else
      exec "$ROOT/scripts/tron-version" "$@"
    fi
    ;;
  __dev-supervise|dev)
    exec "$ROOT/scripts/tron-dev" "$@"
    ;;
  agent-home-preflight)
    if [[ ! -f "$GATEWAY/dist/agent-home-preflight.js" ]]; then
      echo "missing prepared preflight artifact: $GATEWAY/dist/agent-home-preflight.js" >&2
      echo "prepare it explicitly with: (cd packages/gateway && npm run build)" >&2
      exit 66
    fi
    exec node "$GATEWAY/dist/agent-home-preflight.js" "$@"
    ;;
  agent-home-migrate)
    if [[ ! -f "$GATEWAY/dist/agent-home-migration.js" ]]; then
      echo "missing prepared migration artifact: $GATEWAY/dist/agent-home-migration.js" >&2
      echo "prepare it explicitly with: (cd packages/gateway && npm run build)" >&2
      exit 66
    fi
    exec node "$GATEWAY/dist/agent-home-migration.js" "$@"
    ;;
  internal-migrate)
    if [[ ! -f "$GATEWAY/dist/internal-layout-migration.js" ]]; then
      echo "missing prepared migration artifact: $GATEWAY/dist/internal-layout-migration.js" >&2
      echo "prepare it explicitly with: (cd packages/gateway && npm run build)" >&2
      exit 66
    fi
    exec node "$GATEWAY/dist/internal-layout-migration.js" "$@"
    ;;
  connection-migrate)
    if [[ ! -f "$GATEWAY/dist/integrations/connection-migration.js" ]]; then
      echo "missing prepared migration artifact: $GATEWAY/dist/integrations/connection-migration.js" >&2
      echo "prepare it explicitly with: (cd packages/gateway && npm run build)" >&2
      exit 66
    fi
    exec node "$GATEWAY/dist/integrations/connection-migration.js" "$@"
    ;;
  delegated-migrate)
    if [[ ! -f "$GATEWAY/dist/sessions/delegated-root-migration.js" ]]; then
      echo "missing prepared migration artifact: $GATEWAY/dist/sessions/delegated-root-migration.js" >&2
      echo "prepare it explicitly with: (cd packages/gateway && npm run build)" >&2
      exit 66
    fi
    exec node "$GATEWAY/dist/sessions/delegated-root-migration.js" "$@"
    ;;
  agent-home-cutover)
    exec python3 "$ROOT/scripts/tron_agent_home_cutover.py" "$@"
    ;;
  wizard-migrate)
    exec python3 "$ROOT/scripts/tron_wizard_migration.py" "$@"
    ;;
  chat)
    (cd "$GATEWAY" && npm run build >/dev/null)
    exec node "$GATEWAY/dist/client/terminal-chat.js" "$@"
    ;;
  ci)
    scope="${1:-all}"
    case "$scope" in
      check) (cd "$GATEWAY" && npm ci && npm run build && npm audit --omit=dev) ;;
      test) (cd "$GATEWAY" && npm test) ;;
      all)
        (cd "$GATEWAY" && npm ci && npm run build && npm test && npm audit --omit=dev)
        "$ROOT/scripts/personal-info-guard.sh"
        ;;
      *) echo "unknown ci scope: $scope" >&2; exit 64 ;;
    esac
    ;;
  bundle)
    [[ "${1:-}" == gateway ]] || { usage >&2; exit 64; }
    exec "$ROOT/packages/mac-app/scripts/bundle-gateway.sh" "${@:2}"
    ;;
  ios)
    [[ "${1:-}" == generate ]] || { usage >&2; exit 64; }
    exec "$ROOT/scripts/generate-xcode-project" ios "${@:2}"
    ;;
  mac)
    case "${1:-}" in
      generate)
        exec "$ROOT/scripts/generate-xcode-project" mac "${@:2}"
        ;;
      verify)
        exec "$ROOT/scripts/verify-mac-install.sh"
        ;;
      reinstall)
        exec python3 "$ROOT/scripts/tron_mac_reinstall.py" "${@:2}"
        ;;
      *) usage >&2; exit 64 ;;
    esac
    ;;
  *) usage >&2; exit 64 ;;
esac
