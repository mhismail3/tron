#!/usr/bin/env bash
# Tron contributor entry point.
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATEWAY="$ROOT/packages/gateway"

use_pinned_node() {
  local node
  node="$("$ROOT/scripts/tron-node")" || exit
  export PATH="$(dirname "$node"):$PATH"
}

usage() {
  cat <<'EOF'
Usage: scripts/tron <command> [options]

Commands:
  dev [start|restart|status|preflight|stop|handoff]
                                    Own the immutable Debug Gateway on port 9848;
                                    status/preflight are read-only; users initiate
                                    every mutating Gateway lifecycle transition
  chat [--session <id>] [--cwd <path>] [--host <host>] [--port <port>]
                                    Attach terminal chat to the Gateway-owned runtime
  test gateway [--mini|--local] [vitest args...]
                                    Run Gateway tests with pinned Node on the test-host pool: the Mac
                                    mini when reachable and idle, else here (tools/verify/README.md)
  test ios [runner args...]         Run the owned iOS test runner directly (3 host-wide simulator
                                    slots; a 4th job waits; `test ios slots` shows holders)
  test mac [test classes...]        Build and run the Mac integration tests under a temporary HOME
  test tooling [test files...]      Run Python script integration suites directly
  provider-smoke [--probe-only] [--live --agent-dir <dir>] [--require-fable-5-2] [--json]
                                    Claude subscription smoke of the pinned Pi: Fable 5.2,
                                    the Claude Code version it sends, Tron's wiring tests
                                    (tools/claude-provider-smoke)
  computer-bench [--tools <list>] [--reps N] [--only <tasks>] [--foreground] [--json <file>] [--markdown <file>]
                                    Computer- and browser-use scorecard: fixed local tasks per
                                    tool and Tron surface (tools/computer-bench)
  build gateway                     Build Gateway directly with pinned Node
  migrate connections-residue --tron-home <dir> [--apply --backup <new dir>]
  migrate connections-residue --restore --backup <dir>
                                    One-shot #2327 removal of retired connection setup
                                    operations, receipts and Raindrop collection mappings;
                                    dry run unless --apply; never at startup
  diagnose [--since <1..9999><s|m|h|d>] [--out <path>]
                                    Write one read-only redacted diagnostic bundle
                                    to <path>, or to a new file in the system temp
                                    directory; default window is 2h
  bundle gateway                    Stage the Mac gateway payload and Node runtimes
  ios generate                      Regenerate iOS with pinned XcodeGen
  ios source                        Resolve fetched origin/main for install/share
  mac generate                      Regenerate macOS with pinned XcodeGen
  mac verify [--require-bundled]    Verify installed app, payload, LaunchAgent, and PID
  mac replace --plan|--start|--status [--follow] [--json]
                                    One-tap app replacement (also from iPhone Settings)
  mac reinstall --app <Release.app> [--select-bundled-offline|--confirm-offline|--verify|--status|--restart|--abandon|--finish]
                                    Resumable manual reinstall preparation
  checkpoint [--test-mode|--prepare-reinstall]
                                    Rebuild main; five isolated simulator/Gateway smoke outcomes
                                    --prepare-reinstall writes a manual maintenance receipt, never installs
  version                           Print the canonical Tron version
  metrics [<rev>] [--compare <base>]
                                    Read-only repository metrics of a commit's Git
                                    objects to test-results/metrics/<sha>.json;
                                    --compare prints the delta table; never a gate
  verify [--changed] [--base <ref>] | --module <id> | --all | --update-locks <id> [--skip ios,mac,relay] [--plan]
         [--gateway-host pool|local|mini]
                                    Mechanical none/partial/full tier; affected checks
                                    now, full coverage in the async main batch.
                                    --plan includes dirty paths and exact commands.
                                    Live logs and partial test-results/verify/<sha>.json;
                                    no empty test passes, queue or landing gate.
  verify --batch [--base <main-anchor> | --repeat] [--plan]
                                    Async full-main batch; first use needs --base, then
                                    raw last-green owns coverage. Proves a red's culprit
                                    with fresh exact-case controls, prepares its revert;
                                    publishes only after review, once
                                    `git config tron.verify.revertRemote origin`.
  verify --batch --review <culprit> --decision ACCEPT|BLOCK --reviewer <id> --binding <digest>
                                    Record a non-author decision on one bound request.
  mutate <gateway-src-file> [--count N] [--seed S] [--timeout SECONDS]
                                    Seeded sampled mutation of one file against the tests
                                    verify selects for it (lock sensitivity, plan 6.6);
                                    test-results/mutate/; measures, never gates
  layers [gateway|ios] [--update] [--base <ref>]
                                    Gateway import graph (pinned tsc) or iOS index store
                                    (fresh tron-ios-test build) against manifest layers
                                    and dependsOn; fails a new upward or two-way pair or
                                    unindexed file beyond packages/<pkg>/layer-baseline.json,
                                    which only shrinks; undeclared pairs are reported only
                                    (tools/layers); never a gate
  layers tests                      Report only: per Gateway module, test files that
                                    reach another module's files, test-support, or
                                    import the registry directly (#2316)
  proof bootstrap|doctor            Install (bootstrap) or re-verify (doctor) the pinned Dafny
                                    proof toolchain in the per-user cache (tools/proof)
  proof wire --generate <in.dfy> <out-dir>
                                    Generate TypeScript and Swift codecs from @wire datatypes
  proof wire --protocol [--check]   Write (or check) the Gateway's protocol types and decoders
                                    from packages/core/wire/Protocol.dfy
  proof check [<block>...] [--json] Check proof blocks (packages/core/blocks) and the blocks
                                    below them with the pinned toolchain; cached per worktree
  proof mutate <block> [options]    Mutation gate: every change to a block's compiled functions
                                    must be killed by a law (tools/proof/README.md)
  proof packet <block> [options]    Render a block's hash-bound law review packet (LAWS.md)
  proof facade <block> [--check]    Generate (or check) a block's compiled core and its typed
                                    TypeScript façade in its shell
  health [<rev>] [--baseline <rev>] [--github] [--evidence] [--deploy-log <jsonl>]
         [--home-sessions <dir>] [--backtest <t0>] [--csv <dir>]
                                    Read-only outcome and diagnostic health signals diffed
                                    against the baseline (docs/HEALTH.md); never a gate
  home-layout check                 Tron-home path registry (docs/tron-home.md): check
                                    source literals (tools/home-layout)
  docs modules [<path>]|signals|rpc|settings
                                    Print a generated Markdown index (module map, module
                                    README Signals, Gateway RPCs, settings keys); docs
                                    check [--base <ref>]|update: stale <!-- tron docs -->
                                    blocks (tools/docs)
  ownership [<rev>] [--modules|--ledger]
                                    Read-only check that every tracked path has exactly
                                    one module owner and follows the layout
                                    root.module.json declares (tools/ownership); exit 1
                                    lists violations with their fix; --ledger prints
                                    path, module, layer and purpose per tracked path
  tidy [--json] [--prune]           Report untracked files, residue, expired .scratch/
                                    and test-results/, unnamed tooling, worktrees,
                                    branches and hook drift; --prune deletes only what
                                    main already has (tools/ownership/tidy.py)
  work bootstrap [--apply [--prune]] [--report <path>]
                                    Plan or converge GitHub labels and the tracking
                                    Project to tools/work/work.json (tools/work); reports
                                    undeclared labels, fields and options as drift;
                                    --prune deletes the ones no open work uses
  work comment <issue> --body-file <md>
                                    Privacy-check and audit a public issue comment
  work issue create --title <t> --body-file <md> --kind <label> --area <label>...
                     [--status Ready|Blocked] [--priority P0..P3] [--exit-by YYYY-MM-DD]
                     [--type epic]
                                    File a classified task (or an epic) onto the Project
  work issue edit <issue> [--title <t>] [--body-file <md>]
                                    Replace a title or body, e.g. its remaining scope
  work issue labels <issue> [--add <label>] [--remove <label>]
                                    Change only declared work labels
  work issue close <issue> --reason completed|not_planned --comment-file <md>
                                    Comment, close, and set Status Done
  work project add <issue>
                                    Add an issue to the configured work Project
  work project set <issue> [--status Ready|Blocked]
                     [--priority P0|P1|P2|P3]
                                    Set work classification fields
  work issue parent <issue> --epic <epic>
  work issue block <issue> --blocked-by <issue>
                                    Create native parent or blocker links
  work auth setup|status            Store the agents' dedicated GitHub token once in
                                    Keychain (maintainer, Terminal), or show its login,
                                    scopes and expiry; every work command checks it first

  terminal-ssh status|start|stop|recover --home <tron-home>
                                    Own private user SSH service; no root, PF, or
                                    stock Remote Login changes. Status is read-only.

There is no deploy command. Production deployment is manual-only.
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  version)
    if (($# == 0)); then
      awk -F= '/^TRON_VERSION=/{gsub(/"/,"",$2); print $2}' "$ROOT/VERSION.env"
    else
      exec "$ROOT/scripts/version/tron-version" "$@"
    fi
    ;;
  __dev-supervise|dev)
    exec "$ROOT/scripts/tron-dev" "$@"
    ;;
  chat)
    use_pinned_node
    (cd "$GATEWAY" && npm run build >/dev/null)
    exec node "$GATEWAY/dist/client/terminal-chat.js" "$@"
    ;;
  test)
    suite="${1:-}"; shift || true
    case "$suite" in
      gateway)
        case "${1:-}" in
          --mini) shift; exec python3 "$ROOT/tools/verify/mini.py" "$@" ;;
          --local) shift; exec python3 "$ROOT/tools/verify/gateway.py" "$@" ;;
          *) exec python3 "$ROOT/tools/verify/mini.py" pool "$@" ;;
        esac
        ;;
      ios) exec "$ROOT/scripts/tron-ios-test" "$@" ;;
      mac) exec python3 "$ROOT/tools/verify/mac.py" "$@" ;;
      tooling)
        if (($# == 0)); then set -- "$ROOT"/tools/work/tests/test-*.py; fi
        for suite in "$@"; do python3 "$suite"; done
        ;;
      *) usage >&2; exit 64 ;;
    esac
    ;;
  build)
    [[ "${1:-}" == gateway && $# == 1 ]] || { usage >&2; exit 64; }
    use_pinned_node
    cd "$GATEWAY"
    exec npm run build
    ;;
  terminal-ssh)
    use_pinned_node
    [[ -f "$GATEWAY/dist/security/mac-terminal-cli.js" ]] || {
      echo "Prepare the CLI first: scripts/tron build gateway" >&2; exit 66;
    }
    exec node "$GATEWAY/dist/security/mac-terminal-cli.js" "$@"
    ;;
  migrate)
    [[ "${1:-}" == connections-residue ]] || { usage >&2; exit 64; }
    shift
    use_pinned_node
    [[ -f "$GATEWAY/dist/integrations/connections-residue-migration.js" ]] || {
      echo "Prepare it first: scripts/tron build gateway" >&2; exit 66;
    }
    exec node "$GATEWAY/dist/integrations/connections-residue-migration.js" "$@"
    ;;
  diagnose)
    use_pinned_node
    if [[ ! -f "$GATEWAY/dist/admin/diagnose.js" ]]; then
      echo "missing prepared diagnostic artifact: $GATEWAY/dist/admin/diagnose.js" >&2
      echo "prepare it explicitly with: (cd packages/gateway && npm run build)" >&2
      exit 66
    fi
    exec node "$GATEWAY/dist/admin/diagnose.js" "$@"
    ;;
  checkpoint)
    exec python3 "$ROOT/scripts/tron_checkpoint.py" "$@"
    ;;
  work)
    exec python3 "$ROOT/tools/work/cli.py" "$@"
    ;;
  metrics)
    exec python3 "$ROOT/tools/metrics/metrics.py" "$@"
    ;;
  docs)
    exec python3 "$ROOT/tools/docs/docs.py" "$@"
    ;;
  ownership)
    exec python3 "$ROOT/tools/ownership/ownership.py" "$@"
    ;;
  tidy)
    exec python3 "$ROOT/tools/ownership/tidy.py" "$@"
    ;;
  health)
    exec python3 "$ROOT/tools/metrics/health.py" "$@"
    ;;
  provider-smoke)
    use_pinned_node
    exec node "$ROOT/tools/claude-provider-smoke/smoke.mjs" "$@"
    ;;
  computer-bench)
    use_pinned_node
    exec node "$ROOT/tools/computer-bench/bench.mjs" "$@"
    ;;
  home-layout)
    exec python3 "$ROOT/tools/home-layout/home_layout.py" "$@"
    ;;
  layers)
    exec python3 "$ROOT/tools/layers/layers.py" "$@"
    ;;
  proof)
    case "${1:-}" in
      bootstrap|doctor) exec /bin/bash "$ROOT/tools/proof/bootstrap.sh" "$@" ;;
      wire)
        shift; use_pinned_node
        case "${1:-}" in
          --generate|--protocol) exec node "$ROOT/tools/proof/dafny2wire/dafny2wire.mjs" "$@" ;;
          *) usage >&2; exit 64 ;;
        esac
        ;;
      check) shift; use_pinned_node; exec node "$ROOT/tools/proof/lawcheck/lawcheck.mjs" "$@" ;;
      mutate) shift; use_pinned_node; exec node "$ROOT/tools/proof/mutate/mutate.mjs" "$@" ;;
      packet) shift; use_pinned_node; exec node "$ROOT/tools/proof/packet/packet.mjs" "$@" ;;
      facade) shift; use_pinned_node; exec node "$ROOT/tools/proof/dafny2wire/facade.mjs" "$@" ;;
      *) usage >&2; exit 64 ;;
    esac
    ;;
  verify)
    exec python3 "$ROOT/tools/verify/verify.py" "$@"
    ;;
  mutate)
    exec python3 "$ROOT/tools/verify/mutate.py" "$@"
    ;;
  bundle)
    [[ "${1:-}" == gateway ]] || { usage >&2; exit 64; }
    exec "$ROOT/packages/mac-app/scripts/bundle-gateway.sh" "${@:2}"
    ;;
  ios)
    case "${1:-}" in
      generate) exec "$ROOT/scripts/generate-xcode-project" ios "${@:2}" ;;
      source) exec python3 "$ROOT/scripts/run-main-source.py" ;;
      *) usage >&2; exit 64 ;;
    esac
    ;;
  mac)
    case "${1:-}" in
      generate)
        exec "$ROOT/scripts/generate-xcode-project" mac "${@:2}"
        ;;
      verify)
        exec "$ROOT/scripts/verify-mac-install.sh" "${@:2}"
        ;;
      reinstall)
        exec python3 "$ROOT/scripts/tron_mac_reinstall.py" "${@:2}"
        ;;
      replace)
        exec /usr/bin/python3 "$ROOT/scripts/tron_mac_replace.py" "${@:2}"
        ;;
      *) usage >&2; exit 64 ;;
    esac
    ;;
  *) usage >&2; exit 64 ;;
esac
