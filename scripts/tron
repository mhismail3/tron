#!/usr/bin/env bash
# Tron contributor entry point. Production deployment is intentionally absent;
# releases are performed manually by the repository owner.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATEWAY="$ROOT/packages/gateway"

usage() {
  cat <<'EOF'
Usage: scripts/tron <command> [options]

Commands:
  dev [start|restart|status|preflight|stop|handoff]
                                    Own the immutable Debug Gateway on port 9848
                                    status/preflight are read-only; users initiate
                                    every mutating Gateway lifecycle transition
  chat [--session <id>] [--cwd <path>] [--host <host>] [--port <port>]
                                    Attach terminal chat to the Gateway-owned runtime
  ci [check|test|all]               Validate the gateway and repository policy
  bundle gateway                    Stage the Mac gateway payload and Node runtimes
  ios generate                      Regenerate the iOS Xcode project
  mac generate                      Regenerate the macOS Xcode project
  mac verify                        Verify installed app, payload, LaunchAgent, and PID
  version                           Print the canonical Tron version

There is no deploy command. Production deployment is manual-only.
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  version)
    if (($# == 0)); then
      awk -F= '/^TRON_VERSION=/{gsub(/"/,"",$2); print $2}' "$ROOT/VERSION.env"
    else
      exec "$ROOT/scripts/tron-version" "$@"
    fi
    ;;
  __dev-supervise|dev)
    exec "$ROOT/scripts/tron-dev" "$@"
    ;;
  chat)
    (cd "$GATEWAY" && npm run build >/dev/null)
    exec node "$GATEWAY/dist/client/terminal-chat.js" "$@"
    ;;
  ci)
    scope="${1:-all}"
    case "$scope" in
      check) (cd "$GATEWAY" && npm ci && npm run build && npm audit --omit=dev) ;;
      test) (cd "$GATEWAY" && npm test) ;;
      all)
        (cd "$GATEWAY" && npm ci && npm run build && npm test && npm audit --omit=dev)
        "$ROOT/scripts/personal-info-guard.sh"
        ;;
      *) echo "unknown ci scope: $scope" >&2; exit 64 ;;
    esac
    ;;
  bundle)
    [[ "${1:-}" == gateway ]] || { usage >&2; exit 64; }
    exec "$ROOT/packages/mac-app/scripts/bundle-gateway.sh" "${@:2}"
    ;;
  ios)
    [[ "${1:-}" == generate ]] || { usage >&2; exit 64; }
    exec "$ROOT/scripts/generate-ios-project" "${@:2}"
    ;;
  mac)
    case "${1:-}" in
      generate)
        (cd "$ROOT/packages/mac-app" && xcodegen generate)
        ;;
      verify)
        exec "$ROOT/scripts/verify-mac-install.sh"
        ;;
      *) usage >&2; exit 64 ;;
    esac
    ;;
  *) usage >&2; exit 64 ;;
esac
