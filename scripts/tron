#!/usr/bin/env bash
# Tron contributor entry point. Production deployment is intentionally absent;
# releases are performed manually by the repository owner.
set -euo pipefail
# Subcommands here run the pinned npm, whose native builds start node-gyp's Python.
# That Python must not write __pycache__ into the npm tree, which the npm digest
# in config/ci-toolchain.env pins by content (#638).
export PYTHONDONTWRITEBYTECODE=1
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATEWAY="$ROOT/packages/gateway"

# Gateway development commands run the one repository-pinned development Node
# (scripts/tron-node, #242), never whatever `node` is first on PATH, which in an
# agent shell is the Gateway's signed payload runtime.
use_pinned_node() {
  local node
  node="$("$ROOT/scripts/tron-node")" || exit
  export PATH="$(dirname "$node"):$PATH"
}

usage() {
  cat <<'EOF'
Usage: scripts/tron <command> [options]

Commands:
  dev [start|restart|status|preflight|stop|handoff]
                                    Own the immutable Debug Gateway on port 9848
                                    status/preflight are read-only; users initiate
                                    every mutating Gateway lifecycle transition
  chat [--session <id>] [--cwd <path>] [--host <host>] [--port <port>]
                                    Attach terminal chat to the Gateway-owned runtime
  test gateway [vitest args...]      Run Gateway tests directly with pinned Node
  test ios [runner args...]         Run the owned iOS test runner directly
  test tooling [test files...]      Run Python script integration suites directly
  build gateway                     Build Gateway directly with pinned Node
  diagnose [--since <1..9999><s|m|h|d>] [--out <path>]
                                    Write one read-only redacted diagnostic bundle
                                    to <path>, or to a new file in the system temp
                                    directory; default window is 2h
  bundle gateway                    Stage the Mac gateway payload and Node runtimes
  ios generate                      Regenerate iOS with pinned XcodeGen
  ios source                        Resolve fetched origin/main for install/share
  mac generate                      Regenerate macOS with pinned XcodeGen
  mac verify [--require-bundled]    Verify installed app, payload, LaunchAgent, and PID
  mac replace --plan|--start|--status [--follow] [--json]
                                    One-tap app replacement (also from iPhone Settings)
  mac reinstall --app <Release.app> [--select-bundled-offline|--confirm-offline|--verify|--status|--restart|--abandon|--finish]
  mac reinstall --recovery-relocate --operation-id <id> --source <root>
  mac reinstall --recovery-verify --operation-id <id>
                                    Resumable preparation or archive-only recovery
                                    registration (manual path)
  version                           Print the canonical Tron version
  metrics [<rev>] [--compare <base>]
                                    Read-only restructure metrics of a commit's Git
                                    objects to test-results/metrics/<sha>.json;
                                    --compare prints the delta table; never a gate
  layers [gateway|ios] [--update] [--base <ref>]
                                    Gateway import graph (pinned tsc) or iOS index store
                                    (fresh tron-ios-test build) against manifest layers
                                    and dependsOn; fails new or grown violations beyond
                                    packages/<pkg>/layer-baseline.json, which only
                                    shrinks (tools/layers); never a gate
  budgets [<rev>] [--base <ref>]   File-size (500) and doc budgets of a commit (tools/metrics
                                    counts) with shrink-only manifest exceptions bounded by
                                    <ref> (default origin/main); never a gate
  ownership [<rev>] [--modules]     Read-only check that every tracked path has exactly
                                    one <name>.module.json owner (tools/ownership);
                                    exit 1 lists violations; never a gate
  work bootstrap [--apply [--prune]] [--report <path>]
                                    Plan or converge GitHub labels and the tracking
                                    Project to .github/work.json (tools/work); reports
                                    undeclared labels, fields and options as drift;
                                    --prune deletes the ones no open work uses
  work start <issue> [--session <id>] [--integration] [--base <remote-branch>]
                                    Claim an open, unclaimed issue: remote branch,
                                    Project status, claim comment, and its worktree;
                                    --integration explicitly admits epics, --base records
                                    the exact configured-remote starting branch
  work handoff <issue> --reason <text> [--session <id>]
                                    Transfer an existing claim in place; unknown owner
                                    state refuses; force requires exact TTY confirmation
  work recover <issue> --expected-local <SHA> --expected-remote <SHA> --reason <text>
                                    Publish a clean settled-owner descendant as unverified
                                    work; exact heads required; handoff remains separate
  work release <issue> --reason <text> | --stale [--dry-run]
                                    Give up a stale claim after preserving its work;
                                    --stale sweeps claims idle over 72h whose owner is
                                    absent; force (TTY) only for a legacy non-Gateway owner
  work dashboard [--html <path>] [--json <path>]
                                    Read-only live view of all work: epics, claims,
                                    queue, stale, paused epics, past exit dates, orphans
  work comment <issue> --body-file <md>
                                    Privacy-check and audit a public issue comment
  work issue create --title <t> --body-file <md> --kind <label> --area <label>...
                     [--status Ready|Blocked] [--priority P0..P3] [--exit-by YYYY-MM-DD]
                     [--type epic]
                                    File a classified task (or an epic) onto the Project
  work issue edit <issue> [--title <t>] [--body-file <md>]
                                    Replace a title or body, e.g. its remaining scope
  work issue labels <issue> [--add <label>] [--remove <label>]
                                    Change only declared work labels
  work issue close <issue> --reason completed|not_planned --comment-file <md>
                                    Comment, close, and set Status Done
  work project add <issue>
                                    Add an issue to the configured work Project
  work project set <issue> [--status Ready|Blocked]
                     [--priority P0|P1|P2|P3]
                                    Set work classification fields
  work issue parent <issue> --epic <epic>
  work issue block <issue> --blocked-by <issue>
                                    Create native parent or blocker links
  work ledger [--json <path>] | --module <id> | --sync <issue> | --create <id> --epic <n>
                                    Compare manifest ownership with module-issue
                                    checklists (exit 3: GitHub unavailable, not clean);
                                    --sync/--create write only that module issue
  work review-export --output <patch> [--base <ref>]
                                    Export committed base/head/tree, stat and binary patch
  work land [--dry-run]              Fetch, merge origin/main, push HEAD to main
                                    No tests, receipts, PR, locks or waiting on workers
  work auth setup|status            Store the agents' dedicated GitHub token once in
                                    Keychain (maintainer, Terminal), or show its login,
                                    scopes and expiry; every work command checks it first
  work cleanup [--all] [--dry-run]  Remove this task worktree and its branches once its
                                    PR merged at its head; --all: every one under the
                                    worktree root, naming why each other is kept

There is no deploy command. Production deployment is manual-only.
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  version)
    if (($# == 0)); then
      awk -F= '/^TRON_VERSION=/{gsub(/"/,"",$2); print $2}' "$ROOT/VERSION.env"
    else
      exec "$ROOT/scripts/tron-version" "$@"
    fi
    ;;
  __dev-supervise|dev)
    exec "$ROOT/scripts/tron-dev" "$@"
    ;;
  chat)
    use_pinned_node
    (cd "$GATEWAY" && npm run build >/dev/null)
    exec node "$GATEWAY/dist/client/terminal-chat.js" "$@"
    ;;
  test)
    # Direct invocation: no shared admission or remembered pass is consulted.
    suite="${1:-}"; shift || true
    case "$suite" in
      gateway)
        use_pinned_node
        cd "$GATEWAY"
        exec npx vitest run "$@"
        ;;
      ios) exec "$ROOT/scripts/tron-ios-test" "$@" ;;
      tooling)
        if (($# == 0)); then set -- "$ROOT"/scripts/test-work-*.py; fi
        for suite in "$@"; do python3 "$suite"; done
        ;;
      *) usage >&2; exit 64 ;;
    esac
    ;;
  build)
    [[ "${1:-}" == gateway && $# == 1 ]] || { usage >&2; exit 64; }
    use_pinned_node
    cd "$GATEWAY"
    exec npm run build
    ;;
  diagnose)
    use_pinned_node
    if [[ ! -f "$GATEWAY/dist/admin/diagnose.js" ]]; then
      echo "missing prepared diagnostic artifact: $GATEWAY/dist/admin/diagnose.js" >&2
      echo "prepare it explicitly with: (cd packages/gateway && npm run build)" >&2
      exit 66
    fi
    exec node "$GATEWAY/dist/admin/diagnose.js" "$@"
    ;;
  work)
    exec python3 "$ROOT/tools/work/cli.py" "$@"
    ;;
  metrics)
    exec python3 "$ROOT/tools/metrics/metrics.py" "$@"
    ;;
  ownership)
    exec python3 "$ROOT/tools/ownership/ownership.py" "$@"
    ;;
  budgets)
    exec python3 "$ROOT/tools/budgets/budgets.py" "$@"
    ;;
  layers)
    exec python3 "$ROOT/tools/layers/layers.py" "$@"
    ;;
  bundle)
    [[ "${1:-}" == gateway ]] || { usage >&2; exit 64; }
    exec "$ROOT/packages/mac-app/scripts/bundle-gateway.sh" "${@:2}"
    ;;
  ios)
    case "${1:-}" in
      generate) exec "$ROOT/scripts/generate-xcode-project" ios "${@:2}" ;;
      source) exec python3 "$ROOT/scripts/run-main-source.py" ;;
      *) usage >&2; exit 64 ;;
    esac
    ;;
  mac)
    case "${1:-}" in
      generate)
        exec "$ROOT/scripts/generate-xcode-project" mac "${@:2}"
        ;;
      verify)
        exec "$ROOT/scripts/verify-mac-install.sh" "${@:2}"
        ;;
      reinstall)
        exec python3 "$ROOT/scripts/tron_mac_reinstall.py" "${@:2}"
        ;;
      replace)
        exec /usr/bin/python3 "$ROOT/scripts/tron_mac_replace.py" "${@:2}"
        ;;
      *) usage >&2; exit 64 ;;
    esac
    ;;
  *) usage >&2; exit 64 ;;
esac
