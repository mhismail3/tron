#!/usr/bin/env bash
# Real iOS SSH/tmux journey. Only the test sshd and its keys are fixture-owned;
# no Gateway build, Tron host process or system service is started.
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
artifacts="$repo_root/packages/ios-app/test-results/mac-terminal"
tailscale_cli=/Applications/Tailscale.app/Contents/MacOS/Tailscale
[[ -x "$tailscale_cli" ]] || { echo "error: Tailscale is required" >&2; exit 69; }
address="$(TAILSCALE_BE_CLI=1 "$tailscale_cli" ip -4)"
[[ "$address" =~ ^100\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "error: Mac is not on Tailscale" >&2; exit 69; }
tmux="$(command -v tmux)" || { echo "error: install tmux before running this journey" >&2; exit 69; }
# Exactly the synthetic Mac/iPhone identity used by HostedMacTerminalFixture.
session="tron-$(printf '%s' 'mac-terminal-machine:fixture-iphone' | shasum -a 256 | cut -d ' ' -f 1)"
work="$(mktemp -d "${TMPDIR:-/tmp}/tron-ssh-journey.XXXXXX")"
sshd_pid=""
cleanup() {
  if [[ -n "$sshd_pid" ]]; then kill "$sshd_pid" 2>/dev/null || true; wait "$sshd_pid" 2>/dev/null || true; fi
  "$tmux" -L tron-mobile kill-session -t "=$session" 2>/dev/null || true
  mkdir -p "$artifacts"
  cp "$work/sshd.log" "$artifacts/sshd.log" 2>/dev/null || true
  rm -rf "$work"
}
trap cleanup EXIT
"$tmux" -L tron-mobile kill-session -t "=$session" 2>/dev/null || true
ssh-keygen -q -t ed25519 -N "" -C journey-host -f "$work/ssh_host_ed25519_key"
ssh-keygen -q -t ed25519 -N "" -C journey-other -f "$work/other_host_key"
: > "$work/authorized_keys"
chmod 600 "$work/authorized_keys"
port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
python3 - "$work" "$address" "$port" "$(id -un)" <<'PY'
import json, pathlib, sys
work, address, port, user = sys.argv[1:]
root = pathlib.Path(work)
(root / 'sshd_config').write_text('\n'.join([
    f'Port {port}', f'ListenAddress {address}', f'HostKey {work}/ssh_host_ed25519_key',
    f'AuthorizedKeysFile {work}/authorized_keys', 'PasswordAuthentication no',
    'KbdInteractiveAuthentication no', 'UsePAM no', 'StrictModes no',
    f'PidFile {work}/sshd.pid', 'Include /etc/ssh/crypto.conf',
    # Hermetic fixture shell: no personal interactive startup scripts can eat
    # early typed input. The application's actual SSH command is unchanged.
    'ForceCommand /usr/bin/env SHELL=/bin/sh /bin/sh -c "$SSH_ORIGINAL_COMMAND"', '',
]))
key = lambda name: ' '.join((root / name).read_text().split()[:2])
(root / 'fixture.json').write_text(json.dumps({
    'hosts': [address], 'port': int(port), 'username': user,
    'hostKeys': [key('ssh_host_ed25519_key.pub')], 'otherHostKey': key('other_host_key.pub'),
    'authorizedKeys': f'{work}/authorized_keys',
}))
PY
/usr/sbin/sshd -D -f "$work/sshd_config" -E "$work/sshd.log" &
sshd_pid=$!
mkdir -p "$artifacts"
TEST_RUNNER_TRON_MAC_TERMINAL_FIXTURE="$work/fixture.json" \
TEST_RUNNER_TRON_MAC_TERMINAL_CAPTURE_DIR="$artifacts" \
  "$repo_root/scripts/tron-ios-test" run --only-testing TronMobileUITests/TronMacTerminalUITests "$@"
