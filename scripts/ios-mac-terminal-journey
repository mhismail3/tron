#!/usr/bin/env bash
# Mac Terminal's iOS journey (README "Mac Terminal"): starts a real OpenSSH
# sshd as this user on this Mac's Tailscale address, with its own host key and
# an empty authorized_keys, then runs TronMacTerminalUITests against it through
# the owned test simulator (`scripts/tron-ios-test run`, which takes the
# host-wide heavy slot itself). The synthetic Gateway in the hosted fixture
# writes the enrolled key into that authorized_keys; the app's SSH client, key,
# PTY and shell are real. Screenshots land in
# packages/ios-app/test-results/mac-terminal/; the sshd log is kept beside them.
#
#   scripts/ios-mac-terminal-journey [extra tron-ios-test run arguments]
#
# Needs this Mac on its tailnet. Build the test products first with
# `scripts/tron-ios-test build`.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
artifacts="$repo_root/packages/ios-app/test-results/mac-terminal"

tailscale_cli=/Applications/Tailscale.app/Contents/MacOS/Tailscale
[[ -x "$tailscale_cli" ]] || tailscale_cli="$(command -v tailscale || true)"
[[ -n "$tailscale_cli" ]] || { echo "error: Mac Terminal's journey needs Tailscale on this Mac" >&2; exit 69; }
address="$(TAILSCALE_BE_CLI=1 "$tailscale_cli" ip -4 2>/dev/null | head -1 || true)"
[[ "$address" =~ ^100\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "error: this Mac is not on its tailnet (tailscale ip -4 gave '$address')" >&2; exit 69; }
dns_name="$(TAILSCALE_BE_CLI=1 "$tailscale_cli" status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))')"

work="$(mktemp -d "${TMPDIR:-/tmp}/tron-mac-terminal-journey.XXXXXX")"
sshd_pid=""
cleanup() {
  if [[ -n "$sshd_pid" ]]; then kill "$sshd_pid" 2>/dev/null || true; wait "$sshd_pid" 2>/dev/null || true; fi
  mkdir -p "$artifacts"
  cp "$work/sshd.log" "$artifacts/sshd.log" 2>/dev/null || true
  rm -rf "$work"
}
trap cleanup EXIT

ssh-keygen -q -t ed25519 -N "" -C journey-host -f "$work/ssh_host_ed25519_key"
ssh-keygen -q -t ed25519 -N "" -C journey-other -f "$work/other_host_key"
: > "$work/authorized_keys"
chmod 600 "$work/authorized_keys"
port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
cat > "$work/sshd_config" <<EOF
Port $port
ListenAddress $address
HostKey $work/ssh_host_ed25519_key
AuthorizedKeysFile $work/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
StrictModes no
PidFile $work/sshd.pid
Include /etc/ssh/crypto.conf
EOF
/usr/sbin/sshd -D -f "$work/sshd_config" -E "$work/sshd.log" &
sshd_pid=$!

python3 - "$work" "$dns_name" "$address" "$port" "$(id -un)" <<'PY'
import json, sys
work, dns_name, address, port, user = sys.argv[1:]
key = lambda name: " ".join(open(f"{work}/{name}").read().split()[:2])
json.dump({
    "hosts": [dns_name, address], "port": int(port), "username": user,
    "hostKeys": [key("ssh_host_ed25519_key.pub")], "otherHostKey": key("other_host_key.pub"),
    "authorizedKeys": f"{work}/authorized_keys",
}, open(f"{work}/fixture.json", "w"))
PY

rm -rf "$artifacts"
mkdir -p "$artifacts"
TEST_RUNNER_TRON_MAC_TERMINAL_FIXTURE="$work/fixture.json" \
TEST_RUNNER_TRON_MAC_TERMINAL_CAPTURE_DIR="$artifacts" \
  "$repo_root/scripts/tron-ios-test" run --only-testing TronMobileUITests/TronMacTerminalUITests "$@"
