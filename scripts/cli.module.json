{
  "layer": "L5",
  "purpose": "The scripts/tron front door and the pinned toolchain it resolves: Node (tron-node), CI tools, XcodeGen projects, version mirrors and main-source runs.",
  "owns": [
    "cli.module.json",
    "generate-xcode-project",
    "hash-npm-runtime.py",
    "install-ci-tools.sh",
    "node-pin-mirrors.py",
    "run-main-source.py",
    "test-install-ci-tools-node.sh",
    "test-main-source.py",
    "test-tron-node.py",
    "test-tron-npm-bytecode.sh",
    "test-verify-ci-toolchain.py",
    "tron",
    "tron-node",
    "tron-version",
    "update-model-release-dates.mjs",
    "verify-ci-toolchain.sh"
  ],
  "interfaces": [
    {
      "name": "scripts/generate-xcode-project",
      "kind": "exec",
      "consumers": [
        "ios-app/package",
        "repo/ios",
        "repo/profile"
      ]
    },
    {
      "name": "scripts/hash-npm-runtime.py",
      "kind": "exec",
      "consumers": [
        "mac-app/gateway-payload",
        "repo/dev"
      ]
    },
    {
      "name": "scripts/install-ci-tools.sh",
      "kind": "exec",
      "consumers": [
        "mac-app/gateway-payload",
        "repo/dev",
        "repo/ios",
        "repo/mac",
        "repo/root"
      ]
    },
    {
      "name": "scripts/node-pin-mirrors.py",
      "kind": "exec",
      "consumers": [
        "repo/ios"
      ]
    },
    {
      "name": "scripts/run-main-source.py",
      "kind": "exec",
      "consumers": [
        "repo/ios"
      ]
    },
    {
      "name": "scripts/tron",
      "kind": "exec",
      "consumers": [
        "gateway/admin",
        "gateway/package",
        "gateway/run",
        "gateway/security",
        "ios-app/hosted-fixtures",
        "ios-app/package",
        "ios-app/settings",
        "ios-app/ui-tests",
        "mac-app/app",
        "mac-app/integration-tests",
        "mac-app/package",
        "mac-app/server",
        "mac-app/wizard",
        "repo/budgets",
        "repo/dev",
        "repo/docs-index",
        "repo/ios",
        "repo/layers",
        "repo/mac",
        "repo/metrics",
        "repo/ownership",
        "repo/root",
        "repo/verify",
        "repo/work"
      ],
      "external": "maintainer and agents in Terminal (AGENTS.md, docs/development.md)"
    },
    {
      "name": "scripts/tron-node",
      "kind": "exec",
      "consumers": [
        "gateway/pi-sdk",
        "mac-app/gateway-payload",
        "repo/dev",
        "repo/docs-index",
        "repo/ios",
        "repo/layers",
        "repo/mac",
        "repo/profile",
        "repo/root",
        "repo/verify"
      ],
      "external": "maintainer pins and installs Node (docs/development.md)"
    },
    {
      "name": "scripts/update-model-release-dates.mjs",
      "kind": "exec",
      "external": "maintainer refreshes the Gateway's vendored model release dates (packages/gateway/src/admin/runtime-configuration.md)"
    },
    {
      "name": "scripts/verify-ci-toolchain.sh",
      "kind": "exec",
      "consumers": [
        "repo/ios",
        "repo/profile"
      ]
    }
  ],
  "uses": [
    {
      "name": "TRON_CI_TOOLS_DIR",
      "kind": "env"
    },
    {
      "name": "TRON_NODE_BIN",
      "kind": "env"
    },
    {
      "name": "nodejs.org",
      "kind": "wire",
      "why": "Node release downloads and schedule"
    }
  ]
}
