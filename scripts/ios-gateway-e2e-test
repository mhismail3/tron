#!/usr/bin/env bash
# Focused real-Gateway/iOS integration harness.
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
gateway_dir="$repo_root/packages/gateway"
ios_dir="$repo_root/packages/ios-app"
# shellcheck disable=SC1091
source "$repo_root/config/ci-toolchain.env"
export PATH="${TRON_CI_TOOLS_DIR:-$repo_root/.ci-tools}/bin:$PATH:/opt/homebrew/bin"

NODE_BIN=""
NPM_BIN=""
fixture_environment=()
build_fixture_environment() {
  fixture_environment=("PATH=$(dirname "$NODE_BIN"):/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin")
  local name
  for name in USER LOGNAME SHELL TMPDIR LANG LC_ALL LC_CTYPE TERM __CF_USER_TEXT_ENCODING; do
    if [[ -n "${!name:-}" ]]; then fixture_environment+=("$name=${!name}"); fi
  done
  return 0
}
require_gateway_node() {
  [[ -n "$NODE_BIN" ]] && return 0
  NODE_BIN="$("$repo_root/scripts/tron-node")"
  NPM_BIN="$(dirname "$NODE_BIN")/npm"
  export PATH="$(dirname "$NODE_BIN")${PATH:+:$PATH}"
  build_fixture_environment
}
identity_owner="$repo_root/scripts/ios-test-build-identity.py"
worktree_key="$(python3 "$identity_owner" worktree-key --worktree "$repo_root")" \
  || { echo "error: cannot derive this worktree's E2E fixture key" >&2; exit 1; }
run_root="${TRON_IOS_E2E_STATE_DIR:-${TMPDIR:-/tmp}/tron-ios-gateway-e2e-$UID-$worktree_key}"
derived_data="${TRON_IOS_E2E_DERIVED_DATA:-${TMPDIR:-/tmp}/tron-ios-gateway-e2e-derived-$UID-$worktree_key}"
process_owner="$repo_root/scripts/ios-test-process.py"
simulator_owner="$repo_root/scripts/ios-test-simulator.py"
lock_owner="$repo_root/scripts/ios-test-lock.py"

die() { echo "error: $*" >&2; exit 1; }

ui_owned_journeys=(
  'TronMobileUITests/RealGatewayPairAndChatUITests/testPendingAppReviewInstallLight'
  'TronMobileUITests/RealGatewayPairAndChatUITests/testPendingAppReviewInstallDark'
  'TronMobileUITests/RealGatewayPairAndChatUITests/testBuildsInstallLight'
  'TronMobileUITests/RealGatewayPairAndChatUITests/testBuildsInstallDark'
  'TronMobileUITests/RealGatewayPairAndChatUITests/testBuildsInstallLightXXXL'
  'TronMobileUITests/RealGatewayPairAndChatUITests/testBuildsInstallDarkXXXL'
  'TronMobileUITests/RealGatewayPairAndChatUITests/testCaptureAppsAndManageLight'
  'TronMobileUITests/RealGatewayPairAndChatUITests/testCaptureAppsAndManageDark'
