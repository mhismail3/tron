#!/usr/bin/env bash
# tron-version - centralized release version helper
#
# VERSION.env is the only hand-edited release identity file. Every
# platform-specific version field is a generated mirror for a tool that
# cannot read VERSION.env directly.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
VERSION_FILE="$PROJECT_DIR/VERSION.env"

failures=0

die() {
    echo "error: $*" >&2
    exit 1
}

note_failure() {
    echo "version drift: $*" >&2
    failures=$((failures + 1))
}

usage() {
    cat <<'USAGE'
Usage: tron version <command>

Commands:
  print              Print derived version fields as KEY=value lines
  check              Read-only validation of all mirrored version fields
  sync               Update mirrors from VERSION.env
  github-output      Validate a hosted release ref and write GitHub step outputs
  github-ios-output  Resolve the hosted iOS TestFlight channel, SHA, and build
  bump beta|patch|minor
                     Update VERSION.env, sync mirrors, and print the result
  test               Run shell-level version helper tests
USAGE
}

read_env_value() {
    local key="$1"
    awk -F= -v key="$key" '
        $1 == key {
            sub(/\r$/, "", $2)
            print $2
            found = 1
            exit
        }
        END { if (!found) exit 1 }
    ' "$VERSION_FILE"
}

load_version_env() {
    [ -f "$VERSION_FILE" ] || die "missing $VERSION_FILE"
    TRON_VERSION="$(read_env_value TRON_VERSION)" || die "VERSION.env missing TRON_VERSION"
    TRON_APPLE_BUILD="$(read_env_value TRON_APPLE_BUILD)" || die "VERSION.env missing TRON_APPLE_BUILD"
}

derive_version_fields() {
    load_version_env

    if [[ "$TRON_VERSION" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)(-beta\.([1-9][0-9]*))?$ ]]; then
        TRON_MAJOR="${BASH_REMATCH[1]}"
        TRON_MINOR="${BASH_REMATCH[2]}"
        TRON_PATCH="${BASH_REMATCH[3]}"
        TRON_BETA_NUMBER="${BASH_REMATCH[5]-}"
    else
        die "TRON_VERSION must be MAJOR.MINOR.PATCH or MAJOR.MINOR.PATCH-beta.N: $TRON_VERSION"
    fi
    if [[ ! "$TRON_APPLE_BUILD" =~ ^[1-9][0-9]*$ ]]; then
        die "TRON_APPLE_BUILD must be a positive integer: $TRON_APPLE_BUILD"
    fi

    TRON_APPLE_MARKETING_VERSION="${TRON_MAJOR}.${TRON_MINOR}.${TRON_PATCH}"
    if [ "$TRON_PATCH" = "0" ]; then
        TRON_DISPLAY_VERSION="v${TRON_MAJOR}.${TRON_MINOR}"
    else
        TRON_DISPLAY_VERSION="v${TRON_MAJOR}.${TRON_MINOR}.${TRON_PATCH}"
    fi
    if [ -n "$TRON_BETA_NUMBER" ]; then
        TRON_DISPLAY_VERSION="${TRON_DISPLAY_VERSION} (Beta ${TRON_BETA_NUMBER})"
    fi

    TRON_RELEASE_TAG="server-v${TRON_VERSION}"
    TRON_RELEASE_TITLE="Tron Server ${TRON_DISPLAY_VERSION}"
    TRON_ASSET_VERSION="$(asset_version "$TRON_VERSION")"
    TRON_DMG_NAME="tron-v${TRON_ASSET_VERSION}.dmg"
    if [[ "$TRON_VERSION" == *-* ]]; then
        TRON_IS_PRERELEASE="true"
    else
        TRON_IS_PRERELEASE="false"
    fi
}

asset_version() {
    local version="$1"
    printf '%s\n' "${version/-beta./-beta}"
}

print_version_fields() {
    derive_version_fields
    cat <<EOF
TRON_VERSION=$TRON_VERSION
TRON_APPLE_MARKETING_VERSION=$TRON_APPLE_MARKETING_VERSION
TRON_APPLE_BUILD=$TRON_APPLE_BUILD
TRON_DISPLAY_VERSION=$TRON_DISPLAY_VERSION
TRON_RELEASE_TAG=$TRON_RELEASE_TAG
TRON_RELEASE_TITLE=$TRON_RELEASE_TITLE
TRON_DMG_NAME=$TRON_DMG_NAME
TRON_IS_PRERELEASE=$TRON_IS_PRERELEASE
EOF
}

write_github_release_outputs() {
    check_versions
    [ -n "${GITHUB_OUTPUT:-}" ] || die "GITHUB_OUTPUT is required for github-output"

    local mode
    if [[ "${GITHUB_REF_TYPE:-}" == "tag" && "${GITHUB_REF_NAME:-}" == server-v* ]]; then
        if [ "$GITHUB_REF_NAME" != "$TRON_RELEASE_TAG" ]; then
            echo "::error::tag $GITHUB_REF_NAME does not match VERSION.env release tag $TRON_RELEASE_TAG" >&2
            return 1
        fi
        mode="tag"
    else
        mode="VERSION.env"
    fi

    if [[ -z "$TRON_VERSION" || -z "$TRON_RELEASE_TAG" || -z "$TRON_DMG_NAME" ||
          -z "$TRON_DISPLAY_VERSION" || -z "$TRON_APPLE_BUILD" ||
          -z "$TRON_APPLE_MARKETING_VERSION" || -z "$TRON_RELEASE_TITLE" ||
          -z "$TRON_IS_PRERELEASE" ]]; then
        echo "::error::could not resolve centralized version fields" >&2
        return 1
    fi

    printf '%s\n' \
        "version=$TRON_VERSION" "mode=$mode" "tag=$TRON_RELEASE_TAG" \
        "dmg_name=$TRON_DMG_NAME" "display_version=$TRON_DISPLAY_VERSION" \
        "apple_build=$TRON_APPLE_BUILD" "marketing_version=$TRON_APPLE_MARKETING_VERSION" \
        "release_title=$TRON_RELEASE_TITLE" "is_prerelease=$TRON_IS_PRERELEASE" \
        >> "$GITHUB_OUTPUT"
    echo "Resolved version=$TRON_VERSION ($TRON_DISPLAY_VERSION) / Apple build $TRON_APPLE_BUILD from $mode"
}

write_github_ios_outputs() {
    check_versions
    [ -n "${GITHUB_OUTPUT:-}" ] || die "GITHUB_OUTPUT is required for github-ios-output"

    local event_name="${GITHUB_EVENT_NAME:-}"
    local run_number="${GITHUB_RUN_NUMBER:-}"
    local channel source_sha trigger_mode dry_run

    if [[ ! "$run_number" =~ ^[1-9][0-9]*$ ]]; then
        die "GITHUB_RUN_NUMBER must be a positive integer: ${run_number:-<missing>}"
    fi

    case "$event_name" in
        workflow_run)
            [ "${TRON_UPSTREAM_WORKFLOW:-}" = "CI" ] \
                || die "automatic iOS delivery requires the CI workflow"
            [ "${TRON_UPSTREAM_EVENT:-}" = "push" ] \
                || die "automatic iOS delivery requires a CI push run"
            [ "${TRON_UPSTREAM_CONCLUSION:-}" = "success" ] \
                || die "automatic iOS delivery requires successful CI"
            [ "${TRON_UPSTREAM_BRANCH:-}" = "main" ] \
                || die "automatic iOS delivery requires the main branch"
            channel="internal"
            source_sha="${TRON_UPSTREAM_SHA:-}"
            trigger_mode="main-ci"
            ;;
        push)
            [ "${GITHUB_REF_TYPE:-}" = "tag" ] \
                || die "iOS push delivery requires a release tag"
            [ "${GITHUB_REF_NAME:-}" = "$TRON_RELEASE_TAG" ] \
                || die "tag ${GITHUB_REF_NAME:-<missing>} does not match VERSION.env release tag $TRON_RELEASE_TAG"
            channel="external"
            source_sha="${GITHUB_SHA:-}"
            trigger_mode="tag"
            ;;
        workflow_dispatch)
            channel="${TRON_IOS_CHANNEL_INPUT:-dry-run}"
            case "$channel" in
                dry-run|internal|external)
                    [ "${GITHUB_REF_TYPE:-}" = "branch" ] && [ "${GITHUB_REF_NAME:-}" = "main" ] \
                        || die "manual iOS delivery is restricted to the main branch"
                    ;;
                *) die "iOS TestFlight channel must be dry-run, internal, or external: $channel" ;;
            esac
            source_sha="${GITHUB_SHA:-}"
            trigger_mode="manual"
            ;;
        *)
            die "unsupported iOS TestFlight event: ${event_name:-<missing>}"
            ;;
    esac

    [[ "$source_sha" =~ ^[[:xdigit:]]{40}$ ]] \
        || die "iOS TestFlight source SHA must be a full 40-character commit id: ${source_sha:-<missing>}"
    if [ "$channel" = "dry-run" ]; then
        dry_run="true"
    else
        dry_run="false"
    fi

    printf '%s\n' \
        "version=$TRON_VERSION" "mode=$trigger_mode" "tag=$TRON_RELEASE_TAG" \
        "dmg_name=$TRON_DMG_NAME" "display_version=$TRON_DISPLAY_VERSION" \
        "apple_build=$run_number" "marketing_version=$TRON_APPLE_MARKETING_VERSION" \
        "release_title=$TRON_RELEASE_TITLE" "is_prerelease=$TRON_IS_PRERELEASE" \
        "channel=$channel" "dry_run=$dry_run" "source_sha=$source_sha" \
        >> "$GITHUB_OUTPUT"
    echo "Resolved iOS $channel delivery for ${source_sha:0:12} / Apple build $run_number from $trigger_mode"
}

replace_regex() {
    local file="$1"
    local pattern="$2"
    local replacement="$3"
    perl -0pi -e "s{$pattern}{$replacement}g" "$file"
}

sync_versions() {
    derive_version_fields

    replace_regex "$PROJECT_DIR/packages/agent/Cargo.toml" \
        '(?m)(^version = ")[^"]+(")' \
        "\${1}${TRON_VERSION}\${2}"
    replace_regex "$PROJECT_DIR/packages/agent/Cargo.lock" \
        '(\[\[package\]\]\nname = "tron"\nversion = ")[^"]+(")' \
        "\${1}${TRON_VERSION}\${2}"

    replace_regex "$PROJECT_DIR/packages/mac-app/project.yml" \
        '(MARKETING_VERSION: ")[^"]+(")' \
        "\${1}${TRON_APPLE_MARKETING_VERSION}\${2}"
    replace_regex "$PROJECT_DIR/packages/mac-app/project.yml" \
        '(CURRENT_PROJECT_VERSION: ")[^"]+(")' \
        "\${1}${TRON_APPLE_BUILD}\${2}"
    replace_regex "$PROJECT_DIR/packages/mac-app/project.yml" \
        '(TRON_CANONICAL_VERSION: ")[^"]+(")' \
        "\${1}${TRON_VERSION}\${2}"

    replace_regex "$PROJECT_DIR/packages/ios-app/project.yml" \
        '(MARKETING_VERSION: ")[^"]+(")' \
        "\${1}${TRON_APPLE_MARKETING_VERSION}\${2}"
    replace_regex "$PROJECT_DIR/packages/ios-app/project.yml" \
        '(CURRENT_PROJECT_VERSION: ")[^"]+(")' \
        "\${1}${TRON_APPLE_BUILD}\${2}"
    replace_regex "$PROJECT_DIR/packages/ios-app/project.yml" \
        '(TRON_CANONICAL_VERSION: ")[^"]+(")' \
        "\${1}${TRON_VERSION}\${2}"
}

value_after_key() {
    local file="$1"
    local key="$2"
    awk -v key="$key" '
        $0 ~ key {
            getline
            sub(/^.*<string>/, "")
            sub(/<\/string>.*$/, "")
            print
            exit
        }
    ' "$file"
}

check_equals() {
    local label="$1"
    local actual="$2"
    local expected="$3"
    if [ "$actual" != "$expected" ]; then
        note_failure "$label is '$actual', expected '$expected'"
    fi
}

check_grep_count() {
    local label="$1"
    local expected_count="$2"
    local pattern="$3"
    local file="$4"
    local count
    count=$(grep -Fc "$pattern" "$file" || true)
    if [ "$count" != "$expected_count" ]; then
        note_failure "$label matched $count time(s), expected $expected_count"
    fi
}

cargo_lock_tron_version() {
    awk '
        $0 == "[[package]]" { in_pkg = 1; name = ""; version = ""; next }
        in_pkg && $1 == "name" && $3 == "\"tron\"" { name = "tron"; next }
        in_pkg && $1 == "version" { gsub(/"/, "", $3); version = $3; next }
        in_pkg && $0 == "" {
            if (name == "tron") { print version; printed = 1; exit }
            in_pkg = 0
        }
        END {
            if (!printed && in_pkg && name == "tron") print version
        }
    ' "$PROJECT_DIR/packages/agent/Cargo.lock"
}

check_versions() {
    failures=0
    derive_version_fields

    local canonical_build_setting cargo_version
    # This is an Xcode build-setting token, not shell interpolation.
    # shellcheck disable=SC2016
    canonical_build_setting='$(TRON_CANONICAL_VERSION)'
    cargo_version=$(awk -F'"' '$1 == "version = " { print $2; exit }' "$PROJECT_DIR/packages/agent/Cargo.toml")
    check_equals "Cargo.toml package version" "$cargo_version" "$TRON_VERSION"
    check_equals "Cargo.lock tron package version" "$(cargo_lock_tron_version)" "$TRON_VERSION"

    check_grep_count "Mac MARKETING_VERSION" 1 "MARKETING_VERSION: \"${TRON_APPLE_MARKETING_VERSION}\"" "$PROJECT_DIR/packages/mac-app/project.yml"
    check_grep_count "Mac CURRENT_PROJECT_VERSION" 1 "CURRENT_PROJECT_VERSION: \"${TRON_APPLE_BUILD}\"" "$PROJECT_DIR/packages/mac-app/project.yml"
    check_grep_count "Mac TRON_CANONICAL_VERSION" 1 "TRON_CANONICAL_VERSION: \"${TRON_VERSION}\"" "$PROJECT_DIR/packages/mac-app/project.yml"

    check_grep_count "iOS MARKETING_VERSION" 1 "MARKETING_VERSION: \"${TRON_APPLE_MARKETING_VERSION}\"" "$PROJECT_DIR/packages/ios-app/project.yml"
    check_grep_count "iOS CURRENT_PROJECT_VERSION" 1 "CURRENT_PROJECT_VERSION: \"${TRON_APPLE_BUILD}\"" "$PROJECT_DIR/packages/ios-app/project.yml"
    check_grep_count "iOS TRON_CANONICAL_VERSION" 1 "TRON_CANONICAL_VERSION: \"${TRON_VERSION}\"" "$PROJECT_DIR/packages/ios-app/project.yml"

    if grep -Eq '^(MARKETING_VERSION|CURRENT_PROJECT_VERSION)[[:space:]]*=' "$PROJECT_DIR/packages/ios-app/Configuration/Base.xcconfig"; then
        note_failure "iOS Base.xcconfig still defines MARKETING_VERSION/CURRENT_PROJECT_VERSION"
    fi

    check_equals "iOS app Info.plist TRONCanonicalVersion" \
        "$(value_after_key "$PROJECT_DIR/packages/ios-app/Sources/Info.plist" "TRONCanonicalVersion")" \
        "$canonical_build_setting"
    check_equals "iOS share extension Info.plist TRONCanonicalVersion" \
        "$(value_after_key "$PROJECT_DIR/packages/ios-app/ShareExtension/Info.plist" "TRONCanonicalVersion")" \
        "$canonical_build_setting"
    check_equals "Mac Info.plist TRONCanonicalVersion" \
        "$(value_after_key "$PROJECT_DIR/packages/mac-app/Sources/Info.plist" "TRONCanonicalVersion")" \
        "$canonical_build_setting"

    if [ "$failures" -ne 0 ]; then
        echo "$failures version drift issue(s) found" >&2
        return 1
    fi
    echo "Version mirrors are in sync: ${TRON_VERSION} -> ${TRON_DISPLAY_VERSION}"
}

write_version_file() {
    local version="$1"
    local build="$2"
    local tmp
    tmp="$(mktemp "$PROJECT_DIR/.VERSION.env.XXXXXX")"
    {
        echo "TRON_VERSION=$version"
        echo "TRON_APPLE_BUILD=$build"
    } > "$tmp"
    mv "$tmp" "$VERSION_FILE"
}

bump_version() {
    local kind="${1:-}"
    [ -n "$kind" ] || die "bump requires beta, patch, or minor"
    derive_version_fields

    local next
    case "$kind" in
        beta)
            if [ -n "$TRON_BETA_NUMBER" ]; then
                next="${TRON_MAJOR}.${TRON_MINOR}.${TRON_PATCH}-beta.$((TRON_BETA_NUMBER + 1))"
            else
                next="${TRON_MAJOR}.${TRON_MINOR}.${TRON_PATCH}-beta.1"
            fi
            ;;
        patch)
            next="${TRON_MAJOR}.${TRON_MINOR}.$((TRON_PATCH + 1))"
            ;;
        minor)
            next="${TRON_MAJOR}.$((TRON_MINOR + 1)).0"
            ;;
        *)
            die "unknown bump kind: $kind"
            ;;
    esac

    write_version_file "$next" "$((TRON_APPLE_BUILD + 1))"
    sync_versions
    print_version_fields
}

self_test() {
    derive_version_fields
    local out
    out="$("$PROJECT_DIR/scripts/tron" version print)"
    grep -Fqx "TRON_VERSION=$TRON_VERSION" <<<"$out" || die "print omitted canonical version"
    grep -Fqx "TRON_APPLE_MARKETING_VERSION=$TRON_APPLE_MARKETING_VERSION" <<<"$out" || die "print omitted Apple marketing version"
    grep -Fqx "TRON_DISPLAY_VERSION=$TRON_DISPLAY_VERSION" <<<"$out" || die "print omitted display version"
    grep -Fqx "TRON_RELEASE_TAG=$TRON_RELEASE_TAG" <<<"$out" || die "print omitted server release tag"
    grep -Fqx "TRON_RELEASE_TITLE=$TRON_RELEASE_TITLE" <<<"$out" || die "print omitted server release title"
    grep -Fqx "TRON_DMG_NAME=$TRON_DMG_NAME" <<<"$out" || die "print omitted platform DMG name"
    [ "$(asset_version 0.1.0-beta.3)" = "0.1.0-beta3" ] || die "asset version failed beta dot compaction"
    [ "$(asset_version 0.1.0-beta.10)" = "0.1.0-beta10" ] || die "asset version failed numeric beta compaction"
    [ "$(asset_version 0.1.1)" = "0.1.1" ] || die "asset version changed stable patch"
    [[ "$TRON_DMG_NAME" =~ ^tron-v[0-9]+\.[0-9]+\.[0-9]+(-beta[1-9][0-9]*)?\.dmg$ ]] || die "DMG name has unexpected format: $TRON_DMG_NAME"
    "$PROJECT_DIR/scripts/tron" version check >/dev/null
    ! "$PROJECT_DIR/scripts/tron" version sync --check >/dev/null 2>&1 || die "sync --check alias remains accepted"

    local github_output output_keys
    github_output="$(mktemp)"
    for ref_type in branch tag; do
        : > "$github_output"
        GITHUB_OUTPUT="$github_output" GITHUB_REF_TYPE="$ref_type" \
            GITHUB_REF_NAME="$([ "$ref_type" = tag ] && echo "$TRON_RELEASE_TAG" || echo main)" \
            "$PROJECT_DIR/scripts/tron" version github-output >/dev/null
        grep -Fqx "mode=$([ "$ref_type" = tag ] && echo tag || echo VERSION.env)" "$github_output" \
            || die "github-output omitted $ref_type mode"
    done
    output_keys="$(cut -d= -f1 "$github_output" | paste -sd, -)"
    [ "$output_keys" = "version,mode,tag,dmg_name,display_version,apple_build,marketing_version,release_title,is_prerelease" ] \
        || die "github-output keys changed: $output_keys"

    : > "$github_output"
    if GITHUB_OUTPUT="$github_output" \
        GITHUB_REF_TYPE="tag" \
        GITHUB_REF_NAME="${TRON_RELEASE_TAG}-mismatch" \
        "$PROJECT_DIR/scripts/tron" version github-output >/dev/null 2>&1; then
        die "github-output accepted a mismatched release tag"
    fi
    [ ! -s "$github_output" ] || die "github-output wrote fields for a mismatched release tag"

    local test_sha="0123456789abcdef0123456789abcdef01234567"
    : > "$github_output"
    GITHUB_OUTPUT="$github_output" GITHUB_EVENT_NAME="workflow_run" GITHUB_RUN_NUMBER="27" \
        TRON_UPSTREAM_WORKFLOW="CI" TRON_UPSTREAM_EVENT="push" \
        TRON_UPSTREAM_CONCLUSION="success" TRON_UPSTREAM_BRANCH="main" \
        TRON_UPSTREAM_SHA="$test_sha" \
        "$PROJECT_DIR/scripts/tron" version github-ios-output >/dev/null
    for expected in \
        "mode=main-ci" "apple_build=27" "channel=internal" "dry_run=false" \
        "source_sha=$test_sha"; do
        grep -Fqx "$expected" "$github_output" || die "github-ios-output omitted $expected"
    done

    : > "$github_output"
    GITHUB_OUTPUT="$github_output" GITHUB_EVENT_NAME="push" GITHUB_RUN_NUMBER="28" \
        GITHUB_REF_TYPE="tag" GITHUB_REF_NAME="$TRON_RELEASE_TAG" GITHUB_SHA="$test_sha" \
        "$PROJECT_DIR/scripts/tron" version github-ios-output >/dev/null
    for expected in "mode=tag" "apple_build=28" "channel=external" "dry_run=false"; do
        grep -Fqx "$expected" "$github_output" || die "github-ios-output omitted $expected"
    done

    : > "$github_output"
    GITHUB_OUTPUT="$github_output" GITHUB_EVENT_NAME="workflow_dispatch" GITHUB_RUN_NUMBER="29" \
        GITHUB_REF_TYPE="branch" GITHUB_REF_NAME="main" GITHUB_SHA="$test_sha" \
        TRON_IOS_CHANNEL_INPUT="dry-run" \
        "$PROJECT_DIR/scripts/tron" version github-ios-output >/dev/null
    for expected in "mode=manual" "channel=dry-run" "dry_run=true"; do
        grep -Fqx "$expected" "$github_output" || die "github-ios-output omitted $expected"
    done

    : > "$github_output"
    if GITHUB_OUTPUT="$github_output" GITHUB_EVENT_NAME="workflow_run" GITHUB_RUN_NUMBER="30" \
        TRON_UPSTREAM_WORKFLOW="CI" TRON_UPSTREAM_EVENT="pull_request" \
        TRON_UPSTREAM_CONCLUSION="success" TRON_UPSTREAM_BRANCH="main" \
        TRON_UPSTREAM_SHA="$test_sha" \
        "$PROJECT_DIR/scripts/tron" version github-ios-output >/dev/null 2>&1; then
        die "github-ios-output accepted pull-request CI for automatic delivery"
    fi
    [ ! -s "$github_output" ] || die "github-ios-output wrote fields for rejected CI"

    : > "$github_output"
    if GITHUB_OUTPUT="$github_output" GITHUB_EVENT_NAME="workflow_dispatch" GITHUB_RUN_NUMBER="31" \
        GITHUB_REF_TYPE="branch" GITHUB_REF_NAME="feature" GITHUB_SHA="$test_sha" \
        TRON_IOS_CHANNEL_INPUT="internal" \
        "$PROJECT_DIR/scripts/tron" version github-ios-output >/dev/null 2>&1; then
        die "github-ios-output accepted live manual delivery outside main"
    fi
    [ ! -s "$github_output" ] || die "github-ios-output wrote fields for rejected manual delivery"

    : > "$github_output"
    if GITHUB_OUTPUT="$github_output" GITHUB_EVENT_NAME="workflow_dispatch" GITHUB_RUN_NUMBER="32" \
        GITHUB_REF_TYPE="branch" GITHUB_REF_NAME="feature" GITHUB_SHA="$test_sha" \
        TRON_IOS_CHANNEL_INPUT="dry-run" \
        "$PROJECT_DIR/scripts/tron" version github-ios-output >/dev/null 2>&1; then
        die "github-ios-output accepted manual dry-run outside main"
    fi
    [ ! -s "$github_output" ] || die "github-ios-output wrote fields for rejected dry-run"
    rm -f "$github_output"

    local invalid
    for invalid in 0.1 0.1-b1 v0.1.b1 0.1.0.0 0.1.0-beta.x 0.1.0-beta.0; do
        TRON_VERSION="$invalid"
        if [[ "$TRON_VERSION" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)(-beta\.([1-9][0-9]*))?$ ]]; then
            die "invalid version unexpectedly accepted by test regex: $invalid"
        fi
    done

    echo "Version helper tests passed"
}

cmd="${1:-}"
case "$cmd" in
    print)
        print_version_fields
        ;;
    check)
        check_versions
        ;;
    github-output)
        write_github_release_outputs
        ;;
    github-ios-output)
        write_github_ios_outputs
        ;;
    sync)
        [ "$#" -eq 1 ] || die "sync accepts no arguments; use 'tron version check' for read-only validation"
        sync_versions
        check_versions
        ;;
    bump)
        shift
        bump_version "$@"
        ;;
    test)
        self_test
        ;;
    ""|-h|--help|help)
        usage
        ;;
    *)
        die "unknown version command: $cmd"
        ;;
esac
