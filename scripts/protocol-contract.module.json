{
  "layer": "L5",
  "purpose": "The one Gateway protocol contract check the Gateway payload, Mac and iOS builds run before they ship together.",
  "owns": [
    "gateway_protocol_contract.py",
    "protocol-contract.module.json",
    "verify-gateway-protocol-contract.py"
  ],
  "verify": [
    "scripts/tron test tooling scripts/verify-gateway-protocol-contract.py"
  ],
  "interfaces": [
    {
      "name": "scripts/gateway_protocol_contract.py",
      "kind": "import",
      "consumers": [
        "mac-app/gateway-payload",
        "repo/dev",
        "repo/ios"
      ]
    },
    {
      "name": "scripts/verify-gateway-protocol-contract.py",
      "kind": "exec",
      "consumers": [
        "ios-app/package",
        "mac-app/gateway-payload",
        "mac-app/package",
        "repo/dev",
        "repo/ios",
        "repo/mac"
      ]
    }
  ]
}
