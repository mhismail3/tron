#!/usr/bin/env bash
# Reuse one local iPhone simulator and preserve the paired Development app container.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IOS_DIR="$ROOT_DIR/packages/ios-app"
STATE_DIR="${TRON_IOS_SIMULATOR_STATE_DIR:-$HOME/.tron/internal/run}"
STATE_FILE="$STATE_DIR/ios-simulator-udid"
SIMULATOR_ID="${TRON_IOS_SIMULATOR_ID:-}"
DERIVED_DATA="${TRON_IOS_SIMULATOR_DERIVED_DATA:-/tmp/tron-ios-development-derived}"
BUNDLE_ID="com.tron.mobile.beta"

usage() {
    cat <<'USAGE'
Usage:
  scripts/tron-ios-simulator start
  scripts/tron-ios-simulator install
  scripts/tron-ios-simulator status
  scripts/tron-ios-simulator stop
  scripts/tron-ios-simulator remember [SIMULATOR_ID]

Commands:
  start      Boot the remembered simulator and launch its verified Tron Development app.
  install    Build/install Tron Development without erasing its paired app container.
  status     Show the remembered simulator and validate its installed Tron Development app.
  stop       Terminate Development and shut down only the remembered simulator.
  remember   Save an explicit simulator ID, or the Simulator app's current device.

Environment overrides:
  TRON_IOS_SIMULATOR_ID            Explicit simulator UUID to use and remember
  TRON_IOS_SIMULATOR_STATE_DIR     Local state directory
  TRON_IOS_SIMULATOR_DERIVED_DATA  Stable DerivedData path

This helper intentionally uses the Development bundle ID and never uninstalls,
erases, or runs tests. Pairing is stored in that bundle's data container on the
remembered simulator, so an unavailable remembered UUID fails closed instead of
selecting another device. Use scripts/tron-ios-test for all hosted unit tests.
USAGE
}

die() {
    echo "error: $*" >&2
    exit 1
}

available_device_line() {
    local simulator_id="$1"
    xcrun simctl list devices available | grep -F "$simulator_id" | head -1
}

current_simulator_id() {
    defaults read com.apple.iphonesimulator CurrentDeviceUDID 2>/dev/null || true
}

remember_simulator_id() {
    local simulator_id="$1"
    [ -n "$(available_device_line "$simulator_id")" ] \
        || die "simulator is unavailable: $simulator_id"
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$simulator_id" > "$STATE_FILE"
}

resolve_simulator_id() {
    local candidate=""

    if [ -n "$SIMULATOR_ID" ]; then
        candidate="$SIMULATOR_ID"
    elif [ -s "$STATE_FILE" ]; then
        candidate="$(head -1 "$STATE_FILE")"
    else
        die "no Development simulator is remembered; select one in Simulator and run '$0 remember'"
    fi

    [ -n "$(available_device_line "$candidate")" ] \
        || die "remembered Development simulator is unavailable: $candidate (choose a replacement explicitly with '$0 remember SIMULATOR_ID')"
    remember_simulator_id "$candidate"
    printf '%s\n' "$candidate"
}

boot_simulator() {
    local simulator_id="$1"
    local line
    line="$(available_device_line "$simulator_id")"
    if [[ "$line" != *"(Booted)"* ]]; then
        xcrun simctl boot "$simulator_id"
    fi
    open -a Simulator --args -CurrentDeviceUDID "$simulator_id"
    xcrun simctl bootstatus "$simulator_id" -b
}

launch_development() {
    local simulator_id="$1"
    local installed_identifier
    installed_identifier="$(installed_development_code_identifier "$simulator_id" || true)"

    [ "$installed_identifier" = "$BUNDLE_ID" ] \
        || die "installed Tron Development artifact has code identifier '${installed_identifier:-missing}' (an XCTest host may have replaced it); run scripts/tron-ios-simulator install"

    xcrun simctl launch "$simulator_id" "$BUNDLE_ID" >/dev/null \
        || die "Tron Development is not installed; run scripts/tron-ios-simulator install"
}

installed_development_code_identifier() {
    local simulator_id="$1"
    local app
    app="$(xcrun simctl get_app_container "$simulator_id" "$BUNDLE_ID" app 2>/dev/null)" \
        || return 1
    codesign -dvv "$app" 2>&1 \
        | awk -F= '/^Identifier=/{ print $2; exit }'
}

install_development() {
    local simulator_id="$1"
    boot_simulator "$simulator_id"
    (
        cd "$IOS_DIR"
        "$ROOT_DIR/scripts/generate-xcode-project" ios
        xcodebuild build \
            -project TronMobile.xcodeproj \
            -scheme "Tron Development" \
            -configuration Development \
            -destination "platform=iOS Simulator,id=$simulator_id" \
            -derivedDataPath "$DERIVED_DATA"
    )

    local app="$DERIVED_DATA/Build/Products/Development-iphonesimulator/TronMobile.app"
    [ -d "$app" ] || die "expected simulator app not found: $app"
    xcrun simctl terminate "$simulator_id" "$BUNDLE_ID" 2>/dev/null || true
    xcrun simctl install "$simulator_id" "$app"
    launch_development "$simulator_id"
}

stop_development() {
    local simulator_id="$1" line
    line="$(available_device_line "$simulator_id")"
    xcrun simctl terminate "$simulator_id" "$BUNDLE_ID" 2>/dev/null || true
    if [[ "$line" == *"(Booted)"* ]]; then
        xcrun simctl shutdown "$simulator_id"
    fi
}

show_status() {
    local simulator_id="$1"
    local device_line
    local installed_identifier
    device_line="$(available_device_line "$simulator_id")"
    echo "Remembered simulator: $device_line"
    echo "State file: $STATE_FILE"
    if [[ "$device_line" != *"(Booted)"* ]]; then
        echo "Tron Development: validation unavailable while simulator is not booted (run start)"
        return
    fi
    if xcrun simctl get_app_container "$simulator_id" "$BUNDLE_ID" data >/dev/null 2>&1; then
        installed_identifier="$(installed_development_code_identifier "$simulator_id" || true)"
        if [ "$installed_identifier" = "$BUNDLE_ID" ]; then
            echo "Tron Development: installed and verified (pairing container preserved)"
        else
            echo "Tron Development: invalid installed artifact (${installed_identifier:-missing}; pairing container preserved — run install)"
        fi
    else
        echo "Tron Development: not installed"
    fi
}

command="${1:-start}"
case "$command" in
    start)
        simulator_id="$(resolve_simulator_id)"
        boot_simulator "$simulator_id"
        launch_development "$simulator_id"
        ;;
    install)
        simulator_id="$(resolve_simulator_id)"
        install_development "$simulator_id"
        ;;
    status)
        simulator_id="$(resolve_simulator_id)"
        show_status "$simulator_id"
        ;;
    stop)
        simulator_id="$(resolve_simulator_id)"
        stop_development "$simulator_id"
        ;;
    remember)
        simulator_id="${2:-$(current_simulator_id)}"
        [ -n "$simulator_id" ] || die "pass a simulator ID or select one in Simulator first"
        remember_simulator_id "$simulator_id"
        show_status "$simulator_id"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        die "unknown command: $command"
        ;;
esac
