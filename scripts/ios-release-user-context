#!/bin/bash
set -euo pipefail

# Run a release command only when the listener already belongs to the isolated
# account's own launchd bootstrap and audit session. Keychain and CodeSign need
# that per-user context so they can reach the account's secd and trustd
# services. This boundary deliberately refuses to cross from another launchd
# domain: `launchctl asuser` cannot repair a listener that was installed in the
# privileged system domain, and attempting that transition can retain a mixed
# Unix/audit identity.

die() {
    echo "::error::$*" >&2
    exit 1
}

notice() {
    local details="$1" timestamp
    timestamp="$(/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')"
    details="${details//$'\r'/ }"
    details="${details//$'\n'/ }"
    echo "::notice::timestamp=$timestamp component=ios-release-user-context event=context_verified $details" >&2
}

[[ "$(/usr/bin/uname -s)" == "Darwin" ]] \
    || die "the iOS release user-context boundary requires macOS"
(( $# > 0 )) || die "usage: scripts/ios-release-user-context command [args...]"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
session_verifier="$script_dir/ios-release-verify.py"
[[ -f "$session_verifier" ]] \
    || die "the iOS release security-session verifier is unavailable"
release_uid="$(/usr/bin/id -u)"
release_user="$(/usr/bin/id -un)"
[[ "$release_uid" =~ ^[0-9]+$ && "$release_uid" -ge 500 ]] \
    || die "the iOS release user-context boundary requires a standard account"
[[ "$release_user" != "root" ]] \
    || die "the iOS release user-context boundary refuses root"

manager_uid="$(/bin/launchctl manageruid 2>/dev/null || true)"
manager_name="$(/bin/launchctl managername 2>/dev/null || true)"
[[ "$manager_uid" == "$release_uid" ]] \
    || die "the current launchd domain does not match the release account: expected_uid=$release_uid observed_uid=${manager_uid:-unavailable}"
case "$manager_name" in
    Aqua | Background) ;;
    *) die "the current user launchd context has an unsupported session type: observed=${manager_name:-unavailable}" ;;
esac
if ! security_session="$(
    /usr/bin/python3 "$session_verifier" \
        security-session \
        --require-non-root \
        --require-audit-uid "$release_uid"
)"; then
    die "the current user launchd context has a mixed audit identity: ${security_session:-verifier unavailable}"
fi
notice \
    "effective_uid=$release_uid manager_uid=$manager_uid manager_name=$manager_name security_session=$security_session"

exec "$@"
