#!/usr/bin/env bash

set -euo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=tron-ios-device
source "$root_dir/scripts/tron-ios-device"

sample_processes=$'PID   Executable Path\n31188   /private/var/containers/Bundle/Application/ABC/TronMobile.app/TronMobile   \n42      /usr/libexec/example'
actual="$(printf '%s\n' "$sample_processes" | tronmobile_pids_from_input)"

if [[ "$actual" != "31188" ]]; then
    printf 'expected padded TronMobile process row to yield PID 31188, got %q\n' "$actual" >&2
    exit 1
fi

unset TRON_IOS_SCHEME TRON_IOS_CONFIGURATION
# shellcheck disable=SC1090
source "$root_dir/scripts/tron-ios-device"
[[ "$SCHEME" == "Tron Device" && "$CONFIG" == "LocalDevice" ]] || {
    echo "device helper defaults are not the canonical install pair" >&2
    exit 1
}
[[ "$GATEWAY_PROTOCOL_TARGET" == "stable" && "$GATEWAY_MAC_APP" == "/Applications/Tron.app" ]] || {
    echo "device helper does not default to Stable protocol verification" >&2
    exit 1
}
GATEWAY_PROTOCOL_TARGET=source
validate_gateway_protocol_target_prebuild >/dev/null
GATEWAY_PROTOCOL_TARGET=stable
tool_fixture="$(mktemp -d "${TMPDIR:-/tmp}/tron-ios-device-tool.XXXXXX")"
trap 'rm -rf "$tool_fixture"' EXIT
cat > "$tool_fixture/xcodegen" <<EOF
#!/usr/bin/env bash
printf 'Version: %s\\n' '$TRON_CI_XCODEGEN_VERSION'
EOF
chmod 0755 "$tool_fixture/xcodegen"
[[ "$(TRON_XCODEGEN="$tool_fixture/xcodegen" xcodegen_command)" == "$(realpath "$tool_fixture/xcodegen")" ]] || {
    echo "explicit pinned XcodeGen was not resolved exactly" >&2
    exit 1
}
cat > "$tool_fixture/wrong-xcodegen" <<'EOF'
#!/usr/bin/env bash
printf 'Version: 0.0.0\n'
EOF
chmod 0755 "$tool_fixture/wrong-xcodegen"
if (TRON_XCODEGEN="$tool_fixture/wrong-xcodegen" xcodegen_command) >/dev/null 2>&1; then
    echo "wrong XcodeGen version was accepted" >&2
    exit 1
fi
[[ "$PHYSICAL_BUNDLE_ID" == "com.tron.mobile" ]] || {
    echo "device helper launch identity is not canonical" >&2
    exit 1
}
SCHEME="Tron Fast" CONFIG="ProdDebug" validate_install_pair >/dev/null 2>&1
[[ "$SCHEME" == "Tron Device" && "$CONFIG" == "LocalDevice" ]] || {
    echo "legacy safe pair did not map to canonical pair" >&2
    exit 1
}
set +e
TRON_IOS_SCHEME=Tron TRON_IOS_CONFIGURATION=Prod scripts/tron-ios-device install --no-launch >/tmp/tron-ios-device-reject.$$ 2>&1
rejected=$?
set -e
grep -Fq "use Tron Device + LocalDevice" /tmp/tron-ios-device-reject.$$ || {
    cat /tmp/tron-ios-device-reject.$$ >&2
    rm -f /tmp/tron-ios-device-reject.$$
    exit 1
}
rm -f /tmp/tron-ios-device-reject.$$
[[ "$rejected" -ne 0 ]] || { echo "unsafe legacy pair was accepted" >&2; exit 1; }
cat > "$tool_fixture/xcodebuild" <<'EOF'
#!/usr/bin/env bash
: > "$CAPTURE"
for argument in "$@"; do
    printf '%s\n' "$argument" >> "$CAPTURE"
done
EOF
chmod 0755 "$tool_fixture/xcodebuild"

capture_xcodebuild_args() {
    local mode="$1"
    local derived_data="$2"
    local result_bundle="$3"
    local device_id="$4"
    local capture="$5"
    prepare_xcodebuild_args "$derived_data" "$result_bundle" "$device_id" "$mode"
    CAPTURE="$capture" PATH="$tool_fixture:$PATH" xcodebuild "${XCODEBUILD_ARGS[@]}"
}

optimized_capture="$tool_fixture/optimized-args"
capture_xcodebuild_args optimized \
    'build/Derived Data' '/tmp/optimized result.xcresult' 'device with spaces' "$optimized_capture"
cat > "$tool_fixture/optimized-expected" <<'EOF'
build
-project
TronMobile.xcodeproj
-scheme
Tron Device
-configuration
LocalDevice
-destination
platform=iOS,id=device with spaces
-destination-timeout
30
-derivedDataPath
build/Derived Data
-resultBundlePath
/tmp/optimized result.xcresult
-allowProvisioningUpdates
-allowProvisioningDeviceRegistration
SWIFT_COMPILATION_MODE=singlefile
EOF
cmp -s "$optimized_capture" "$tool_fixture/optimized-expected" || {
    echo "optimized xcodebuild argv changed unexpectedly" >&2
    diff -u "$tool_fixture/optimized-expected" "$optimized_capture" >&2 || true
    exit 1
}

fast_capture="$tool_fixture/fast-args"
capture_xcodebuild_args fast-debug \
    'build/DerivedData-fast-debug' '/tmp/fast result.xcresult' 'device with spaces' "$fast_capture"
cat > "$tool_fixture/fast-expected" <<'EOF'
build
-project
TronMobile.xcodeproj
-scheme
Tron Device
-configuration
LocalDevice
-destination
platform=iOS,id=device with spaces
-destination-timeout
30
-derivedDataPath
build/DerivedData-fast-debug
-resultBundlePath
/tmp/fast result.xcresult
-allowProvisioningUpdates
-allowProvisioningDeviceRegistration
SWIFT_COMPILATION_MODE=singlefile
SWIFT_OPTIMIZATION_LEVEL=-Onone
GCC_OPTIMIZATION_LEVEL=0
DEBUG_INFORMATION_FORMAT=dwarf
ONLY_ACTIVE_ARCH=YES
MTL_ENABLE_DEBUG_INFO=INCLUDE_SOURCE
EOF
cmp -s "$fast_capture" "$tool_fixture/fast-expected" || {
    echo "fast-debug xcodebuild argv is missing expected overrides" >&2
    diff -u "$tool_fixture/fast-expected" "$fast_capture" >&2 || true
    exit 1
}

printf 'tron-ios-device defaults, rejection, process parsing, and build argv tests passed\n'
