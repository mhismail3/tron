{
  "labels": [
    {
      "name": "epic",
      "color": "5319e7",
      "description": "Parent issue for a multi-task effort; holds goal, constraints and decisions"
    },
    {
      "name": "kind:bug",
      "color": "d1242f",
      "description": "Kind (exactly one per task): behavior is wrong, including a failing or flaky test"
    },
    {
      "name": "kind:improvement",
      "color": "1f883d",
      "description": "Kind (exactly one per task): a committed feature, enhancement or UX change"
    },
    {
      "name": "kind:maintenance",
      "color": "8c959f",
      "description": "Kind (exactly one per task): no behavior change; cleanup, refactor, tests, tooling, docs, deps"
    },
    {
      "name": "kind:idea",
      "color": "f9c513",
      "description": "Kind (exactly one per task): a forward-looking proposal, not yet committed or scoped"
    },
    {
      "name": "kind:exploration",
      "color": "1b7c83",
      "description": "Kind (exactly one per task): an open question to investigate; delivers findings or new issues"
    },
    {
      "name": "area:gateway",
      "color": "bfd4f2",
      "description": "packages/gateway"
    },
    {
      "name": "area:ios",
      "color": "bfd4f2",
      "description": "packages/ios-app"
    },
    {
      "name": "area:mac",
      "color": "bfd4f2",
      "description": "packages/mac-app"
    },
    {
      "name": "area:relay",
      "color": "bfd4f2",
      "description": "packages/push-relay"
    },
    {
      "name": "area:tooling",
      "color": "bfd4f2",
      "description": "scripts, tools, CI and agent guidance"
    },
    {
      "name": "area:docs",
      "color": "bfd4f2",
      "description": "Documentation only"
    }
  ],
  "project": {
    "title": "Tron",
    "shortDescription": "Epics, tasks and their status for every agent working on Tron",
    "public": false,
    "fields": [
      {
        "name": "Status",
        "type": "single_select",
        "options": [
          {
            "name": "Ready",
            "color": "BLUE",
            "description": "Open and unclaimed; any agent may claim it"
          },
          {
            "name": "In progress",
            "color": "YELLOW",
            "description": "Claimed; has a branch and worktree"
          },
          {
            "name": "Blocked",
            "color": "RED",
            "description": "Cannot proceed; the reason is in the latest comment"
          },
          {
            "name": "Done",
            "color": "GREEN",
            "description": "Landed and closed"
          }
        ]
      },
      {
        "name": "Priority",
        "type": "single_select",
        "options": [
          {
            "name": "P0",
            "color": "RED",
            "description": "Drop everything"
          },
          {
            "name": "P1",
            "color": "ORANGE",
            "description": "Next"
          },
          {
            "name": "P2",
            "color": "YELLOW",
            "description": "Normal"
          },
          {
            "name": "P3",
            "color": "GRAY",
            "description": "Someday"
          }
        ]
      }
    ]
  },
  "rulesets": [
    ".github/rulesets/main.json"
  ],
  "claim": {
    "remote": "origin",
    "baseBranch": "main",
    "worktreeRoot": "../tron-worktrees",
    "readyStatus": "Ready",
    "claimedStatus": "In progress",
    "claimedStatuses": [
      "In progress"
    ],
    "activeStatuses": [
      "In progress"
    ],
    "statusField": "Status",
    "excludeLabels": [
      "epic"
    ],
    "softCap": 6,
    "branchTypes": [
      {
        "label": "kind:bug",
        "type": "fix"
      },
      {
        "label": "kind:maintenance",
        "type": "chore"
      },
      {
        "label": "area:docs",
        "type": "docs"
      }
    ],
    "defaultBranchType": "feat"
  },
  "verify": {
    "prelude": "TRON_NODE=\"$(scripts/tron-node)\"; export PATH=\"${TRON_NODE%/*}:$PATH\" PYTHONDONTWRITEBYTECODE=1",
    "scrubCommand": "scripts/personal-info-guard.sh --stdin"
  },
  "land": {
    "doneStatus": "Done"
  },
  "cleanup": {
    "regenerableIgnored": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.build/**",
      "**/DerivedData/**",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/.pytest_cache/**",
      "**/*.tsbuildinfo",
      "**/test-results/**",
      "**/.DS_Store",
      ".ci-tools/**",
      "packages/ios-app/TronMobile.xcodeproj/**",
      "packages/mac-app/TronMac.xcodeproj/**",
      "packages/mac-app/Sources/Resources/Gateway/**",
      "packages/mac-app/Sources/Resources/Library/LoginItems/Tron Agent.app/Contents/MacOS/tron",
      "packages/mac-app/Sources/Resources/Library/LoginItems/Tron Agent.app/Contents/Resources/AppIcon.icns"
    ],
    "releaseCommands": [
      {
        "name": "ios-gateway-e2e",
        "command": "scripts/ios-gateway-e2e-test clean",
        "timeoutSeconds": 300
      },
      {
        "name": "ios-test",
        "command": "scripts/tron-ios-test clean",
        "timeoutSeconds": 300
      }
    ]
  },
  "dashboard": {
    "blockedStatus": "Blocked",
    "epicLabel": "epic",
    "priorityField": "Priority",
    "kindPrefix": "kind:",
    "areaPrefix": "area:",
    "ideaLabel": "kind:idea",
    "recentDays": 14,
    "ciWorkflow": "ci.yml",
    "ciJobs": [
      "gateway",
      "push-relay",
      "ios",
      "mac"
    ],
    "pausedEpicDays": 14
  }
}
