{
  "version": 1,
  "about": "The gate step catalog: the one source of truth for every verification step (tools/work/README.md#gate). Plan order is catalog order. Budgets and RSS come from measurements recorded on #1022; `scripts/tron gate report` prints the current ones. `hosted` says whether a step can run on hosted CI (`safe`) or needs this Mac (`local-only: reason`).",
  "ciSteps": ["repo.policy", "relay.check", "gateway.build", "gateway.integration"],
  "codeExclude": [
    "**/*.md"
  ],
  "steps": [
    {
      "id": "repo.privacy",
      "tier": "L0",
      "summary": "Personal-data guard over the tree",
      "trigger": {
        "always": true
      },
      "command": "scripts/personal-info-guard.sh",
      "inputs": [
        "."
      ],
      "budgetSeconds": 20,
      "timeoutSeconds": 120,
      "class": "light",
      "expectedRssMb": 1400,
      "pass": "exit 0",
      "unlocks": "builds",
      "hosted": "safe"
    },
    {
      "id": "repo.whitespace",
      "tier": "L0",
      "summary": "git diff --check against the merge base",
      "trigger": {
        "always": true
      },
      "command": "git diff --check {merge_base}",
      "inputs": [
        "."
      ],
      "budgetSeconds": 10,
      "timeoutSeconds": 60,
      "class": "light",
      "expectedRssMb": 50,
      "pass": "exit 0",
      "unlocks": "builds",
      "hosted": "safe"
    },
    {
      "id": "repo.syntax",
      "tier": "L0",
      "summary": "Syntax of changed scripts: ast for Python, node --check, bash -n",
      "trigger": {
        "select": "script-syntax"
      },
      "command": "{select}",
      "inputs": [
        "scripts",
        "tools",
        "packages/*/scripts"
      ],
      "budgetSeconds": 20,
      "timeoutSeconds": 120,
      "class": "light",
      "expectedRssMb": 100,
      "pass": "exit 0",
      "unlocks": "builds",
      "hosted": "safe"
    },
    {
      "id": "repo.agent-policy",
      "tier": "L0",
      "summary": "Skill catalog and agent guidance policy",
      "trigger": {
        "paths": [
          "AGENTS.md",
          "CONTRIBUTING.md",
          ".agents/**",
          "scripts/check-agent-policy.sh",
          ".pi/prompts/**"
        ]
      },
      "command": "scripts/check-agent-policy.sh",
      "inputs": [
        "AGENTS.md",
        "CONTRIBUTING.md",
        ".agents",
        "scripts/check-agent-policy.sh",
        ".pi/prompts"
      ],
      "budgetSeconds": 20,
      "timeoutSeconds": 120,
      "class": "light",
      "expectedRssMb": 100,
      "pass": "exit 0",
      "unlocks": "builds",
      "hosted": "safe"
    },
    {
      "id": "tooling.tests",
      "tier": "L1",
      "summary": "Real-process journeys of the work and gate tooling and the changed script suites, one shard per suite",
      "trigger": {
        "select": "tooling-tests"
      },
      "command": "{select}",
      "inputs": [
        "tools",
        "scripts",
        ".github/work.json",
        ".node-version"
      ],
      "budgetSeconds": 120,
      "timeoutSeconds": 300,
      "class": "light",
      "expectedRssMb": 400,
      "pass": "exit 0 for every suite shard",
      "unlocks": "builds",
      "hosted": "safe"
    },
    {
      "id": "protocol.contract",
      "tier": "L2",
      "summary": "Gateway protocol contract shared by Gateway, iOS and Mac",
      "trigger": {
        "paths": [
          "config/GatewayProtocol.json",
          "scripts/gateway_protocol_contract.py",
          "scripts/verify-gateway-protocol-contract.py"
        ]
      },
      "command": "python3 scripts/verify-gateway-protocol-contract.py",
      "inputs": [
        "config/GatewayProtocol.json",
        "scripts/gateway_protocol_contract.py",
        "scripts/verify-gateway-protocol-contract.py",
        "packages/gateway/src",
        "packages/ios-app",
        "packages/mac-app"
      ],
      "budgetSeconds": 30,
      "timeoutSeconds": 120,
      "class": "light",
      "expectedRssMb": 200,
      "pass": "exit 0",
      "unlocks": "builds",
      "hosted": "safe"
    },
    {
      "id": "repo.policy",
      "tier": "L0",
      "summary": "Hosted repository policy; common checks are prerequisite catalog steps",
      "trigger": {},
      "after": [
        "repo.privacy",
        "repo.agent-policy",
        "protocol.contract"
      ],
      "command": "scripts/tron version check && python3 scripts/check-documentation-policy.py",
      "inputs": [
        "."
      ],
      "budgetSeconds": 30,
      "timeoutSeconds": 120,
      "class": "light",
      "expectedRssMb": 200,
      "pass": "exit 0",
      "unlocks": "hosted",
      "hosted": "safe"
    },
    {
      "id": "mac.build",
      "tier": "L0",
      "summary": "XcodeGen and Debug build-for-testing of TronMac (stages the Gateway payload, which rewrites packages/gateway/node_modules, so it runs before every Gateway step)",
      "trigger": {
        "paths": [
          "packages/mac-app/**",
          "config/GatewayProtocol.json"
        ],
        "code": true
      },
      "command": "scripts/tron mac generate && cd packages/mac-app && xcodebuild build-for-testing -quiet -project TronMac.xcodeproj -scheme TronMac -configuration Debug -destination 'platform=macOS,arch=arm64' -derivedDataPath build/DerivedData ${TRON_HEAVY_CORES:+-jobs $TRON_HEAVY_CORES}",
      "inputs": [
        "packages/mac-app",
        "packages/gateway/package-lock.json",
        "config",
        ".node-version"
      ],
      "keyExtra": [
        "xcode"
      ],
      "cacheScope": "worktree",
      "budgetSeconds": 300,
      "timeoutSeconds": 900,
      "class": "heavy",
      "expectedRssMb": 3000,
      "expectedCores": 6,
      "coresMin": 2,
      "pool": "xcode",
      "artifacts": [
        "packages/mac-app/build/DerivedData/Build/Products"
      ],
      "pass": "exit 0",
      "unlocks": "mac.test",
      "memorySample": "host",
      "hosted": "local-only: Xcode and this Mac's signing/launchd setup"
    },
    {
      "id": "mac.test",
      "tier": "L3",
      "summary": "TronMacIntegrationTests from the mac.build products (test-without-building)",
      "trigger": {
        "paths": [
          "packages/mac-app/**"
        ],
        "code": true
      },
      "after": [
        "mac.build"
      ],
      "command": "cd packages/mac-app && xcodebuild test-without-building -quiet -project TronMac.xcodeproj -scheme TronMac -configuration Debug -destination 'platform=macOS,arch=arm64' -derivedDataPath build/DerivedData",
      "inputs": [
        "packages/mac-app",
        "packages/gateway/package-lock.json",
        "config",
        ".node-version"
      ],
      "keyExtra": [
        "xcode"
      ],
      "cacheScope": "worktree",
      "budgetSeconds": 180,
      "timeoutSeconds": 300,
      "class": "heavy",
      "expectedRssMb": 3500,
      "expectedCores": 2,
      "pool": "xcode",
      "pass": "exit 0, every test passed",
      "unlocks": "gateway",
      "memorySample": "host",
      "hosted": "local-only: Xcode test host on this Mac"
    },
    {
      "id": "mac.replace-e2e",
      "tier": "L3",
      "summary": "One-tap Mac replacement journeys under launchd (#984)",
      "trigger": {
        "paths": [
          "scripts/tron_mac_replace*.py",
          "scripts/test-tron-mac-replace.py",
          "packages/mac-app/Sources/**/Replace*",
          "scripts/tron_mac_reinstall.py"
        ]
      },
      "command": "python3 scripts/test-tron-mac-replace.py",
      "inputs": [
        "scripts",
        "packages/gateway/src",
        "packages/gateway/package-lock.json",
        ".node-version"
      ],
      "budgetSeconds": 240,
      "timeoutSeconds": 420,
      "class": "heavy",
      "expectedRssMb": 1500,
      "expectedCores": 1,
      "artifacts": [
        "test-results/mac-replace-e2e.json"
      ],
      "pass": "exit 0, every journey in the artifact passed",
      "unlocks": "gateway",
      "memorySample": "host",
      "hosted": "local-only: launchd-detached app replacement on this Mac"
    },
    {
      "id": "gateway.deps",
      "tier": "L0",
      "summary": "Verify the Gateway install against package-lock.json; repair drift with npm ci (#1011 guard)",
      "trigger": {
        "paths": [
          "packages/gateway/**"
        ],
        "code": true
      },
      "command": "node scripts/gateway-install-inputs.mjs ensure packages/gateway \"$(dirname \"$(command -v node)\")\"",
      "inputs": [
        "packages/gateway/package.json",
        "packages/gateway/package-lock.json",
        "packages/gateway/third_party",
        ".node-version",
        "scripts/gateway-install-inputs.mjs"
      ],
      "cacheScope": "worktree",
      "budgetSeconds": 120,
      "timeoutSeconds": 300,
      "class": "heavy",
      "expectedRssMb": 600,
      "expectedCores": 2,
      "artifacts": [
        "packages/gateway/node_modules/.package-lock.json"
      ],
      "pass": "exit 0: the install matches the lock",
      "unlocks": "gateway.typecheck",
      "hosted": "safe"
    },
    {
      "id": "gateway.build",
      "tier": "L0",
      "summary": "Gateway SDK check and emitted build for hosted integration",
      "trigger": {},
      "after": [
        "gateway.deps"
      ],
      "command": "cd packages/gateway && npm run check:pi-sdk && npm run build",
      "inputs": [
        "packages/gateway",
        "config",
        ".node-version"
      ],
      "cacheScope": "worktree",
      "artifacts": [
        "packages/gateway/dist/index.js"
      ],
      "budgetSeconds": 90,
      "timeoutSeconds": 300,
      "class": "heavy",
      "expectedRssMb": 1300,
      "expectedCores": 2,
      "pass": "exit 0",
      "unlocks": "gateway.integration",
      "hosted": "safe"
    },
    {
      "id": "gateway.integration",
      "tier": "L3",
      "summary": "Hosted-safe integration subset; vitest.hosted.config.ts alone owns its file selection (#1026)",
      "trigger": {},
      "after": [
        "gateway.build"
      ],
      "command": "cd packages/gateway && npx vitest run --config vitest.hosted.config.ts",
      "inputs": [
        "packages/gateway",
        "config",
        ".node-version"
      ],
      "budgetSeconds": 120,
      "timeoutSeconds": 240,
      "class": "heavy",
      "expectedRssMb": 2500,
      "expectedCores": 2,
      "pass": "exit 0, no failed test",
      "unlocks": "hosted",
      "hosted": "safe"
    },
    {
      "id": "gateway.typecheck",
      "tier": "L0",
      "summary": "tsc for Gateway sources and test support",
      "trigger": {
        "paths": [
          "packages/gateway/**"
        ],
        "code": true
      },
      "after": [
        "gateway.deps"
      ],
      "command": "cd packages/gateway && npm run check",
      "inputs": [
        "packages/gateway",
        ".node-version"
      ],
      "budgetSeconds": 90,
      "timeoutSeconds": 300,
      "class": "light",
      "expectedRssMb": 1300,
      "pass": "exit 0",
      "unlocks": "gateway.affected",
      "hosted": "safe"
    },
    {
      "id": "gateway.affected",
      "tier": "L3",
      "summary": "Vitest files related to the changed Gateway files (default config), sharded",
      "trigger": {
        "paths": [
          "packages/gateway/**"
        ],
        "code": true,
        "select": "gateway-affected"
      },
      "after": [
        "gateway.typecheck"
      ],
      "command": "cd packages/gateway && npx vitest related --run --passWithNoTests --reporter=verbose --reporter=json --outputFile.json=../../test-results/gate/gateway-affected-{shard}-of-{shards}.json --shard={shard}/{shards} {select}",
      "shards": 3,
      "parallelShards": 2,
      "supersededBy": "gateway.full",
      "inputs": [
        "packages/gateway",
        ".node-version"
      ],
      "budgetSeconds": 180,
      "timeoutSeconds": 300,
      "class": "heavy",
      "expectedRssMb": 2500,
      "expectedCores": 4, "coresMin": 2,
      "pass": "exit 0, no failed test",
      "unlocks": "gateway.nested",
      "artifacts": [],
      "reports": "test-results/gate/gateway-affected-<shard>-of-<shards>.json (per-file durations for shard balancing)",
      "hosted": "local-only: Home/runtime timing on hosted runners (#1026); gateway.integration owns hosted coverage"
    },
    {
      "id": "gateway.scripts",
      "tier": "L3",
      "summary": "Gateway script suites (npm test's node --test part): pi-subagents update journeys split across two shards by test name, then the closure, owner, pi-sdk and device-binding suites",
      "trigger": {
        "code": true,
        "paths": [
          "packages/gateway/scripts/**",
          "packages/gateway/package.json",
          "packages/gateway/package-lock.json",
          "packages/gateway/pi-subagents-pin.json",
          "packages/gateway/pi-coding-agent-patch.json",
          "scripts/tron-ios-device-bind*"
        ]
      },
      "after": [
        "gateway.deps"
      ],
      "inputs": [
        "packages/gateway",
        "scripts/tron-ios-device-bind.mjs",
        "scripts/tron-ios-device-bind.test.mjs",
        ".node-version"
      ],
      "budgetSeconds": 240,
      "timeoutSeconds": 420,
      "class": "heavy",
      "expectedRssMb": 1500,
      "expectedCores": 2,
      "pool": "serial",
      "pass": "exit 0",
      "unlocks": "gateway.full",
      "shardCommands": {
        "update-slow": "cd packages/gateway && node --test --test-concurrency=1 --test-name-pattern='^refuses (rollback|join|execution) ' scripts/update-pi-subagents.integration.test.mjs",
        "update-rest": "cd packages/gateway && node --test --test-concurrency=1 --test-skip-pattern='^refuses (rollback|join|execution) ' scripts/update-pi-subagents.integration.test.mjs",
        "suites": "cd packages/gateway && node --test --test-concurrency=1 scripts/check-pi-subagents.integration.test.mjs scripts/build-pi-subagents-closure.integration.test.mjs scripts/fixture-process-owner.integration.test.mjs && npm run test:pi-sdk-scripts && npm run test:device-binding"
      },
      "hosted": "safe"
    },
    {
      "id": "gateway.full",
      "tier": "L3",
      "summary": "The whole Gateway vitest suite (default config) in shards, for changes every file can depend on",
      "trigger": {
        "code": true,
        "paths": [
          "packages/gateway/package-lock.json",
          "packages/gateway/package.json",
          "packages/gateway/vitest*.ts",
          "packages/gateway/test-support/**",
          "packages/gateway/tsconfig*.json",
          "config/GatewayProtocol.json",
          ".node-version"
        ]
      },
      "after": [
        "gateway.typecheck"
      ],
      "command": "cd packages/gateway && npx vitest run --passWithNoTests --reporter=verbose --reporter=json --outputFile.json=../../test-results/gate/gateway-full-{shard}-of-{shards}.json --shard={shard}/{shards}",
      "shards": 6,
      "parallelShards": 2,
      "inputs": [
        "packages/gateway",
        "config/GatewayProtocol.json",
        ".node-version"
      ],
      "budgetSeconds": 180,
      "timeoutSeconds": 300,
      "class": "heavy",
      "expectedRssMb": 2500,
      "expectedCores": 4, "coresMin": 2,
      "pass": "exit 0, no failed test",
      "unlocks": "gateway.nested",
      "artifacts": [],
      "reports": "test-results/gate/gateway-full-<shard>-of-<shards>.json (per-file durations for shard balancing)",
      "hosted": "local-only: Home/runtime timing on hosted runners (#1026); gateway.integration owns hosted coverage"
    },
    {
      "id": "gateway.nested",
      "tier": "L3",
      "summary": "The nested-SDK vitest pass (serial per process; real pi children). It has no affected-only form, so every Gateway code change runs it whole, in four named shards balanced by measured file time; new nested files land in [rest]",
      "trigger": {
        "paths": [
          "packages/gateway/**",
          "config/GatewayProtocol.json",
          ".node-version"
        ],
        "code": true
      },
      "after": [
        "gateway.typecheck"
      ],
      "inputs": [
        "packages/gateway",
        "config/GatewayProtocol.json",
        ".node-version"
      ],
      "budgetSeconds": 240,
      "timeoutSeconds": 300,
      "class": "heavy",
      "expectedRssMb": 1600,
      "expectedCores": 2,
      "pool": "serial",
      "pass": "exit 0, no failed test",
      "unlocks": "relay",
      "artifacts": [],
      "reports": "test-results/gate/gateway-full-nested-<shard>-of-<shards>.json (per-file durations for shard balancing)",
      "shardCommands": {
        "subagents-settlement": "cd packages/gateway && npx vitest run --passWithNoTests --reporter=verbose --reporter=json --outputFile.json=../../test-results/gate/gateway-nested-{shard}-of-{shards}.json --config vitest.nested.config.ts src/home/home-task-subagents-settlement.e2e.test.ts",
        "subagents-reports": "cd packages/gateway && npx vitest run --passWithNoTests --reporter=verbose --reporter=json --outputFile.json=../../test-results/gate/gateway-nested-{shard}-of-{shards}.json --config vitest.nested.config.ts src/home/home-task-subagents-reports.e2e.test.ts",
        "subagents-controls": "cd packages/gateway && npx vitest run --passWithNoTests --reporter=verbose --reporter=json --outputFile.json=../../test-results/gate/gateway-nested-{shard}-of-{shards}.json --config vitest.nested.config.ts src/home/home-task-subagents-controls.e2e.test.ts src/home/home-task-subagents-model-queue.e2e.test.ts",
        "rest": "cd packages/gateway && npx vitest run --passWithNoTests --reporter=verbose --reporter=json --outputFile.json=../../test-results/gate/gateway-nested-{shard}-of-{shards}.json --config vitest.nested.config.ts --exclude 'src/home/home-task-subagents-*.e2e.test.ts'"
      },
      "hosted": "local-only: Home/runtime timing on hosted runners (#1026); gateway.integration owns hosted coverage"
    },
    {
      "id": "gateway.payload",
      "tier": "L3",
      "summary": "Gateway payload deploy and install-input journeys (real npm ci from local tarballs)",
      "trigger": {
        "paths": [
          "scripts/gateway-payload-deploy*",
          "scripts/gateway-install-inputs*",
          "scripts/hash-npm-runtime.py",
          "packages/mac-app/scripts/bundle-gateway.sh"
        ]
      },
      "after": [
        "gateway.deps"
      ],
      "command": "node --test --test-concurrency=2 scripts/gateway-payload-deploy.test.mjs scripts/gateway-install-inputs.test.mjs",
      "inputs": [
        "scripts",
        "packages/gateway/package.json",
        "packages/gateway/package-lock.json",
        "packages/mac-app/scripts",
        ".node-version"
      ],
      "budgetSeconds": 240,
      "timeoutSeconds": 420,
      "class": "heavy",
      "expectedRssMb": 1500,
      "expectedCores": 2,
      "pass": "exit 0",
      "unlocks": "relay",
      "hosted": "safe"
    },
    {
      "id": "relay.check",
      "tier": "L1",
      "summary": "Push relay install, typecheck, dry-run build and tests",
      "trigger": {
        "paths": [
          "packages/push-relay/**"
        ],
        "code": true
      },
      "command": "cd packages/push-relay && { [ -d node_modules ] || npm ci --no-audit --no-fund; } && npm run check && npm run build && npm test",
      "inputs": [
        "packages/push-relay",
        ".node-version"
      ],
      "cacheScope": "worktree",
      "budgetSeconds": 120,
      "timeoutSeconds": 300,
      "class": "heavy",
      "expectedRssMb": 1000,
      "expectedCores": 1,
      "pass": "exit 0",
      "unlocks": "ios.build",
      "hosted": "safe"
    },
    {
      "id": "ios.build",
      "tier": "L0",
      "summary": "One iOS build-for-testing; every iOS journey shard reuses its stamped products",
      "trigger": {
        "paths": [
          "packages/ios-app/**",
          "config/GatewayProtocol.json",
          "config/PushService.xcconfig"
        ],
        "code": true
      },
      "command": "scripts/tron-ios-test build",
      "inputs": [
        "packages/ios-app",
        "config",
        ".node-version"
      ],
      "keyExtra": [
        "xcode"
      ],
      "cacheScope": "source",
      "budgetSeconds": 300,
      "timeoutSeconds": 900,
      "class": "heavy",
      "expectedRssMb": 6000,
      "expectedCores": 16,
      "coresMin": 7,
      "pool": "xcode",
      "pass": "exit 0 and the products carry the source identity stamp",
      "unlocks": "ios.journeys",
      "memorySample": "host",
      "hosted": "local-only: Xcode and the owned simulator lanes"
    },
    {
      "id": "ios.device-compile",
      "tier": "L0",
      "summary": "Unsigned compile of the shipped app exactly as the iPhone install builds it (Tron Device + LocalDevice, optimized, generic arm64 iOS); the HOSTED_TEST simulator build cannot see code only the shipped configuration compiles (#1061)",
      "trigger": {
        "paths": [
          "packages/ios-app/**",
          "config/GatewayProtocol.json",
          "config/PushService.xcconfig",
          "scripts/tron-ios-device"
        ],
        "code": true
      },
      "command": "scripts/tron-ios-device compile",
      "inputs": [
        "packages/ios-app",
        "config",
        "scripts/tron-ios-device",
        "scripts/ios-test-build-identity.py",
        "scripts/ios-test-simulator.py",
        "scripts/verify-gateway-protocol-contract.py",
        "scripts/gateway_protocol_contract.py",
        "scripts/gateway-payload-deploy.mjs",
        "scripts/validate-push-service-config.sh",
        "packages/gateway/src/version.ts",
        "packages/mac-app/project.yml",
        "packages/mac-app/Sources/Info.plist",
        "packages/mac-app/Sources/Server/Health/GatewayProtocolContract.swift",
        "packages/mac-app/scripts/tron-gateway-launcher.c"
      ],
      "keyExtra": [
        "ios-compile-environment"
      ],
      "budgetSeconds": 180,
      "timeoutSeconds": 600,
      "class": "heavy",
      "expectedRssMb": 7000,
      "expectedCores": 10,
      "coresMin": 9,
      "pool": "xcode",
      "pass": "exit 0 and BUILD SUCCEEDED",
      "unlocks": "ios.journeys",
      "memorySample": "host",
      "hosted": "local-only: Xcode on this Mac"
    },
    {
      "id": "ios.journeys",
      "tier": "L4",
      "summary": "Simulator journeys for the changed UI test classes, two test methods per shard (or the smoke set), with test-without-building from the one ios.build",
      "trigger": {
        "paths": [
          "packages/ios-app/**"
        ],
        "code": true,
        "select": "ios-journeys"
      },
      "after": [
        "ios.build"
      ],
      "command": "scripts/tron-ios-test run {select}",
      "inputs": [
        "packages/ios-app",
        "config",
        ".node-version"
      ],
      "keyExtra": [
        "xcode"
      ],
      "cacheScope": "worktree",
      "moduleScopes": [
        {
          "module": "TronSwiftAppEngine",
          "path": "packages/ios-app/SwiftAppEngine",
          "sdk": "iphonesimulator",
          "swiftFlags": ["-target", "arm64-apple-ios26.0-simulator", "-swift-version", "6", "-package-name", "TronIOSApp", "-D", "DEBUG", "-D", "HOSTED_TEST"]
        },
        {
          "testTarget": "TronSwiftAppUITests",
          "path": "packages/ios-app/SwiftAppUITests"
        }
      ],
      "budgetSeconds": 240,
      "timeoutSeconds": 420,
      "class": "heavy",
      "expectedRssMb": 9000,
      "expectedCores": 6,
      "pool": "xcode",
      "pass": "exit 0, result bundle passed > 0 and failed = 0",
      "unlocks": "journeys",
      "memorySample": "host",
      "hosted": "local-only: simulator lanes on this Mac"
    },
    {
      "id": "gateway.pi-sdk-rollback",
      "tier": "L3",
      "summary": "Networked sequential Pi SDK forward/rollback matrix on an actual Pi dependency-graph delta or matrix-owner change",
