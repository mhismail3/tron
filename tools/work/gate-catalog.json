    {
      "id": "ios.gateway-boundary",
      "tier": "L4",
      "summary": "Real Gateway resilience and LAN boundary, built once then run serially in an owned simulator lane; every shard retires its fixture",
      "trigger": {
        "piGraph": true,
        "code": true,
        "paths": [
          "packages/gateway/src/transport/server.ts",
          "packages/gateway/src/transport/connection-policy.ts",
          "packages/gateway/src/transport/lan-endpoint.ts",
          "packages/gateway/src/transport/tailscale-peer.ts",
          "packages/gateway/src/transport/gateway-service.ts",
          "packages/ios-app/Core/Gateway/**",
          "packages/ios-app/E2ETests/RealGatewayPiBoundaryTests.swift",
          "scripts/ios-gateway-*",
          "scripts/patch-ios-gateway-e2e-xctestrun.py",
          "config/GatewayProtocol.json"
        ]
      },
      "shardCommands": {
        "build": "trap 'scripts/ios-gateway-e2e-test stop' EXIT; scripts/ios-gateway-e2e-test build",
        "resilience": "trap 'scripts/ios-gateway-e2e-test stop' EXIT; scripts/ios-gateway-e2e-test run",
        "lan": "trap 'scripts/ios-gateway-e2e-test stop' EXIT; scripts/ios-gateway-e2e-test run-lan"
      },
      "inputs": [
        "packages/gateway",
        "packages/ios-app",
        "scripts",
        "config",
        ".node-version"
      ],
      "keyExtra": [
        "xcode"
      ],
      "cacheScope": "worktree",
      "budgetSeconds": 300,
      "timeoutSeconds": 900,
      "class": "heavy",
      "expectedRssMb": 9000,
      "expectedCores": 16,
      "coresMin": 7,
      "pool": "xcode",
      "pass": "exit 0, XCTest passes and owned fixture stops",
      "unlocks": "land",
      "memorySample": "host",
      "hosted": "local-only: Xcode, owned simulator, private LAN address; cold build has the ios.build 900s hard bound"
    },
    {
      "id": "journey",
      "tier": "L3",
      "tierRules": [{"match": "tron-ios-|ios-gateway-e2e|xcodebuild", "tier": "L4"}],
      "summary": "Each integration or E2E command named with --tests, from the repository root",
      "trigger": {
