        "piGraph": true,
        "paths": [
          "packages/gateway/scripts/check-pi-sdk-rollback.mjs",
          "packages/gateway/pi-sdk-baseline.json",
          "packages/gateway/scripts/compare-pi-sdk-graph.mjs"
        ]
      },
      "after": [
