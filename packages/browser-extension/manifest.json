{
  "manifest_version": 3,
  "name": "Tron Browser Operator",
  "version": "0.1.0",
  "description": "User-consented, closed browser actuation for Tron's Browser Operator worker.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "Enable Tron for this tab"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
