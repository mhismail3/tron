{
  "name": "@tron/gateway",
  "version": "0.1.0-beta.7",
  "private": true,
  "type": "module",
  "bin": {
    "tron-chat": "dist/client/terminal-chat.js"
  },
  "engines": {
    "node": ">=22.19.0"
