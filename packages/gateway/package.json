    "proper-lockfile": "4.1.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
