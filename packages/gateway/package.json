{
  "name": "@tron/gateway",
  "version": "0.1.0-beta.8",
  "private": true,
  "type": "module",
  "bin": {
    "tron-chat": "dist/client/terminal-chat.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helper.mjs",
    "check:pi-sdk": "node scripts/check-pi-sdk.mjs",
    "check:pi-subagents": "node scripts/check-pi-subagents.mjs",
    "install:pi-subagents": "node scripts/install-pi-subagents.mjs",
    "build:pi-subagents-closure": "python3 scripts/build-pi-subagents-closure.py",
    "test:pi-subagents-rollback": "vitest run --config vitest.nested.config.ts src/sessions/managed-subagents.rollback.test.ts src/sessions/managed-subagents.invalid-entry.test.ts",
    "test:pi-subagents-scripts": "node --test --test-concurrency=1 scripts/check-pi-subagents.test.mjs scripts/build-pi-subagents-closure.test.mjs scripts/fixture-process-owner.test.mjs scripts/update-pi-subagents.test.mjs",
    "update:pi-subagents": "node scripts/update-pi-subagents.mjs",
    "update:pi-sdk": "node scripts/update-pi-sdk.mjs",
    "test:pi-sdk-scripts": "node --import ./test-support/tron-home-environment-preflight.mjs --test scripts/check-pi-sdk.test.mjs scripts/update-pi-sdk.test.mjs scripts/compare-pi-sdk-graph.test.mjs",
    "test:pi-sdk-rollback": "node scripts/check-pi-sdk-rollback.mjs",
    "test:sdk-behavior-trace": "vitest run src/sessions/sdk-behavior-trace.integration.test.ts",
    "update:sdk-behavior-trace": "TRON_UPDATE_SDK_BEHAVIOR_TRACE=1 vitest run src/sessions/sdk-behavior-trace.integration.test.ts",
    "record:pi-corpus": "vitest run --config vitest.corpus.config.ts",
    "build": "tsc -p tsconfig.json && npm run check:test-support",
    "check": "tsc -p tsconfig.json --noEmit && npm run check:test-support",
    "check:test-support": "tsc -p tsconfig.test-support.json",
    "test:device-binding": "node --import ./test-support/tron-home-environment-preflight.mjs --test ../../scripts/tron-ios-device-bind.test.mjs",
    "test": "npm run test:pi-sdk-scripts && npm run test:device-binding && vitest run && vitest run --config vitest.nested.config.ts",
    "test:scale": "vitest run --config vitest.scale.config.ts",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "chat": "node dist/client/terminal-chat.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/proper-lockfile": "4.1.4",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
