{
  "name": "@tron/gateway",
  "version": "0.1.0-beta.7",
  "private": true,
  "type": "module",
  "bin": {
    "tron-chat": "dist/client/terminal-chat.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helper.mjs",
    "check:pi-sdk": "node scripts/check-pi-sdk.mjs",
    "update:pi-sdk": "node scripts/update-pi-sdk.mjs",
    "test:pi-sdk-scripts": "node --test scripts/check-pi-sdk.test.mjs scripts/update-pi-sdk.test.mjs scripts/compare-pi-sdk-graph.test.mjs scripts/check-pi-sdk-rollback.test.mjs",
    "test:pi-sdk-rollback": "node scripts/check-pi-sdk-rollback.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:resilience-fixtures": "node --test ../../scripts/ios-gateway-fault-proxy.test.mjs",
    "test:device-binding": "node --test ../../scripts/tron-ios-device-bind.test.mjs",
    "test": "npm run test:pi-sdk-scripts && npm run test:resilience-fixtures && npm run test:device-binding && vitest run",
    "test:scale": "vitest run --config vitest.scale.config.ts",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "chat": "node dist/client/terminal-chat.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@modelcontextprotocol/sdk": "1.25.2",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
