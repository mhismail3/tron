{
  "name": "@tron/gateway",
  "version": "0.1.0-beta.8",
  "private": true,
  "type": "module",
  "bin": {
    "tron-chat": "dist/client/terminal-chat.js"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-helper.mjs",
    "check:pi-sdk": "node scripts/check-pi-sdk.mjs",
    "check:pi-subagents": "node scripts/check-pi-subagents.mjs",
    "install:pi-subagents": "node scripts/install-pi-subagents.mjs",
    "build:pi-subagents-closure": "python3 scripts/build-pi-subagents-closure.py",
    "test:pi-subagents-rollback": "vitest run --config vitest.nested.config.ts src/sessions/managed-subagents.rollback.integration.test.ts src/sessions/managed-subagents.invalid-entry.integration.test.ts",
    "test:pi-subagents-scripts": "node --test --test-concurrency=1 scripts/check-pi-subagents.integration.test.mjs scripts/build-pi-subagents-closure.integration.test.mjs scripts/fixture-process-owner.integration.test.mjs scripts/update-pi-subagents.integration.test.mjs",
    "update:pi-subagents": "node scripts/update-pi-subagents.mjs",
    "update:pi-sdk": "node scripts/update-pi-sdk.mjs",
    "reproduce:pi-coding-agent": "node scripts/build-pi-coding-agent-patch.mjs",
    "test:pi-sdk-rollback": "node scripts/check-pi-sdk-rollback.mjs",
    "test:pi-sdk-scripts": "node --test scripts/check-pi-sdk.integration.test.mjs",
    "test:sdk-behavior-trace": "vitest run src/sessions/sdk-behavior-trace.integration.test.ts",
    "update:sdk-behavior-trace": "TRON_UPDATE_SDK_BEHAVIOR_TRACE=1 vitest run src/sessions/sdk-behavior-trace.integration.test.ts",
    "record:pi-corpus": "vitest run --config vitest.corpus.config.ts",
    "build": "echo '[gateway] production: check + emit' && tsc -p tsconfig.json && npm run check:test-support",
    "check": "echo '[gateway] production: check (no emit)' && tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tron/production-check.tsbuildinfo && npm run check:test-support",
    "check:test-support": "echo '[gateway] test support + corpus: check (no emit)' && tsc -p tsconfig.test-support.json",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings --report-unused-disable-directives src test-support test-fixtures scripts",
    "test:lint": "node --test scripts/oxlint-rules.integration.test.mjs",
    "test:typescript-build": "node --test scripts/typescript-build.integration.test.mjs",
    "test:device-binding": "node --import ./test-support/tron-home-environment-preflight.mjs --test ../../scripts/tron-ios-device-bind.test.mjs",
    "test:tron-home-environment": "node --test scripts/tron-home-environment-preflight.integration.test.mjs",
    "test": "vitest run && vitest run --config vitest.nested.config.ts && npm run test:pi-subagents-scripts && npm run test:pi-sdk-scripts && npm run test:device-binding && npm run test:tron-home-environment && npm run test:typescript-build",
    "test:nested": "vitest run --config vitest.nested.config.ts",
    "test:mac-terminal": "vitest run --config vitest.mac-terminal.config.ts",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "chat": "node dist/client/terminal-chat.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "file:third_party/pi-coding-agent/pi-coding-agent-1.0.4-tron.4.tgz",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/semver": "7.8.0",
    "node-pty": "1.1.0",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/ws": "8.18.2",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
