+/// Editing command for a macOS Cmd chord, sent as CDP `commands` on keyDown.
+///
+/// Chrome on macOS runs Cmd+A/C/V/X/Z through native key bindings, which CDP
+/// key events bypass, so the chord has to name its editing command. Only the
+/// exact chords map (Meta = 4, Shift = 8): Cmd+Shift+Z is redo, and any other
+/// modifier set stays a plain key event.
+fn macos_editing_commands(key: &str, modifiers: i32) -> Option<Vec<String>> {
+    if !cfg!(target_os = "macos") {
+        return None;
+    }
+    let command = match (key.to_ascii_lowercase().as_str(), modifiers) {
+        ("a", 4) => "selectAll",
+        ("c", 4) => "copy",
+        ("x", 4) => "cut",
+        ("v", 4) => "paste",
+        ("z", 4) => "undo",
+        ("z", 12) => "redo",
+        _ => return None,
+    };
+    Some(vec![command.to_string()])
+}
