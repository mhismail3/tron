+/// On macOS, Cmd+A selects everything in a focused field, so the next keystroke
+/// replaces the whole value. Cmd+Shift+A has no editing binding and must leave
+/// the caret alone; the step before the select-all checks that.
+#[cfg(target_os = "macos")]
+#[tokio::test]
+#[ignore]
+async fn e2e_press_meta_select_all_replaces_input_and_contenteditable() {
+    let mut state = DaemonState::new();
+
+    let resp = execute_command(
+        &json!({ "id": "1", "action": "launch", "headless": true }),
+        &mut state,
+    )
+    .await;
+    assert_success(&resp);
+
+    let html = concat!(
+        "data:text/html,<html><body>",
+        "<input id=i value=old>",
+        "<div id=c contenteditable=true>old</div>",
+        "</body></html>"
+    );
+    let resp = execute_command(
+        &json!({ "id": "2", "action": "navigate", "url": html }),
+        &mut state,
+    )
+    .await;
+    assert_success(&resp);
+
+    let resp = execute_command(
+        &json!({ "id": "3", "action": "click", "selector": "#i" }),
+        &mut state,
+    )
+    .await;
+    assert_success(&resp);
+    press_chord(&mut state, "4", "End").await;
+    press_chord(&mut state, "5", "Meta+Shift+a").await;
+    press_chord(&mut state, "6", "q").await;
+    assert_evaluate(
+        &mut state,
+        "7",
+        "document.getElementById('i').value",
+        json!("oldq"),
+    )
+    .await;
+
+    press_chord(&mut state, "8", "Meta+a").await;
+    press_chord(&mut state, "9", "r").await;
+    assert_evaluate(
+        &mut state,
+        "10",
+        "document.getElementById('i').value",
+        json!("r"),
+    )
+    .await;
+
+    let resp = execute_command(
+        &json!({ "id": "11", "action": "click", "selector": "#c" }),
+        &mut state,
+    )
+    .await;
+    assert_success(&resp);
+    press_chord(&mut state, "12", "End").await;
+    press_chord(&mut state, "13", "Meta+a").await;
+    press_chord(&mut state, "14", "q").await;
+    assert_evaluate(
+        &mut state,
+        "15",
+        "document.getElementById('c').textContent",
+        json!("q"),
+    )
+    .await;
+
+    let resp = execute_command(&json!({ "id": "99", "action": "close" }), &mut state).await;
+    assert_success(&resp);
+}
