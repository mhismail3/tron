+
+function ownedEndpointArgs(args: readonly string[]): string[] {
+	const flags = ["--session", "--namespace"].flatMap((flag) => {
+		const value = scanUpstreamGlobalFlagOccurrences(args, flag).at(-1)?.value;
+		return value === undefined ? [] : [flag, value];
+	});
+	return [...flags, "--json", "get", "cdp-url"];
+}
+
+function runOwnedBrowserChild(
+	options: AgentBrowserProcessOptions,
+	child: Parameters<typeof runBrowserChild>[0],
+): Promise<ProcessRunResult> {
+	const owner = currentOwnedBrowser();
+	if (owner === undefined) {
+		return runBrowserChild(child);
+	}
+	return owner.execute({
+		args: child.args,
+		env: { ...getAgentBrowserProcessEnvironment(), ...child.env },
+		stdin: options.stdin,
+		run: (args, env) =>
+			runBrowserChild({
+				...child,
+				args,
+				env,
+				stockLauncher: owner.engineExecutable ?? child.stockLauncher,
+			}),
+		endpoint: () =>
+			runAgentBrowserProcess({
+				...options,
+				args: ownedEndpointArgs(options.args),
+				stdin: undefined,
+			}),
+	});
+}
