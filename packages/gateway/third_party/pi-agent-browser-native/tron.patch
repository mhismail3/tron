index 0000000..817a9b1
--- /dev/null
+++ b/extensions/agent-browser/lib/owned-launches.ts
@@ -0,0 +1,499 @@
+import { execFile } from "node:child_process";
+import { randomUUID, createHash } from "node:crypto";
+import { mkdir, readFile, readdir, rename, rm, writeFile, lstat, realpath } from "node:fs/promises";
+import { dirname, join, resolve } from "node:path";
+import { promisify } from "node:util";
+import { Type, type Static } from "typebox";
+import { Check } from "typebox/value";
+import { readProcessStartIdentity } from "./process-identity.js";
+import {
+	acquireExecutionClaim,
+	type ManagedSessionPolicyLock,
+} from "./browser-execution-claims.js";
+
+interface OwnedCommandResult {
+	readonly content: Array<{ type: "text"; text: string }>;
+	readonly details: {
+		resultCategory: "success";
+		args: readonly string[];
+		data: Record<string, unknown>;
+	};
+}
+
+const execute = promisify(execFile);
+
+export const BACKGROUND_FLAGS = [
+	"--disable-backgrounding-occluded-windows",
+	"--disable-renderer-backgrounding",
+	"--disable-background-timer-throttling",
+] as const;
+
+const launchSchema = Type.Object({
+	endpoint: Type.String(),
+	pid: Type.Integer({ minimum: 2 }),
+	start: Type.String({ minLength: 1 }),
+	profile: Type.String(),
+	token: Type.String({ minLength: 1 }),
+	targets: Type.Optional(Type.Array(Type.String(), { maxItems: 128 })),
+	kind: Type.Union([Type.Literal("web"), Type.Literal("electron"), Type.Literal("studio")]),
+	sessions: Type.Array(Type.String(), { maxItems: 128 }),
+	master: Type.Optional(Type.String()),
+});
+
+export type Launch = Static<typeof launchSchema>;
+
+export function refuseOwnedLaunch(): never {
+	throw new Error(
+		"owned_launch_required: endpoint requires a recorded Tron-owned launch; personal browser attachment and profile copying are unavailable. For a persistent signed-in profile: owned-launch prepare <profileDir> (a private directory holding a .tron-owned-profile marker), launch Chrome with the returned args, owned-launch record <launchId> <pid> <profileDir>, then connect the returned endpoint.",
+	);
+}
+
+function decodeLaunch(input: string): Launch {
+	const value: unknown = JSON.parse(input);
+	if (!Check(launchSchema, value)) {
+		refuseOwnedLaunch();
+	}
+	return value;
+}
+
+function address(value: string): URL {
+	const url = new URL(/^\d+$/.test(value) ? `http://127.0.0.1:${value}` : value);
+	const identity = [url.username, url.password, url.search, url.hash];
+	if (
+		url.hostname !== "127.0.0.1" ||
+		!["ws:", "http:"].includes(url.protocol) ||
+		url.port.length === 0 ||
+		identity.some((entry) => entry.length > 0)
+	) {
+		refuseOwnedLaunch();
+	}
+	return url;
+}
+
+function matches(value: string, launch: Launch): boolean {
+	const url = address(value),
+		recorded = address(launch.endpoint);
+	return (
+		url.port === recorded.port &&
+		([recorded.href, ...(launch.targets ?? [])].includes(url.href) ||
+			(url.protocol === "http:" && url.pathname === "/"))
+	);
+}
+
+async function studioEndpoint(profile: string): Promise<string> {
+	const [port, path] = (await readFile(join(profile, "DevToolsActivePort"), "utf8"))
+		.trim()
+		.split("\n");
+	if (
+		port === undefined ||
+		path === undefined ||
+		!/^\d+$/.test(port) ||
+		!/^\/devtools\/browser\/[^/]+$/.test(path)
+	) {
+		refuseOwnedLaunch();
+	}
+	return `ws://127.0.0.1:${port}${path}`;
+}
+
+async function listener(endpoint: string): Promise<number> {
+	const { stdout } = await execute(
+		"/usr/sbin/lsof",
+		["-nP", "-a", `-iTCP:${address(endpoint).port}`, "-sTCP:LISTEN", "-Fp"],
+		{ timeout: 5000 },
+	);
+	const pids = [
+		...new Set(
+			stdout
+				.split("\n")
+				.filter((line) => /^p\d+$/.test(line))
+				.map((line) => Number(line.slice(1))),
+		),
+	];
+	const pid = pids[0];
+	if (pids.length !== 1 || pid === undefined || pid <= 1) {
+		refuseOwnedLaunch();
+	}
+	return pid;
+}
+
+async function privateEntry(path: string, directory: boolean): Promise<void> {
+	const stat = await lstat(path).catch(() => refuseOwnedLaunch());
+	if (
+		(directory ? !stat.isDirectory() : !stat.isFile()) ||
+		stat.uid !== process.getuid?.() ||
+		(stat.mode & 0o077) !== 0
+	) {
+		refuseOwnedLaunch();
+	}
+}
+
+async function privateDirectory(path: string): Promise<void> {
+	await mkdir(path, { recursive: true, mode: 0o700 });
+	await privateEntry(path, true);
+}
+
+export class OwnedLaunches {
+	readonly profile: string;
+	readonly root: string;
+	readonly socketDir: string;
+	readonly session: string;
+	constructor(profile: string) {
+		this.profile = resolve(profile);
+		this.root = `${this.profile}.launches`;
+		this.session = `tron-${createHash("sha256").update(this.profile).digest("hex").slice(0, 16)}`;
+		this.socketDir = join("/tmp", `pi-owned-${process.getuid?.() ?? "user"}-${this.session}`);
+	}
+	async lock(signal?: AbortSignal): Promise<ManagedSessionPolicyLock> {
+		for (const path of [
+			this.root,
+			this.socketDir,
+			join(dirname(this.profile), "home"),
+			this.profile,
+		]) {
+			await privateDirectory(path);
+		}
+		const lock = await acquireExecutionClaim({
+			identity: { socketContext: await realpath(this.root), sessionNames: null },
+			signal,
+		});
+		if (!lock) {
+			throw new Error("Owned browser operation cancelled or its existing native claim is busy");
+		}
+		try {
+			await this.profileMarker();
+			return lock;
+		} catch (error) {
+			await lock.release();
+			throw error;
+		}
+	}
+
+	private async profileMarker(): Promise<void> {
+		const marker = join(this.profile, ".tron-owned-profile");
+		const files = await readdir(this.profile);
+		if (!files.includes(".tron-owned-profile")) {
+			if (files.length !== 0) {
+				refuseOwnedLaunch();
+			}
+			await writeFile(marker, randomUUID(), { mode: 0o600, flag: "wx" });
+		}
+		await privateEntry(marker, false);
+	}
+
+	private async persistentProfile(path: string): Promise<string> {
+		if (path !== resolve(path)) {
+			refuseOwnedLaunch();
+		}
+		await privateEntry(path, true);
+		const real = await realpath(path);
+		for (const owned of await Promise.all([this.profile, this.root].map((item) => realpath(item)))) {
+			if (real === owned || real.startsWith(`${owned}/`)) {
+				refuseOwnedLaunch();
+			}
+		}
+		await privateEntry(join(path, ".tron-owned-profile"), false);
+		return path;
+	}
+
+	private temporary(launch: Launch): boolean {
+		return launch.profile === join(this.root, `studio-${launch.token}`);
+	}
+
+	private file(endpoint: string): string {
+		return join(this.root, `${address(endpoint).port}.json`);
+	}
+
+	private async save(launch: Launch): Promise<void> {
+		const temporary = join(this.root, `.${randomUUID()}`);
+		try {
+			await writeFile(temporary, JSON.stringify(launch), { mode: 0o600, flag: "wx" });
+			await rename(temporary, this.file(launch.endpoint));
+		} finally {
+			await rm(temporary, { force: true });
+		}
+	}
+
+	private async live(launch: Launch): Promise<boolean> {
+		const start = await readProcessStartIdentity(launch.pid);
+		if (start === undefined) {
+			try {
+				process.kill(launch.pid, 0);
+			} catch (error) {
+				if (error instanceof Error && "code" in error && error.code === "ESRCH") {
+					return false;
+				}
+				throw error;
+			}
+			throw new Error("Owned browser process identity is unavailable; launch receipt retained");
+		}
+		if (start !== launch.start) {
+			return false;
+		}
+		if ((await listener(launch.endpoint)) !== launch.pid) {
+			return false;
+		}
+		const { stdout } = await execute(
+			"/bin/ps",
+			["-ww", "-p", String(launch.pid), "-o", "command="],
+			{ timeout: 5000 },
+		);
+		const command = ` ${stdout.trim()} `;
+		const real = await realpath(launch.profile).catch((error: unknown) => {
+			if (error instanceof Error && "code" in error && error.code === "ENOENT") {
+				return undefined;
+			}
+			throw error;
+		});
+		if (
+			real === undefined ||
+			![launch.profile, real].some((profile) =>
+				command.includes(` --user-data-dir=${profile} `),
+			)
+		) {
+			return false;
+		}
+		return command.includes(` --tron-owned-launch=${launch.token} `);
+	}
+
+	private async records(): Promise<Launch[]> {
+		const names = (await readdir(this.root)).filter((name) => /^\d+\.json$/.test(name));
+		if (names.length > 128) {
+			refuseOwnedLaunch();
+		}
+		return Promise.all(
+			names.map(async (name) => decodeLaunch(await readFile(join(this.root, name), "utf8"))),
+		);
+	}
+
+	async active(): Promise<Launch[]> {
+		const result: Launch[] = [];
+		for (const launch of await this.records()) {
+			if (await this.live(launch)) {
+				result.push(launch);
+			} else if (launch.kind !== "studio" || !this.temporary(launch)) {
+				await rm(this.file(launch.endpoint));
+			}
+		}
+		return result;
+	}
+
+	async recorded(endpoint: string): Promise<Launch> {
+		const launch = (await this.active()).find((item) => matches(endpoint, item));
+		return launch ?? refuseOwnedLaunch();
+	}
+
+	async connected(session: string, launch: Launch, data: Record<string, unknown>): Promise<void> {
+		if (typeof data.cdpUrl === "string" && !matches(data.cdpUrl, launch)) {
+			refuseOwnedLaunch();
+		}
+		for (const entry of await this.active()) {
+			const owns = entry.endpoint === launch.endpoint;
+			if (owns === entry.sessions.includes(session)) {
+				continue;
+			}
+			const sessions = owns
+				? [...entry.sessions, session]
+				: entry.sessions.filter((item) => item !== session);
+			if (sessions.length > 128) {
+				refuseOwnedLaunch();
+			}
+			await this.save({ ...entry, sessions });
+		}
+	}
+
+	async detached(session: string): Promise<void> {
+		for (const launch of await this.active()) {
+			if (!launch.sessions.includes(session)) {
+				continue;
+			}
+			await this.save({ ...launch, sessions: launch.sessions.filter((item) => item !== session) });
+		}
+	}
+
+	async launched(session: string, token: string, endpoint: string): Promise<void> {
+		if (!/^\/devtools\/browser\/[^/]+$/.test(address(endpoint).pathname)) {
+			refuseOwnedLaunch();
+		}
+		const pid = await listener(endpoint);
+		const start = await readProcessStartIdentity(pid);
+		if (start === undefined) {
+			refuseOwnedLaunch();
+		}
+		const launch: Launch = {
+			endpoint,
+			pid,
+			start,
+			profile: this.profile,
+			token: token,
+			kind: "web",
+			sessions: [session],
+			master: session,
+		};
+		if (!(await this.live(launch))) {
+			refuseOwnedLaunch();
+		}
+		const prior = (await this.active()).find((item) => item.kind === "web");
+		if (prior && prior.endpoint !== endpoint) {
+			refuseOwnedLaunch();
+		}
+		await this.save({ ...launch, sessions: prior?.sessions ?? launch.sessions });
+	}
+
+	private async studioPrepare(persistent: string | undefined): Promise<Record<string, unknown>> {
+		const token = randomUUID();
+		let profile: string;
+		if (persistent === undefined) {
+			if ((await readdir(this.root)).filter((name) => name.startsWith("studio-")).length >= 128) {
+				refuseOwnedLaunch();
+			}
+			profile = join(this.root, `studio-${token}`);
+			await mkdir(profile, { mode: 0o700 });
+		} else {
+			profile = await this.persistentProfile(persistent);
+			const running = (await this.active()).find((item) => item.profile === profile);
+			if (running) {
+				throw new Error(
+					`owned_launch_live: ${profile} already has a live recorded browser at ${running.endpoint}; connect to it, or close it before preparing again`,
+				);
+			}
+			await rm(join(profile, "DevToolsActivePort"), { force: true });
+		}
+		return {
+			launchId: token,
+			profile,
+			args: [
+				`--user-data-dir=${profile}`,
+				"--remote-debugging-port=0",
+				...BACKGROUND_FLAGS,
+				`--tron-owned-launch=${token}`,
+			],
+		};
+	}
+
+	private studioProfile(token: string | undefined): string {
+		if (token === undefined || !/^[a-f0-9-]{36}$/.test(token)) {
+			refuseOwnedLaunch();
+		}
+		return join(this.root, `studio-${token}`);
+	}
+
+	private async studioRecord(
+		token: string | undefined,
+		rawPid: string | undefined,
+		persistent: string | undefined,
+	): Promise<Record<string, unknown>> {
+		const temporary = this.studioProfile(token);
+		const profile =
+			persistent === undefined ? temporary : await this.persistentProfile(persistent);
+		const pid = Number(rawPid);
+		if (!Number.isSafeInteger(pid) || pid <= 1) {
+			refuseOwnedLaunch();
+		}
+		const endpoint = await studioEndpoint(profile);
+		const start = await readProcessStartIdentity(pid);
+		if (start === undefined) {
+			refuseOwnedLaunch();
+		}
+		const launch: Launch = {
+			endpoint,
+			pid,
+			start,
+			profile,
+			token: token ?? refuseOwnedLaunch(),
+			kind: "studio",
+			sessions: [],
+		};
+		if (!(await this.live(launch)) || (await this.records()).length >= 128) {
+			refuseOwnedLaunch();
+		}
+		await this.save(launch);
+		return { endpoint: launch.endpoint, launchId: token };
+	}
+
+	private async studioCleanup(token: string | undefined): Promise<Record<string, unknown>> {
+		const path = this.studioProfile(token);
+		const profile = await realpath(path);
+		if (profile !== join(await realpath(this.root), `studio-${String(token)}`)) {
+			refuseOwnedLaunch();
+		}
+		const record = (await this.records()).find(
+			(item) => item.profile === path && item.token === token,
+		);
+		if (!record || (await this.live(record))) {
+			refuseOwnedLaunch();
+		}
+		await rm(profile, { recursive: true });
+		await rm(this.file(record.endpoint));
+		return { cleaned: true };
+	}
+
+	async command(params: { args?: readonly string[] }): Promise<OwnedCommandResult | undefined> {
+		const args = params.args;
+		if (args?.[0] !== "owned-launch") {
+			return;
+		}
+		let data: Record<string, unknown>;
+		switch (args[1] ?? "") {
+			case "prepare":
+				if (args.length > 3) {
+					refuseOwnedLaunch();
+				}
+				data = await this.studioPrepare(args[2]);
+				break;
+			case "record":
+				if (args.length < 4 || args.length > 5) {
+					refuseOwnedLaunch();
+				}
+				data = await this.studioRecord(args[2], args[3], args[4]);
+				break;
+			case "cleanup":
+				if (args.length !== 3) {
+					refuseOwnedLaunch();
+				}
+				data = await this.studioCleanup(args[2]);
+				break;
+			default:
+				refuseOwnedLaunch();
+		}
+		return {
+			content: [{ type: "text", text: JSON.stringify(data) }],
+			details: { resultCategory: "success", args, data },
+		};
+	}
+
+	async electron(
+		record: {
+			webSocketDebuggerUrl?: string | undefined;
+			pid?: number | undefined;
+			startIdentity?: string | undefined;
+			userDataDir: string;
+		},
+		targets: readonly { webSocketDebuggerUrl?: string | undefined }[],
+		token: string | undefined,
+	): Promise<void> {
+		if (
+			record.webSocketDebuggerUrl === undefined ||
+			record.startIdentity === undefined ||
+			record.pid === undefined ||
+			token === undefined
+		) {
+			refuseOwnedLaunch();
+		}
+		const launch: Launch = {
+			endpoint: record.webSocketDebuggerUrl,
+			pid: record.pid,
+			start: record.startIdentity,
+			profile: record.userDataDir,
+			token,
+			kind: "electron",
+			sessions: [],
+			targets: targets.flatMap((target) =>
+				target.webSocketDebuggerUrl !== undefined ? [target.webSocketDebuggerUrl] : [],
+			),
+		};
+		if (!(await this.live(launch)) || (await this.records()).length >= 128) {
+			refuseOwnedLaunch();
+		}
+		await this.save(launch);
+	}
+}
