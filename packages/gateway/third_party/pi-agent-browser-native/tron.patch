diff --git a/extensions/agent-browser/lib/owned-browser.ts b/extensions/agent-browser/lib/owned-browser.ts
new file mode 100644
index 0000000..79d22c7
--- /dev/null
+++ b/extensions/agent-browser/lib/owned-browser.ts
@@ -0,0 +1,421 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import { join, dirname, resolve } from "node:path";
+import { randomUUID } from "node:crypto";
+import { parseArgvDescriptor } from "./argv-descriptor.js";
+import { needsManagedSession } from "./command-policy.js";
+import {
+	extractExplicitSessionName,
+	scanUpstreamGlobalFlagOccurrences,
+	getAutoConnectFlagValue,
+	isUpstreamEnvFlagEnabled,
+} from "./argv-grammar.js";
+import { getUpstreamEffectiveBatchSteps } from "./orchestration/batch-stdin.js";
+import { withAgentBrowserProcessEnvironment } from "./process-environment.js";
+import { isRecord } from "./parsing.js";
+import type { ProcessRunResult } from "./process-child.js";
+import { OwnedLaunches, refuseOwnedLaunch as refuse, type Launch } from "./owned-launches.js";
+
+const context = new AsyncLocalStorage<OwnedBrowser>();
+
+const query = new AsyncLocalStorage<boolean>();
+
+export const currentOwnedBrowser = (): OwnedBrowser | undefined => context.getStore();
+
+interface Prepared {
+	readonly args: readonly string[];
+	readonly env: NodeJS.ProcessEnv;
+	readonly token?: string;
+	readonly attached?: Launch;
+	readonly session: string;
+	readonly root?: true;
+}
+
+interface Execution {
+	readonly args: readonly string[];
+	readonly env: NodeJS.ProcessEnv;
+	readonly stdin?: string | undefined;
+	readonly run: (args: readonly string[], env: NodeJS.ProcessEnv) => Promise<ProcessRunResult>;
+	readonly endpoint: () => Promise<ProcessRunResult>;
+}
+
+const flag = (args: readonly string[], name: string): string | undefined =>
+	scanUpstreamGlobalFlagOccurrences(args, name).at(-1)?.value;
+
+const tokens = (args: readonly string[]): readonly string[] =>
+	parseArgvDescriptor(args).upstreamCommandTokens;
+
+function metadata(args: readonly string[], stdin?: string): boolean {
+	return (
+		["--help", "-h", "--version", "-V"].some((value) => args.includes(value)) ||
+		query.getStore() === true ||
+		(!needsManagedSession(parseArgvDescriptor(args), stdin) && !cdpInspection(args))
+	);
+}
+
+const present = (value: unknown): boolean => value !== undefined;
+
+function resultData(stdout: string): Record<string, unknown> | undefined {
+	const value: unknown = JSON.parse(stdout);
+	return isRecord(value) && value.success === true && isRecord(value.data) ? value.data : undefined;
+}
+
+function cdpInspection(args: readonly string[]): boolean {
+	return tokens(args).slice(0, 2).join(" ") === "get cdp-url";
+}
+
+function configurationOverride(args: readonly string[], nested: boolean): boolean {
+	const hidden = [
+		flag(args, "--config"),
+		flag(args, "--cdp"),
+		tokens(args)[0] === "connect" ? "connect" : undefined,
+	];
+	return (nested && hidden.some(present)) || getAutoConnectFlagValue(args) === true;
+}
+
+function dangerousCommand(args: readonly string[]): boolean {
+	const command = tokens(args).slice(0, 2).join(" ");
+	return [
+		"profile",
+		"profiles",
+		"flow run",
+		"plugin run",
+		"state load",
+		"inspect",
+		"dashboard",
+		"chat",
+	].some((value) => command === value || command.startsWith(`${value} `));
+}
+
+function customLaunchArgs(value: unknown): void {
+	if (
+		value !== undefined &&
+		(typeof value !== "string" ||
+			/--(?:user-data-dir|profile-directory|remote-debugging)/.test(value))
+	) {
+		refuse();
+	}
+}
+
+function nonceArgs(
+	args: readonly string[],
+	env: NodeJS.ProcessEnv,
+	token: string,
+): readonly string[] {
+	const occurrence = scanUpstreamGlobalFlagOccurrences(args, "--args").at(-1);
+	const value = `${occurrence?.value ?? env.AGENT_BROWSER_ARGS ?? ""},--tron-owned-launch=${token}`;
+	const changed = [...args];
+	if (occurrence) {
+		if ((args[occurrence.index] ?? "").startsWith("--args=")) {
+			changed[occurrence.index] = `--args=${value}`;
+		} else {
+			changed[occurrence.index + 1] = value;
+		}
+	} else {
+		changed.unshift("--args", value);
+	}
+	return changed;
+}
+
+function sessionIdentity(args: readonly string[], env: NodeJS.ProcessEnv): string {
+	return `${flag(args, "--namespace") ?? env.AGENT_BROWSER_NAMESPACE ?? ""}:${extractExplicitSessionName(args) ?? env.AGENT_BROWSER_SESSION ?? "default"}`;
+}
+
+export class OwnedBrowser {
+	readonly store: OwnedLaunches;
+	constructor(
+		profile: string,
+		readonly engineExecutable?: string,
+	) {
+		this.store = new OwnedLaunches(profile);
+	}
+	async run<T>(run: () => Promise<T>, signal?: AbortSignal): Promise<T> {
+		if (context.getStore() === this) {
+			return run();
+		}
+		const lock = await this.store.lock(signal);
+		try {
+			return await context.run(this, () =>
+				withAgentBrowserProcessEnvironment(
+					{
+						HOME: join(dirname(this.store.profile), "home"),
+						AGENT_BROWSER_SOCKET_DIR: this.store.socketDir,
+						PI_AGENT_BROWSER_SOCKET_DIR: this.store.socketDir,
+					},
+					run,
+				),
+			);
+		} finally {
+			await lock.release();
+		}
+	}
+
+	private profileSetting(value: unknown): void {
+		if (
+			value !== undefined &&
+			(typeof value !== "string" || resolve(value) !== this.store.profile)
+		) {
+			refuse();
+		}
+	}
+
+	async settings(
+		args: readonly string[],
+		env: NodeJS.ProcessEnv,
+		defaults: Readonly<Record<string, unknown>>,
+	): Promise<void> {
+		const automatic = [
+			getAutoConnectFlagValue(args) === true,
+			isUpstreamEnvFlagEnabled(env.AGENT_BROWSER_AUTO_CONNECT),
+			defaults.autoConnect === true,
+		];
+		if (automatic.some((value) => value)) {
+			refuse();
+		}
+		for (const value of [flag(args, "--cdp"), env.AGENT_BROWSER_CDP, defaults.cdp]) {
+			if (value !== undefined) {
+				if (typeof value !== "string") {
+					refuse();
+				}
+				await this.store.recorded(value);
+			}
+		}
+		for (const value of [flag(args, "--profile"), env.AGENT_BROWSER_PROFILE, defaults.profile]) {
+			this.profileSetting(value);
+		}
+		for (const value of [flag(args, "--args"), env.AGENT_BROWSER_ARGS, defaults.args]) {
+			customLaunchArgs(value);
+		}
+		if (
+			[flag(args, "--engine"), env.AGENT_BROWSER_ENGINE, defaults.engine].some(
+				(value) => value !== undefined && value !== "chrome",
+			)
+		) {
+			refuse();
+		}
+		const external = [
+			flag(args, "--provider"),
+			flag(args, "-p"),
+			env.AGENT_BROWSER_PROVIDER,
+			defaults.provider,
+			flag(args, "--state"),
+			env.AGENT_BROWSER_STATE,
+			defaults.state,
+		];
+		if (external.some(present)) {
+			refuse();
+		}
+	}
+
+	private async validate(args: readonly string[], stdin?: string, nested = false): Promise<void> {
+		if (dangerousCommand(args) || flag(args, "--state") !== undefined) {
+			refuse();
+		}
+		if (configurationOverride(args, nested)) {
+			refuse();
+		}
+		this.profileSetting(flag(args, "--profile"));
+		customLaunchArgs(flag(args, "--args"));
+		const command = tokens(args);
+		const endpoint = command[0] === "connect" ? command[1] : flag(args, "--cdp");
+		if (endpoint !== undefined) {
+			await this.store.recorded(endpoint);
+		}
+		const steps = getUpstreamEffectiveBatchSteps(command, stdin);
+		if (command[0] === "batch" && steps.length === 0) {
+			refuse();
+		}
+		for (const step of steps) {
+			await this.validate(step, undefined, true);
+		}
+	}
+
+	private async target(
+		args: readonly string[],
+		env: NodeJS.ProcessEnv,
+		session: string,
+	): Promise<Launch | undefined> {
+		const command = tokens(args);
+		const endpoint =
+			flag(args, "--cdp") ??
+			env.AGENT_BROWSER_CDP ??
+			(command[0] === "connect" ? command[1] : undefined);
+		if (endpoint !== undefined) {
+			return this.store.recorded(endpoint);
+		}
+		const launches = await this.store.active();
+		const known = launches.find((item) => item.sessions.includes(session));
+		if (command[0] === "get" && command[1] === "cdp-url") {
+			return known ?? refuse();
+		}
+		return known;
+	}
+
+	private local(
+		args: readonly string[],
+		env: NodeJS.ProcessEnv,
+		session: string,
+		primary?: Launch,
+	): Prepared {
+		const token = primary?.token ?? randomUUID();
+		return {
+			args: nonceArgs(args, env, token),
+			env: {
+				...env,
+				AGENT_BROWSER_PROFILE: this.store.profile,
+				AGENT_BROWSER_RESTORE: this.store.session,
+				AGENT_BROWSER_AUTO_CONNECT: "0",
+			},
+			token,
+			session,
+		};
+	}
+
+	private async prepare(
+		args: readonly string[],
+		env: NodeJS.ProcessEnv,
+		stdin?: string,
+	): Promise<Prepared> {
+		await this.validate(args, stdin);
+		const session = sessionIdentity(args, env);
+		if (metadata(args, stdin)) {
+			return { args, env, session };
+		}
+		const command = tokens(args)[0];
+		if (["close", "quit", "exit"].includes(command ?? "")) {
+			return { args, env, session };
+		}
+		const known = await this.target(args, env, session);
+		if (known && known.master !== session) {
+			return { args, env, session, attached: known };
+		}
+		if (known && cdpInspection(args)) {
+			return { args, env, session, attached: known };
+		}
+		const primary = (await this.store.active()).find((item) => item.kind === "web");
+		return this.launchPlan(args, env, session, primary);
+	}
+
+	private launchPlan(
+		args: readonly string[],
+		env: NodeJS.ProcessEnv,
+		session: string,
+		primary: Launch | undefined,
+	): Prepared {
+		if (primary && primary.master !== session) {
+			return {
+				args,
+				env: { ...env, AGENT_BROWSER_CDP: primary.endpoint },
+				session,
+				attached: primary,
+			};
+		}
+		if (!primary && session !== `:${this.store.session}`) {
+			return { args, env, session, root: true };
+		}
+		return this.local(args, env, session, primary);
+	}
+
+	private async admit(options: Execution): Promise<Prepared | ProcessRunResult> {
+		try {
+			const prepared = await this.prepare(options.args, options.env, options.stdin);
+			if (!prepared.root) {
+				return prepared;
+			}
+			return (
+				(await this.launchRoot(options)) ??
+				(await this.prepare(options.args, options.env, options.stdin))
+			);
+		} catch (error) {
+			return {
+				aborted: false,
+				agentBrowserStarted: false,
+				exitCode: 1,
+				spawnError: new Error(String(error)),
+				stderr: "",
+				stdout: "",
+				timedOut: false,
+			};
+		}
+	}
+
+	private async launchRoot(options: Execution): Promise<ProcessRunResult | undefined> {
+		const {
+			AGENT_BROWSER_NAMESPACE: _namespace,
+			AGENT_BROWSER_SESSION: _session,
+			AGENT_BROWSER_CDP: _cdp,
+			...env
+		} = options.env;
+		const session = ["--session", this.store.session];
+		const launch = this.local([...session, "open", "about:blank"], env, `:${this.store.session}`);
+		const result = await options.run(launch.args, launch.env);
+		if (!result.agentBrowserStarted || result.aborted || result.timedOut || result.exitCode !== 0) {
+			return result;
+		}
+		const endpoint = await options.run([...session, "--json", "get", "cdp-url"], launch.env);
+		const observed = resultData(endpoint.stdout);
+		if (
+			endpoint.exitCode !== 0 ||
+			typeof observed?.cdpUrl !== "string" ||
+			launch.token === undefined
+		) {
+			refuse();
+		}
+		await this.store.launched(launch.session, launch.token, observed.cdpUrl);
+		return undefined;
+	}
+
+	private async result(
+		prepared: Prepared,
+		stdout: string,
+		endpoint: () => Promise<ProcessRunResult>,
+	): Promise<void> {
+		if (prepared.attached) {
+			const data = resultData(stdout);
+			if (data) {
+				await this.store.connected(prepared.session, prepared.attached, data);
+			}
+			return;
+		}
+		if (prepared.token === undefined) {
+			return;
+		}
+		const result = await query.run(true, endpoint);
+		const observed = resultData(result.stdout);
+		if (result.exitCode !== 0 || typeof observed?.cdpUrl !== "string") {
+			refuse();
+		}
+		await this.store.launched(prepared.session, prepared.token, observed.cdpUrl);
+	}
+
+	async execute(options: Execution): Promise<ProcessRunResult> {
+		const prepared = await this.admit(options);
+		if (!("session" in prepared)) {
+			return prepared;
+		}
+		const result = await options.run(prepared.args, prepared.env);
+		if (!result.agentBrowserStarted || result.aborted || result.timedOut) {
+			return result;
+		}
+		try {
+			if (
+				result.exitCode === 0 &&
+				["close", "quit", "exit"].includes(tokens(options.args)[0] ?? "")
+			) {
+				await this.store.detached(prepared.session);
+			}
+			await this.result(prepared, result.stdout, options.endpoint);
+			return result;
+		} catch (error) {
+			if (result.exitCode !== 0) {
+				return result;
+			}
+			return {
+				...result,
+				exitCode: 1,
+				stdout: "",
+				stderr: String(error),
+				spawnError: new Error(String(error)),
+			};
+		}
+	}
+}
diff --git a/extensions/agent-browser/lib/owned-launches.ts b/extensions/agent-browser/lib/owned-launches.ts
new file mode 100644
index 0000000..1ea4800
--- /dev/null
+++ b/extensions/agent-browser/lib/owned-launches.ts
@@ -0,0 +1,456 @@
+import { execFile } from "node:child_process";
+import { randomUUID, createHash } from "node:crypto";
+import { mkdir, readFile, readdir, rename, rm, writeFile, lstat, realpath } from "node:fs/promises";
+import { dirname, join, resolve } from "node:path";
+import { promisify } from "node:util";
+import { Type, type Static } from "typebox";
+import { Check } from "typebox/value";
+import { readProcessStartIdentity } from "./process-identity.js";
+import {
+	acquireExecutionClaim,
+	type ManagedSessionPolicyLock,
+} from "./browser-execution-claims.js";
+
+interface OwnedCommandResult {
+	readonly content: Array<{ type: "text"; text: string }>;
+	readonly details: {
+		resultCategory: "success";
+		args: readonly string[];
+		data: Record<string, unknown>;
+	};
+}
+
+const execute = promisify(execFile);
+
+const launchSchema = Type.Object({
+	endpoint: Type.String(),
+	pid: Type.Integer({ minimum: 2 }),
+	start: Type.String({ minLength: 1 }),
+	profile: Type.String(),
+	token: Type.String({ minLength: 1 }),
+	targets: Type.Optional(Type.Array(Type.String(), { maxItems: 128 })),
+	kind: Type.Union([Type.Literal("web"), Type.Literal("electron"), Type.Literal("studio")]),
+	sessions: Type.Array(Type.String(), { maxItems: 128 }),
+	master: Type.Optional(Type.String()),
+});
+
+export type Launch = Static<typeof launchSchema>;
+
+export function refuseOwnedLaunch(): never {
+	throw new Error(
+		"owned_launch_required: endpoint requires a recorded Tron-owned launch; personal browser attachment and profile copying are unavailable",
+	);
+}
+
+function decodeLaunch(input: string): Launch {
+	const value: unknown = JSON.parse(input);
+	if (!Check(launchSchema, value)) {
+		refuseOwnedLaunch();
+	}
+	return value;
+}
+
+function address(value: string): URL {
+	const url = new URL(/^\d+$/.test(value) ? `http://127.0.0.1:${value}` : value);
+	const identity = [url.username, url.password, url.search, url.hash];
+	if (
+		url.hostname !== "127.0.0.1" ||
+		!["ws:", "http:"].includes(url.protocol) ||
+		url.port.length === 0 ||
+		identity.some((entry) => entry.length > 0)
+	) {
+		refuseOwnedLaunch();
+	}
+	return url;
+}
+
+function matches(value: string, launch: Launch): boolean {
+	const url = address(value),
+		recorded = address(launch.endpoint);
+	return (
+		url.port === recorded.port &&
+		([recorded.href, ...(launch.targets ?? [])].includes(url.href) ||
+			(url.protocol === "http:" && url.pathname === "/"))
+	);
+}
+
+async function studioEndpoint(profile: string): Promise<string> {
+	const [port, path] = (await readFile(join(profile, "DevToolsActivePort"), "utf8"))
+		.trim()
+		.split("\n");
+	if (
+		port === undefined ||
+		path === undefined ||
+		!/^\d+$/.test(port) ||
+		!/^\/devtools\/browser\/[^/]+$/.test(path)
+	) {
+		refuseOwnedLaunch();
+	}
+	return `ws://127.0.0.1:${port}${path}`;
+}
+
+async function listener(endpoint: string): Promise<number> {
+	const { stdout } = await execute(
+		"/usr/sbin/lsof",
+		["-nP", "-a", `-iTCP:${address(endpoint).port}`, "-sTCP:LISTEN", "-Fp"],
+		{ timeout: 5000 },
+	);
+	const pids = [
+		...new Set(
+			stdout
+				.split("\n")
+				.filter((line) => /^p\d+$/.test(line))
+				.map((line) => Number(line.slice(1))),
+		),
+	];
+	const pid = pids[0];
+	if (pids.length !== 1 || pid === undefined || pid <= 1) {
+		refuseOwnedLaunch();
+	}
+	return pid;
+}
+
+async function privateDirectory(path: string): Promise<void> {
+	await mkdir(path, { recursive: true, mode: 0o700 });
+	const stat = await lstat(path);
+	if (
+		!stat.isDirectory() ||
+		stat.isSymbolicLink() ||
+		stat.uid !== process.getuid?.() ||
+		(stat.mode & 0o077) !== 0
+	) {
+		refuseOwnedLaunch();
+	}
+}
+
+export class OwnedLaunches {
+	readonly profile: string;
+	readonly root: string;
+	readonly socketDir: string;
+	readonly session: string;
+	constructor(profile: string) {
+		this.profile = resolve(profile);
+		this.root = `${this.profile}.launches`;
+		this.session = `tron-${createHash("sha256").update(this.profile).digest("hex").slice(0, 16)}`;
+		this.socketDir = join("/tmp", `pi-owned-${process.getuid?.() ?? "user"}-${this.session}`);
+	}
+	async lock(signal?: AbortSignal): Promise<ManagedSessionPolicyLock> {
+		for (const path of [
+			this.root,
+			this.socketDir,
+			join(dirname(this.profile), "home"),
+			this.profile,
+		]) {
+			await privateDirectory(path);
+		}
+		const lock = await acquireExecutionClaim({
+			identity: { socketContext: await realpath(this.root), sessionNames: null },
+			signal,
+		});
+		if (!lock) {
+			throw new Error("Owned browser operation cancelled or its existing native claim is busy");
+		}
+		try {
+			await this.profileMarker();
+			return lock;
+		} catch (error) {
+			await lock.release();
+			throw error;
+		}
+	}
+
+	private async profileMarker(): Promise<void> {
+		const marker = join(this.profile, ".tron-owned-profile");
+		const files = await readdir(this.profile);
+		if (!files.includes(".tron-owned-profile")) {
+			if (files.length !== 0) {
+				refuseOwnedLaunch();
+			}
+			await writeFile(marker, randomUUID(), { mode: 0o600, flag: "wx" });
+		}
+		const stat = await lstat(marker);
+		if (
+			!stat.isFile() ||
+			stat.isSymbolicLink() ||
+			stat.uid !== process.getuid?.() ||
+			(stat.mode & 0o077) !== 0
+		) {
+			refuseOwnedLaunch();
+		}
+	}
+
+	private file(endpoint: string): string {
+		return join(this.root, `${address(endpoint).port}.json`);
+	}
+
+	private async save(launch: Launch): Promise<void> {
+		const temporary = join(this.root, `.${randomUUID()}`);
+		try {
+			await writeFile(temporary, JSON.stringify(launch), { mode: 0o600, flag: "wx" });
+			await rename(temporary, this.file(launch.endpoint));
+		} finally {
+			await rm(temporary, { force: true });
+		}
+	}
+
+	private async live(launch: Launch): Promise<boolean> {
+		const start = await readProcessStartIdentity(launch.pid);
+		if (start === undefined) {
+			try {
+				process.kill(launch.pid, 0);
+			} catch (error) {
+				if (error instanceof Error && "code" in error && error.code === "ESRCH") {
+					return false;
+				}
+				throw error;
+			}
+			throw new Error("Owned browser process identity is unavailable; launch receipt retained");
+		}
+		if (start !== launch.start) {
+			return false;
+		}
+		if ((await listener(launch.endpoint)) !== launch.pid) {
+			return false;
+		}
+		const { stdout } = await execute(
+			"/bin/ps",
+			["-ww", "-p", String(launch.pid), "-o", "command="],
+			{ timeout: 5000 },
+		);
+		const command = ` ${stdout.trim()} `;
+		if (
+			![launch.profile, await realpath(launch.profile)].some((profile) =>
+				command.includes(` --user-data-dir=${profile} `),
+			)
+		) {
+			return false;
+		}
+		return command.includes(` --tron-owned-launch=${launch.token} `);
+	}
+
+	private async records(): Promise<Launch[]> {
+		const names = (await readdir(this.root)).filter((name) => /^\d+\.json$/.test(name));
+		if (names.length > 128) {
+			refuseOwnedLaunch();
+		}
+		return Promise.all(
+			names.map(async (name) => decodeLaunch(await readFile(join(this.root, name), "utf8"))),
+		);
+	}
+
+	async active(): Promise<Launch[]> {
+		const result: Launch[] = [];
+		for (const launch of await this.records()) {
+			if (await this.live(launch)) {
+				result.push(launch);
+			} else if (launch.kind !== "studio") {
+				await rm(this.file(launch.endpoint));
+			}
+		}
+		return result;
+	}
+
+	async recorded(endpoint: string): Promise<Launch> {
+		const launch = (await this.active()).find((item) => matches(endpoint, item));
+		return launch ?? refuseOwnedLaunch();
+	}
+
+	async connected(session: string, launch: Launch, data: Record<string, unknown>): Promise<void> {
+		if (typeof data.cdpUrl === "string" && !matches(data.cdpUrl, launch)) {
+			refuseOwnedLaunch();
+		}
+		for (const entry of await this.active()) {
+			const owns = entry.endpoint === launch.endpoint;
+			if (owns === entry.sessions.includes(session)) {
+				continue;
+			}
+			const sessions = owns
+				? [...entry.sessions, session]
+				: entry.sessions.filter((item) => item !== session);
+			if (sessions.length > 128) {
+				refuseOwnedLaunch();
+			}
+			await this.save({ ...entry, sessions });
+		}
+	}
+
+	async detached(session: string): Promise<void> {
+		for (const launch of await this.active()) {
+			if (!launch.sessions.includes(session)) {
+				continue;
+			}
+			await this.save({ ...launch, sessions: launch.sessions.filter((item) => item !== session) });
+		}
+	}
+
+	async launched(session: string, token: string, endpoint: string): Promise<void> {
+		if (!/^\/devtools\/browser\/[^/]+$/.test(address(endpoint).pathname)) {
+			refuseOwnedLaunch();
+		}
+		const pid = await listener(endpoint);
+		const start = await readProcessStartIdentity(pid);
+		if (start === undefined) {
+			refuseOwnedLaunch();
+		}
+		const launch: Launch = {
+			endpoint,
+			pid,
+			start,
+			profile: this.profile,
+			token: token,
+			kind: "web",
+			sessions: [session],
+			master: session,
+		};
+		if (!(await this.live(launch))) {
+			refuseOwnedLaunch();
+		}
+		const prior = (await this.active()).find((item) => item.kind === "web");
+		if (prior && prior.endpoint !== endpoint) {
+			refuseOwnedLaunch();
+		}
+		await this.save({ ...launch, sessions: prior?.sessions ?? launch.sessions });
+	}
+
+	private async studioPrepare(): Promise<Record<string, unknown>> {
+		if ((await readdir(this.root)).filter((name) => name.startsWith("studio-")).length >= 128) {
+			refuseOwnedLaunch();
+		}
+		const token = randomUUID();
+		const profile = join(this.root, `studio-${token}`);
+		await mkdir(profile, { mode: 0o700 });
+		return {
+			launchId: token,
+			profile,
+			args: [
+				`--user-data-dir=${profile}`,
+				"--remote-debugging-port=0",
+				`--tron-owned-launch=${token}`,
+			],
+		};
+	}
+
+	private studioProfile(token: string | undefined): string {
+		if (token === undefined || !/^[a-f0-9-]{36}$/.test(token)) {
+			refuseOwnedLaunch();
+		}
+		return join(this.root, `studio-${token}`);
+	}
+
+	private async studioRecord(
+		token: string | undefined,
+		rawPid: string | undefined,
+	): Promise<Record<string, unknown>> {
+		const profile = this.studioProfile(token);
+		const pid = Number(rawPid);
+		if (!Number.isSafeInteger(pid) || pid <= 1) {
+			refuseOwnedLaunch();
+		}
+		const endpoint = await studioEndpoint(profile);
+		const start = await readProcessStartIdentity(pid);
+		if (start === undefined) {
+			refuseOwnedLaunch();
+		}
+		const launch: Launch = {
+			endpoint,
+			pid,
+			start,
+			profile,
+			token: token ?? refuseOwnedLaunch(),
+			kind: "studio",
+			sessions: [],
+		};
+		if (!(await this.live(launch)) || (await this.records()).length >= 128) {
+			refuseOwnedLaunch();
+		}
+		await this.save(launch);
+		return { endpoint: launch.endpoint, launchId: token };
+	}
+
+	private async studioCleanup(token: string | undefined): Promise<Record<string, unknown>> {
+		const path = this.studioProfile(token);
+		const profile = await realpath(path);
+		if (profile !== join(await realpath(this.root), `studio-${String(token)}`)) {
+			refuseOwnedLaunch();
+		}
+		const record = (await this.records()).find(
+			(item) => item.profile === path && item.token === token,
+		);
+		if (!record || (await readProcessStartIdentity(record.pid)) === record.start) {
+			refuseOwnedLaunch();
+		}
+		await rm(profile, { recursive: true });
+		await rm(this.file(record.endpoint));
+		return { cleaned: true };
+	}
+
+	async command(params: { args?: readonly string[] }): Promise<OwnedCommandResult | undefined> {
+		const args = params.args;
+		if (args?.[0] !== "owned-launch") {
+			return;
+		}
+		let data: Record<string, unknown>;
+		switch (args[1] ?? "") {
+			case "prepare":
+				if (args.length !== 2) {
+					refuseOwnedLaunch();
+				}
+				data = await this.studioPrepare();
+				break;
+			case "record":
+				if (args.length !== 4) {
+					refuseOwnedLaunch();
+				}
+				data = await this.studioRecord(args[2], args[3]);
+				break;
+			case "cleanup":
+				if (args.length !== 3) {
+					refuseOwnedLaunch();
+				}
+				data = await this.studioCleanup(args[2]);
+				break;
+			default:
+				refuseOwnedLaunch();
+		}
+		return {
+			content: [{ type: "text", text: JSON.stringify(data) }],
+			details: { resultCategory: "success", args, data },
+		};
+	}
+
+	async electron(
+		record: {
+			webSocketDebuggerUrl?: string | undefined;
+			pid?: number | undefined;
+			startIdentity?: string | undefined;
+			userDataDir: string;
+		},
+		targets: readonly { webSocketDebuggerUrl?: string | undefined }[],
+		token: string | undefined,
+	): Promise<void> {
+		if (
+			record.webSocketDebuggerUrl === undefined ||
+			record.startIdentity === undefined ||
+			record.pid === undefined ||
+			token === undefined
+		) {
+			refuseOwnedLaunch();
+		}
+		const launch: Launch = {
+			endpoint: record.webSocketDebuggerUrl,
+			pid: record.pid,
+			start: record.startIdentity,
+			profile: record.userDataDir,
+			token,
+			kind: "electron",
+			sessions: [],
+			targets: targets.flatMap((target) =>
+				target.webSocketDebuggerUrl !== undefined ? [target.webSocketDebuggerUrl] : [],
+			),
+		};
+		if (!(await this.live(launch)) || (await this.records()).length >= 128) {
+			refuseOwnedLaunch();
+		}
+		await this.save(launch);
+	}
+}
diff --git a/extensions/agent-browser/lib/process.ts b/extensions/agent-browser/lib/process.ts
index eacb0c1..07f00b1 100644
--- a/extensions/agent-browser/lib/process.ts
+++ b/extensions/agent-browser/lib/process.ts
@@ -1,0 +2 @@ import { AsyncLocalStorage } from "node:async_hooks";
+import { currentOwnedBrowser } from "./owned-browser.js";
@@ -312 +313 @@ export async function runAgentBrowserProcess(
-	return await runBrowserChild({
+	return runOwnedBrowserChild(options, {
@@ -330,0 +332,36 @@ export async function runAgentBrowserProcess(
+
+function ownedEndpointArgs(args: readonly string[]): string[] {
+	const flags = ["--session", "--namespace"].flatMap((flag) => {
+		const value = scanUpstreamGlobalFlagOccurrences(args, flag).at(-1)?.value;
+		return value === undefined ? [] : [flag, value];
+	});
+	return [...flags, "--json", "get", "cdp-url"];
+}
+
+function runOwnedBrowserChild(
+	options: AgentBrowserProcessOptions,
+	child: Parameters<typeof runBrowserChild>[0],
+): Promise<ProcessRunResult> {
+	const owner = currentOwnedBrowser();
+	if (owner === undefined) {
+		return runBrowserChild(child);
+	}
+	return owner.execute({
+		args: child.args,
+		env: { ...getAgentBrowserProcessEnvironment(), ...child.env },
+		stdin: options.stdin,
+		run: (args, env) =>
+			runBrowserChild({
+				...child,
+				args,
+				env,
+				stockLauncher: owner.engineExecutable ?? child.stockLauncher,
+			}),
+		endpoint: () =>
+			runAgentBrowserProcess({
+				...options,
+				args: ownedEndpointArgs(options.args),
+				stdin: undefined,
+			}),
+	});
+}
