diff --git a/extensions/agent-browser/lib/owned-browser.ts b/extensions/agent-browser/lib/owned-browser.ts
new file mode 100644
index 0000000..d2a3e43
--- /dev/null
+++ b/extensions/agent-browser/lib/owned-browser.ts
@@ -0,0 +1,436 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import { join, dirname, resolve } from "node:path";
+import { randomUUID } from "node:crypto";
+import { parseArgvDescriptor } from "./argv-descriptor.js";
+import { needsManagedSession } from "./command-policy.js";
+import {
+	extractExplicitSessionName,
+	scanUpstreamGlobalFlagOccurrences,
+	getAutoConnectFlagValue,
+	isUpstreamEnvFlagEnabled,
+} from "./argv-grammar.js";
+import { getUpstreamEffectiveBatchSteps } from "./orchestration/batch-stdin.js";
+import { withAgentBrowserProcessEnvironment } from "./process-environment.js";
+import { isRecord } from "./parsing.js";
+import type { ProcessRunResult } from "./process-child.js";
+import {
+	BACKGROUND_FLAGS,
+	OwnedLaunches,
+	refuseOwnedLaunch as refuse,
+	type Launch,
+} from "./owned-launches.js";
+
+const context = new AsyncLocalStorage<OwnedBrowser>();
+
+const query = new AsyncLocalStorage<boolean>();
+
+export const currentOwnedBrowser = (): OwnedBrowser | undefined => context.getStore();
+
+interface Prepared {
+	readonly args: readonly string[];
+	readonly env: NodeJS.ProcessEnv;
+	readonly token?: string;
+	readonly attached?: Launch;
+	readonly session: string;
+	readonly root?: true;
+}
+
+interface Execution {
+	readonly args: readonly string[];
+	readonly env: NodeJS.ProcessEnv;
+	readonly stdin?: string | undefined;
+	readonly run: (args: readonly string[], env: NodeJS.ProcessEnv) => Promise<ProcessRunResult>;
+	readonly endpoint: () => Promise<ProcessRunResult>;
+}
+
+const flag = (args: readonly string[], name: string): string | undefined =>
+	scanUpstreamGlobalFlagOccurrences(args, name).at(-1)?.value;
+
+const tokens = (args: readonly string[]): readonly string[] =>
+	parseArgvDescriptor(args).upstreamCommandTokens;
+
+function metadata(args: readonly string[], stdin?: string): boolean {
+	return (
+		["--help", "-h", "--version", "-V"].some((value) => args.includes(value)) ||
+		query.getStore() === true ||
+		(!needsManagedSession(parseArgvDescriptor(args), stdin) && !cdpInspection(args))
+	);
+}
+
+const present = (value: unknown): boolean => value !== undefined;
+
+function resultData(stdout: string): Record<string, unknown> | undefined {
+	const value: unknown = JSON.parse(stdout);
+	return isRecord(value) && value.success === true && isRecord(value.data) ? value.data : undefined;
+}
+
+function cdpInspection(args: readonly string[]): boolean {
+	return tokens(args).slice(0, 2).join(" ") === "get cdp-url";
+}
+
+function configurationOverride(args: readonly string[], nested: boolean): boolean {
+	const hidden = [
+		flag(args, "--config"),
+		flag(args, "--cdp"),
+		tokens(args)[0] === "connect" ? "connect" : undefined,
+	];
+	return (nested && hidden.some(present)) || getAutoConnectFlagValue(args) === true;
+}
+
+function unownedGuidance(args: readonly string[]): boolean {
+	const command = tokens(args);
+	return command[0] === "skills" && command.some((value) => value === "electron" || value === "--all");
+}
+
+function dangerousCommand(args: readonly string[]): boolean {
+	const command = tokens(args).slice(0, 2).join(" ");
+	return unownedGuidance(args) || [
+		"profile",
+		"profiles",
+		"flow run",
+		"plugin run",
+		"state load",
+		"inspect",
+		"dashboard",
+		"chat",
+	].some((value) => command === value || command.startsWith(`${value} `));
+}
+
+function customLaunchArgs(value: unknown): void {
+	if (
+		value !== undefined &&
+		(typeof value !== "string" ||
+			/--(?:user-data-dir|profile-directory|remote-debugging)/.test(value))
+	) {
+		refuse();
+	}
+}
+
+function nonceArgs(
+	args: readonly string[],
+	env: NodeJS.ProcessEnv,
+	token: string,
+): readonly string[] {
+	const occurrence = scanUpstreamGlobalFlagOccurrences(args, "--args").at(-1);
+	const value = [occurrence?.value ?? env.AGENT_BROWSER_ARGS ?? "", ...BACKGROUND_FLAGS, `--tron-owned-launch=${token}`].join(",");
+	const changed = [...args];
+	if (occurrence) {
+		if ((args[occurrence.index] ?? "").startsWith("--args=")) {
+			changed[occurrence.index] = `--args=${value}`;
+		} else {
+			changed[occurrence.index + 1] = value;
+		}
+	} else {
+		changed.unshift("--args", value);
+	}
+	return changed;
+}
+
+function sessionIdentity(args: readonly string[], env: NodeJS.ProcessEnv): string {
+	return `${flag(args, "--namespace") ?? env.AGENT_BROWSER_NAMESPACE ?? ""}:${extractExplicitSessionName(args) ?? env.AGENT_BROWSER_SESSION ?? "default"}`;
+}
+
+export class OwnedBrowser {
+	readonly store: OwnedLaunches;
+	constructor(
+		profile: string,
+		readonly engineExecutable?: string,
+	) {
+		this.store = new OwnedLaunches(profile);
+	}
+	async run<T>(run: () => Promise<T>, signal?: AbortSignal): Promise<T> {
+		if (context.getStore() === this) {
+			return run();
+		}
+		const lock = await this.store.lock(signal);
+		try {
+			return await context.run(this, () =>
+				withAgentBrowserProcessEnvironment(
+					{
+						HOME: join(dirname(this.store.profile), "home"),
+						AGENT_BROWSER_SOCKET_DIR: this.store.socketDir,
+						PI_AGENT_BROWSER_SOCKET_DIR: this.store.socketDir,
+					},
+					run,
+				),
+			);
+		} finally {
+			await lock.release();
+		}
+	}
+
+	private profileSetting(value: unknown): void {
+		if (
+			value !== undefined &&
+			(typeof value !== "string" || resolve(value) !== this.store.profile)
+		) {
+			refuse();
+		}
+	}
+
+	async settings(
+		args: readonly string[],
+		env: NodeJS.ProcessEnv,
+		defaults: Readonly<Record<string, unknown>>,
+	): Promise<void> {
+		const automatic = [
+			getAutoConnectFlagValue(args) === true,
+			isUpstreamEnvFlagEnabled(env.AGENT_BROWSER_AUTO_CONNECT),
+			defaults.autoConnect === true,
+		];
+		if (automatic.some((value) => value)) {
+			refuse();
+		}
+		for (const value of [flag(args, "--cdp"), env.AGENT_BROWSER_CDP, defaults.cdp]) {
+			if (value !== undefined) {
+				if (typeof value !== "string") {
+					refuse();
+				}
+				await this.store.recorded(value);
+			}
+		}
+		for (const value of [flag(args, "--profile"), env.AGENT_BROWSER_PROFILE, defaults.profile]) {
+			this.profileSetting(value);
+		}
+		for (const value of [flag(args, "--args"), env.AGENT_BROWSER_ARGS, defaults.args]) {
+			customLaunchArgs(value);
+		}
+		if (
+			[flag(args, "--engine"), env.AGENT_BROWSER_ENGINE, defaults.engine].some(
+				(value) => value !== undefined && value !== "chrome",
+			)
+		) {
+			refuse();
+		}
+		const external = [
+			flag(args, "--provider"),
+			flag(args, "-p"),
+			env.AGENT_BROWSER_PROVIDER,
+			defaults.provider,
+			flag(args, "--state"),
+			env.AGENT_BROWSER_STATE,
+			defaults.state,
+		];
+		if (external.some(present)) {
+			refuse();
+		}
+	}
+
+	private async validate(args: readonly string[], stdin?: string, nested = false): Promise<void> {
+		if (dangerousCommand(args) || flag(args, "--state") !== undefined) {
+			refuse();
+		}
+		if (configurationOverride(args, nested)) {
+			refuse();
+		}
+		this.profileSetting(flag(args, "--profile"));
+		customLaunchArgs(flag(args, "--args"));
+		const command = tokens(args);
+		const endpoint = command[0] === "connect" ? command[1] : flag(args, "--cdp");
+		if (endpoint !== undefined) {
+			await this.store.recorded(endpoint);
+		}
+		const steps = getUpstreamEffectiveBatchSteps(command, stdin);
+		if (command[0] === "batch" && steps.length === 0) {
+			refuse();
+		}
+		for (const step of steps) {
+			await this.validate(step, undefined, true);
+		}
+	}
+
+	private async target(
+		args: readonly string[],
+		env: NodeJS.ProcessEnv,
+		session: string,
+	): Promise<Launch | undefined> {
+		const command = tokens(args);
+		const endpoint =
+			flag(args, "--cdp") ??
+			env.AGENT_BROWSER_CDP ??
+			(command[0] === "connect" ? command[1] : undefined);
+		if (endpoint !== undefined) {
+			return this.store.recorded(endpoint);
+		}
+		const launches = await this.store.active();
+		const known = launches.find((item) => item.sessions.includes(session));
+		if (command[0] === "get" && command[1] === "cdp-url") {
+			return known ?? refuse();
+		}
+		return known;
+	}
+
+	private local(
+		args: readonly string[],
+		env: NodeJS.ProcessEnv,
+		session: string,
+		primary?: Launch,
+	): Prepared {
+		const token = primary?.token ?? randomUUID();
+		return {
+			args: nonceArgs(args, env, token),
+			env: {
+				...env,
+				AGENT_BROWSER_PROFILE: this.store.profile,
+				AGENT_BROWSER_RESTORE: this.store.session,
+				AGENT_BROWSER_AUTO_CONNECT: "0",
+			},
+			token,
+			session,
+		};
+	}
+
+	private async prepare(
+		args: readonly string[],
+		env: NodeJS.ProcessEnv,
+		stdin?: string,
+	): Promise<Prepared> {
+		await this.validate(args, stdin);
+		const session = sessionIdentity(args, env);
+		if (metadata(args, stdin)) {
+			return { args, env, session };
+		}
+		const command = tokens(args)[0];
+		if (["close", "quit", "exit"].includes(command ?? "")) {
+			return { args, env, session };
+		}
+		const known = await this.target(args, env, session);
+		if (known && known.master !== session) {
+			return { args, env: { ...env, AGENT_BROWSER_CDP: known.endpoint }, session, attached: known };
+		}
+		if (known && cdpInspection(args)) {
+			return { args, env, session, attached: known };
+		}
+		const primary = (await this.store.active()).find((item) => item.kind === "web");
+		return this.launchPlan(args, env, session, primary);
+	}
+
+	private launchPlan(
+		args: readonly string[],
+		env: NodeJS.ProcessEnv,
+		session: string,
+		primary: Launch | undefined,
+	): Prepared {
+		if (primary && primary.master !== session) {
+			return {
+				args,
+				env: { ...env, AGENT_BROWSER_CDP: primary.endpoint },
+				session,
+				attached: primary,
+			};
+		}
+		if (!primary && session !== `:${this.store.session}`) {
+			return { args, env, session, root: true };
+		}
+		return this.local(args, env, session, primary);
+	}
+
+	private async admit(options: Execution): Promise<Prepared | ProcessRunResult> {
+		try {
+			const prepared = await this.prepare(options.args, options.env, options.stdin);
+			if (!prepared.root) {
+				return prepared;
+			}
+			const launched = await this.launchRoot(options);
+			if (launched) {
+				return launched;
+			}
+			const replanned = await this.prepare(options.args, options.env, options.stdin);
+			if (replanned.root) {
+				refuse();
+			}
+			return replanned;
+		} catch (error) {
+			return {
+				aborted: false,
+				agentBrowserStarted: false,
+				exitCode: 1,
+				spawnError: new Error(String(error)),
+				stderr: "",
+				stdout: "",
+				timedOut: false,
+			};
+		}
+	}
+
+	private async launchRoot(options: Execution): Promise<ProcessRunResult | undefined> {
+		const {
+			AGENT_BROWSER_NAMESPACE: _namespace,
+			AGENT_BROWSER_SESSION: _session,
+			AGENT_BROWSER_CDP: _cdp,
+			...env
+		} = options.env;
+		const session = ["--session", this.store.session];
+		const launch = this.local([...session, "open", "about:blank"], env, `:${this.store.session}`);
+		const result = await options.run(launch.args, launch.env);
+		if (!result.agentBrowserStarted || result.aborted || result.timedOut || result.exitCode !== 0) {
+			return result;
+		}
+		const endpoint = await options.run([...session, "--json", "get", "cdp-url"], launch.env);
+		const observed = resultData(endpoint.stdout);
+		if (
+			endpoint.exitCode !== 0 ||
+			typeof observed?.cdpUrl !== "string" ||
+			launch.token === undefined
+		) {
+			refuse();
+		}
+		await this.store.launched(launch.session, launch.token, observed.cdpUrl);
+		return undefined;
+	}
+
+	private async result(
+		prepared: Prepared,
+		stdout: string,
+		endpoint: () => Promise<ProcessRunResult>,
+	): Promise<void> {
+		if (prepared.attached) {
+			const data = resultData(stdout);
+			if (data) {
+				await this.store.connected(prepared.session, prepared.attached, data);
+			}
+			return;
+		}
+		if (prepared.token === undefined) {
+			return;
+		}
+		const result = await query.run(true, endpoint);
+		const observed = resultData(result.stdout);
+		if (result.exitCode !== 0 || typeof observed?.cdpUrl !== "string") {
+			refuse();
+		}
+		await this.store.launched(prepared.session, prepared.token, observed.cdpUrl);
+	}
+
+	async execute(options: Execution): Promise<ProcessRunResult> {
+		const prepared = await this.admit(options);
+		if (!("session" in prepared)) {
+			return prepared;
+		}
+		const result = await options.run(prepared.args, prepared.env);
+		if (!result.agentBrowserStarted || result.aborted || result.timedOut) {
+			return result;
+		}
+		try {
+			if (
+				result.exitCode === 0 &&
+				["close", "quit", "exit"].includes(tokens(options.args)[0] ?? "")
+			) {
+				await this.store.detached(prepared.session);
+			}
+			await this.result(prepared, result.stdout, options.endpoint);
+			return result;
+		} catch (error) {
+			if (result.exitCode !== 0) {
+				return result;
+			}
+			return {
+				...result,
+				exitCode: 1,
+				stdout: "",
+				stderr: String(error),
+				spawnError: new Error(String(error)),
+			};
+		}
+	}
+}
