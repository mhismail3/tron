diff --git a/packages/coding-agent/test/suite/regressions/aborted-display-only-outcome.test.ts b/packages/coding-agent/test/suite/regressions/aborted-display-only-outcome.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..92243cdc428f645e1c4cbff1c7138809307c9ee9
--- /dev/null
+++ b/packages/coding-agent/test/suite/regressions/aborted-display-only-outcome.test.ts
@@ -0,0 +1,89 @@
+import type { Context } from "@earendil-works/pi-ai";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it } from "vitest";
+import { createHarness, type Harness } from "../harness.ts";
+
+// Tron: a provider that runs its own tools reports each one as a call of a display-only tool. When the
+// user cancels, the response ends aborted, and Pi recorded no result for any of its calls, so clients
+// showed calls that had finished as failed. A tool's settleAborted now records the outcome a call already
+// reached; unfinished calls and other tools stay without a result (interrupted), nothing executes, and
+// none of it reaches the next request.
+describe("aborted response with display-only tool calls", () => {
+	const harnesses: Harness[] = [];
+	afterEach(() => {
+		while (harnesses.length > 0) harnesses.pop()?.cleanup();
+	});
+
+	it("records each display-only outcome and keeps them out of the next request", async () => {
+		const ran: string[] = [];
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerTool({
+						name: "shown",
+						label: "Shown",
+						description: "Shows a call made elsewhere",
+						parameters: Type.Object({ state: Type.String() }),
+						execute: async () => {
+							ran.push("shown");
+							return { content: [], details: {} };
+						},
+						settleAborted: (_id, params) =>
+							params.state === "running"
+								? undefined
+								: {
+										content: [{ type: "text", text: `reported ${params.state}` }],
+										details: { status: params.state },
+										isError: params.state === "failed",
+									},
+					});
+					pi.registerTool({
+						name: "real",
+						label: "Real",
+						description: "Does work",
+						parameters: Type.Object({}),
+						execute: async () => {
+							ran.push("real");
+							return { content: [{ type: "text", text: "ran" }], details: {} };
+						},
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		let nextContext: Context | undefined;
+		harness.setResponses([
+			fauxAssistantMessage(
+				[
+					fauxToolCall("shown", { state: "completed" }, { id: "done-1" }),
+					fauxToolCall("shown", { state: "failed" }, { id: "failed-1" }),
+					fauxToolCall("shown", { state: "running" }, { id: "running-1" }),
+					fauxToolCall("real", {}, { id: "real-1" }),
+				],
+				{ stopReason: "aborted", errorMessage: "Request was aborted" },
+			),
+			(context) => {
+				nextContext = context;
+				return fauxAssistantMessage("next");
+			},
+		]);
+
+		await harness.session.prompt("first");
+		const results = harness.session.messages.filter((message) => message.role === "toolResult");
+		expect(results.map((result) => [result.toolCallId, result.isError, result.content])).toEqual([
+			["done-1", false, [{ type: "text", text: "reported completed" }]],
+			["failed-1", true, [{ type: "text", text: "reported failed" }]],
+		]);
+		expect(ran).toEqual([]);
+		const persisted = harness.sessionManager
+			.getBranch()
+			.flatMap((entry) =>
+				entry.type === "message" && entry.message.role === "toolResult" ? [entry.message.toolCallId] : [],
+			);
+		expect(persisted).toEqual(["done-1", "failed-1"]);
+
+		await harness.session.prompt("second");
+		expect(nextContext?.messages.some((message) => message.role === "toolResult")).toBe(false);
+	});
+});
diff --git a/packages/coding-agent/test/suite/regressions/preflight-started-revoke.test.ts b/packages/coding-agent/test/suite/regressions/preflight-started-revoke.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..199f0930c9bd13c8d16bfafc02d97b2e2f4d399a
--- /dev/null
+++ b/packages/coding-agent/test/suite/regressions/preflight-started-revoke.test.ts
@@ -0,0 +1,42 @@
+import { fauxAssistantMessage } from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it } from "vitest";
+import { createHarness, getUserTexts, type Harness } from "../harness.ts";
+
+// Tron: a host revokes an accepted prompt by throwing from preflightResult("started"),
+// for example when Stop arrived while the run was being prepared. The revoked
+// prompt must not start or be appended, and the session must return to idle so
+// a waiting abort() settles.
+describe("preflightResult('started') revocation", () => {
+	const harnesses: Harness[] = [];
+	afterEach(() => {
+		while (harnesses.length > 0) harnesses.pop()?.cleanup();
+	});
+
+	it("ends the start without a run when the host throws", async () => {
+		const harness = await createHarness();
+		harnesses.push(harness);
+		harness.setResponses([
+			() => {
+				throw new Error("a revoked prompt must never reach the provider");
+			},
+			fauxAssistantMessage("later answer"),
+		]);
+		const revoked = new Error("revoked before agent admission");
+		await expect(
+			harness.session.prompt("REVOKED", {
+				preflightResult: (disposition) => {
+					if (disposition === "started") throw revoked;
+				},
+			}),
+		).rejects.toBe(revoked);
+		expect(harness.session.isStreaming).toBe(false);
+		expect(harness.session.isIdle).toBe(true);
+		await harness.session.abort();
+		expect(getUserTexts(harness)).not.toContain("REVOKED");
+		expect(harness.eventsOfType("agent_start")).toHaveLength(0);
+
+		harness.setResponses([fauxAssistantMessage("later answer")]);
+		await harness.session.prompt("LATER");
+		expect(getUserTexts(harness)).toEqual(["LATER"]);
+	});
+});
