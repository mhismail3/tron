{
  "version": 2,
  "paths": {
    "agent": {"owner": "pi-sdk", "class": "keep", "container": true},
    "agent/sessions": {"owner": "pi-sdk", "subtree": true},
    "agent/AGENTS.md": {"owner": "pi-sdk"},
    "agent/settings.json": {"owner": "gateway/admin"},
    "agent/models.json": {"owner": "gateway/admin"},
    "agent/models-store.json": {"owner": "gateway/providers", "class": "rebuild"},
    "agent/mcp.json": {"owner": "gateway/admin"},
    "agent/mcp.log": {"owner": "gateway/host", "class": "log"},
    "agent/trust.json": {"owner": "gateway/admin"},
    "agent/auth.json": {"owner": "gateway/providers", "credential": true},
    "agent/agents": {"owner": "pi-subagents", "subtree": true},
    "agent/profiles": {"owner": "pi-subagents", "subtree": true},
    "agent/prompts": {"owner": "pi-sdk", "subtree": true},
    "agent/skills": {"owner": "pi-sdk", "subtree": true},
    "agent/missions": {"owner": "pi-subagents", "subtree": true, "prune": {"keepNewest": 200, "when": "terminal missions"}},
    "agent/run-history.jsonl": {"owner": "pi-subagents", "class": "log", "prune": {"maxEntries": 1000}},
    "agent/npm": {"owner": "pi-sdk", "class": "rebuild", "subtree": true, "prune": {"when": "replaced on install"}},
    "agent/git": {"owner": "pi-sdk", "class": "rebuild", "subtree": true, "prune": {"when": "replaced on install"}},
    "agent/bin": {"owner": "pi-sdk", "class": "rebuild", "subtree": true, "prune": {"when": "replaced on install"}},
    "agent/extensions": {"owner": "pi-sdk", "subtree": true},
    "agent/web-search-cache": {"owner": "extension pi-web-access", "class": "rebuild", "subtree": true, "prune": {"maxAge": "1h", "maxEntries": 128, "maxBytes": 134217728}},
    "agent/.tron-gateway-runtime.lock.lock": {"owner": "gateway/session-catalog", "class": "scratch", "subtree": true, "prune": {"when": "released when its holder exits; stale after 60 s"}},

    "gateway": {"owner": "gateway/foundation", "class": "keep", "container": true},
    "gateway/gateway.json": {"owner": "gateway/foundation"},
    "gateway/local-auth.json": {"owner": "gateway/security", "backup": false, "credential": true},
    "gateway/enrollment.json": {"owner": "gateway/security", "backup": false, "credential": true},
    "gateway/devices.json": {"owner": "gateway/security", "credential": true},
    "gateway/notifications.json": {"owner": "gateway/notifications", "prune": {"maxBytes": 1048576, "when": "grant-store caps: 64 grants, 512 receipts"}},
    "gateway/lan-endpoint": {"owner": "gateway/transport", "credential": true, "subtree": true},
    "gateway/network.json": {"owner": "mac-app/server", "class": "rebuild"},
    "gateway/stop-completed.json": {"owner": "gateway/gateway-main", "class": "scratch"},
    "gateway/update-config.json": {"owner": "gateway/admin"},
    "gateway/payloads": {"owner": "gateway/admin", "backup": false, "subtree": true, "prune": {"when": "current plus the retired rollback set"}},
    "gateway/ios-device-installs": {"owner": "gateway/admin", "subtree": true},
    "gateway/home": {"owner": "gateway/home", "container": true},
    "gateway/home/home.json": {"owner": "gateway/home"},
    "gateway/home/profile.json": {"owner": "gateway/admin"},
    "gateway/home/tasks": {"owner": "gateway/home", "subtree": true},
    "gateway/home/workspace": {"owner": "gateway/home", "subtree": true},
    "gateway/settings": {"owner": "gateway/settings", "container": true},
    "gateway/settings/changes": {"owner": "gateway/settings", "subtree": true},
    "gateway/settings/observed.json": {"owner": "gateway/admin"},
    "gateway/settings/gateway.json": {"owner": "gateway/admin"},
    "gateway/model-usage.json": {"owner": "gateway/providers", "prune": {"maxAge": "30d", "maxEntries": 10000, "maxBytes": 8388608}},
    "gateway/model-queue.json": {"owner": "gateway/providers", "class": "rebuild"},
    "gateway/model-queue-sessions": {"owner": "gateway/providers", "class": "scratch", "subtree": true, "prune": {"when": "its session's queue retires"}},
    "gateway/model-recents.json": {"owner": "gateway/providers", "prune": {"maxEntries": 12}},
    "gateway/model-release-dates.json": {"owner": "gateway/providers", "class": "rebuild"},
    "gateway/automations": {"owner": "gateway/automations", "subtree": true},
    "gateway/integrations": {"owner": "gateway/integrations", "subtree": true},
    "gateway/session-search.sqlite": {"owner": "gateway/session-search", "class": "rebuild"},
    "gateway/session-search.sqlite-*": {"owner": "gateway/session-search", "class": "scratch"},
    "gateway/catalog-metadata-v3": {"owner": "gateway/session-catalog", "class": "rebuild", "subtree": true, "prune": {"when": "manifest-driven shards"}},
    "gateway/session-archive.json": {"owner": "gateway/session-catalog", "prune": {"when": "pruned to existing sessions"}},
    "gateway/session-attention.json": {"owner": "gateway/projection", "prune": {"when": "pruned to existing sessions"}},
    "gateway/command-receipts": {"owner": "gateway/transport", "class": "scratch", "subtree": true, "prune": {"maxAge": "24h", "maxEntries": 32768, "maxBytes": 67108864}},
    "gateway/runtime-markers": {"owner": "gateway/run", "class": "scratch", "subtree": true, "prune": {"when": "removed when empty"}},
    "gateway/blobs": {"owner": "gateway/session-catalog", "class": "scratch", "subtree": true, "prune": {"maxAge": "30m", "maxEntries": 128, "maxBytes": 209715200}},
    "gateway/exports": {"owner": "gateway/session-catalog", "class": "scratch", "subtree": true, "prune": {"maxAge": "30m", "maxEntries": 8, "maxBytes": 4294967296, "when": "2 GiB per item; 4 readers, 1 production"}},
    "gateway/uploads": {"owner": "gateway/machine", "subtree": true, "prune": {"maxEntries": 16384}},
    "gateway/upload-objects": {"owner": "gateway/machine", "subtree": true, "prune": {"when": "unreferenced objects are collected"}},
    "gateway/upload-bodies": {"owner": "gateway/machine", "class": "scratch", "subtree": true, "prune": {"when": "cleared on Gateway start"}},
    "gateway/upload-imports": {"owner": "gateway/machine", "class": "scratch", "subtree": true, "prune": {"when": "temporary files removed"}},
    "gateway/display-artifacts": {"owner": "gateway/display", "subtree": true, "prune": {"when": "removed per artifact; orphan objects are collected"}},
    "gateway/web-research-children": {"owner": "gateway/workspace", "class": "scratch", "subtree": true, "prune": {"maxEntries": 4096, "when": "retired with their scope"}},
    "gateway/workspace-state": {"owner": "gateway/workspace", "subtree": true},
    "gateway/lifecycle.json": {"owner": "repo/dev", "class": "scratch"},
    "gateway/lifecycle.json.lock": {"owner": "repo/dev", "class": "scratch", "subtree": true, "prune": {"when": "removed when the state write ends"}},
    "gateway/dev.pid": {"owner": "repo/dev", "class": "scratch"},
    "gateway/command.lock": {"owner": "repo/dev", "class": "scratch"},
    "gateway/dev.log": {"owner": "repo/dev", "class": "log", "prune": {"when": "truncated at each Debug start"}},
    "gateway/workspace-state.lock": {"owner": "gateway/workspace", "class": "scratch", "subtree": true, "prune": {"when": "released when its holder exits; stale after 60 s"}},
    "gateway/worktrees": {"owner": "gateway/machine", "subtree": true},
    "gateway/child-start.gate": {"owner": "repo/dev", "class": "scratch"},

    "workspace": {"owner": "gateway/workspace", "class": "keep", "container": true},
    "workspace/tmp": {"owner": "gateway/workspace", "class": "scratch", "subtree": true, "prune": {"by": "the owning task", "maxAge": "14d", "when": "its task ends; after 14 days only when not in use"}},
    "workspace/files": {"owner": "gateway/workspace", "container": true, "subtree": true},
    "workspace/files/Profile.json": {"owner": "gateway/home"},
    "workspace/state": {"owner": "gateway/workspace", "container": true},
    "workspace/state/episodic": {"owner": "gateway/episodic", "subtree": true},
    "workspace/state/apps": {"owner": "gateway/apps", "subtree": true},

    "internal": {"owner": "gateway/foundation", "class": "scratch", "container": true},
    "internal/machine-group-id": {"owner": "gateway/foundation", "class": "keep"},
    "internal/subagents": {"owner": "gateway/delegation", "subtree": true, "prune": {"by": "pi-subagents", "maxAge": "30d", "when": "terminal, unreferenced and not resumable"}},
    "internal/pi-subagents": {"owner": "gateway/delegation", "class": "rebuild", "subtree": true, "prune": {"when": "not pruned: an older version may still be loaded by another checkout or a resumable run"}},
    "internal/pi-subagents-transform-cache": {"owner": "gateway/delegation", "class": "rebuild", "subtree": true, "prune": {"when": "not pruned: an older version may still be loaded by another checkout or a resumable run"}},
    "internal/mac": {"owner": "mac-app/wizard", "class": "keep", "subtree": true},
    "internal/run": {"owner": "mac-app/server", "container": true},
    "internal/run/.onboarded": {"owner": "mac-app/server", "class": "keep"},
    "internal/run/mac-app-version.json": {"owner": "mac-app/server", "class": "rebuild"},
    "internal/run/.mac-wrapper.*.lock": {"owner": "mac-app/server"},
    "internal/run/ios-host-slots": {"owner": "repo/ios", "subtree": true, "prune": {"when": "three fixed slot files, never removed"}},
    "internal/run/ios-simulator-udid": {"owner": "repo/ios", "class": "rebuild"},
    "internal/run/ios-simulator.lease.lock": {"owner": "repo/ios"},
    "internal/run/ios-device-*.lease.lock": {"owner": "repo/ios"},
    "internal/ios-test*": {"owner": "repo/ios", "subtree": true, "prune": {"by": "scripts/tron-ios-test reap", "maxAge": "7d", "when": "unused, or its worktree is gone; never the default or a held lane"}},
    "internal/ios-e2e-*": {"owner": "repo/ios", "subtree": true, "prune": {"by": "scripts/ios-gateway-e2e-test clean", "when": "its owning worktree runs clean"}},

    "logs": {"owner": "gateway/transport", "class": "log", "container": true},
    "logs/gateway.jsonl*": {"owner": "gateway/transport", "prune": {"keepNewest": 8, "maxBytes": 41943040}},
    "logs/requests.jsonl*": {"owner": "gateway/run", "prune": {"keepNewest": 16, "maxBytes": 83886080}},
    "logs/gateway-stderr.log": {"owner": "mac-app/gateway-payload", "prune": {"maxBytes": 1048576, "when": "truncated on Mac launch"}},
    "logs/mac.jsonl*": {"owner": "mac-app/support", "prune": {"keepNewest": 4, "maxBytes": 4194304}},
    "logs/deploy.jsonl*": {"owner": "repo/dev", "prune": {"keepNewest": 2, "maxBytes": 2097152}},
    "logs/device-exports": {"owner": "gateway/transport", "subtree": true, "prune": {"keepNewest": 10}},

    "ios-builds": {"owner": "repo/ios", "class": "rebuild", "container": true},
    "ios-builds/builds": {"owner": "repo/ios", "subtree": true, "prune": {"keepNewest": 5}},
    "ios-builds/index.html": {"owner": "repo/ios"},
    "ios-builds/latest.plist": {"owner": "repo/ios"},
    "ios-builds/.publish.lock": {"owner": "repo/ios", "class": "scratch"},

    "mac-terminal": {"owner": "gateway/security", "class": "keep", "credential": true, "subtree": true}
  },
  "retired": []
}
