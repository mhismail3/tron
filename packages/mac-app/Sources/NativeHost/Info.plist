<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>TronNativeHost</string>
    <key>CFBundleIdentifier</key>
    <string>com.tron.mac.native-host</string>
    <key>CFBundleName</key>
    <string>Tron Native Host</string>
    <key>CFBundleDisplayName</key>
    <string>Tron Native Host</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <!-- Aqua, not a background-only or Login Item process: Launch Services
         gives this exact signed helper the TCC responsibility. -->
    <key>LSUIElement</key>
    <true/>
    <key>TronSigningTeam</key>
    <string>$(DEVELOPMENT_TEAM)</string>
    <key>TronCuaDriverSHA256</key>
    <string>$(TRON_CUA_DRIVER_SHA256)</string>
    <key>LSBackgroundOnly</key>
    <false/>
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
