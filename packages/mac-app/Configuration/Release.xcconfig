// Release.xcconfig - Release build for DMG distribution

// Release settings
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
COPY_PHASE_STRIP = NO
ENABLE_NS_ASSERTIONS = NO
MTL_ENABLE_DEBUG_INFO = NO

// Keep the archive product name stable for manual release packaging and the
// `/Applications/Tron.app` end-user surface. Debug keeps the default
// so the `TronMacTests` target's `BUNDLE_LOADER`/`TEST_HOST`
// (which reference `TronMac.app/Contents/MacOS/TronMac`) keeps resolving.
PRODUCT_NAME = Tron
