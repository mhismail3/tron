<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        App Sandbox is intentionally omitted. Tron registers a Login Item,
        probes Tailscale, supervises the gateway, and presents filesystem agent
        access outside an app container. Hardened runtime remains enabled; the
        release build signs bundled Node runtimes and native modules before
        sealing the outer application.
    -->
</dict>
</plist>
