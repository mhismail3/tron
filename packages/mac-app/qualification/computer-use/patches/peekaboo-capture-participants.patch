+
+        let forgedReceipt = ScreenCaptureKitOwnerLease.ProcessCapabilityReceipt(
+            processIdentifier: ownerIdentity.processIdentifier,
+            processStartIdentity: ownerIdentity.processStartIdentity,
+            buildIdentity: "sha256:forged",
+            codeSignatureHash: nil,
+            signingIdentifier: nil,
+            teamIdentifier: nil)
+        try JSONEncoder().encode(forgedReceipt).write(to: markerURL)
+        #expect(!isValid())
+    }
