{
  "name": "@tron/push-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --env=\"\" --dry-run --outdir dist",
    "build:sandbox": "wrangler deploy --env sandbox --dry-run --outdir dist-sandbox",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev"
  },
  "dependencies": {
    "@peculiar/x509": "3.1.0",
    "cbor-x": "1.6.9",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.156.1"
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "wrangler": "$wrangler"
    },
    "miniflare": "5.20261101.0-beta",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "zod": "4.6.6"
  }
}
