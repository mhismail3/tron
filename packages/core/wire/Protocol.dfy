// The Tron Gateway protocol's value types (protocol v8): the one source of the TypeScript types and
// decoders in packages/gateway/src/protocol/types.ts and of the iOS app's decoders in
// packages/ios-app/Core/Generated/Protocol.swift, generated by `scripts/tron proof wire --protocol`
// (tools/proof/dafny2wire/README.md "Wire"). A datatype is a typed, bounded projection: Pi objects are
// projected into these values rather than serialized directly; Pi JSONL and configuration files remain
// canonical. Wire names are field names (a trailing `_` escapes a Dafny keyword or a shared destructor).
// `real` is a JSON float64 number and `int` a JSON integer in the safe range. Frames are still encoded by
// the Gateway's own JSON.stringify of the values it builds, so this file changes no frame bytes; a change
// here is a wire change (AGENTS.md "Architecture invariants": iOS, Gateway and Mac ship in lockstep). The
// iOS app decodes the datatypes `@swift` names and every datatype they reach.
// @swift HomeStatus HomeContextProjection HomeTaskPage HomeTaskStatusResult HomeTaskHistoryPage
// @swift HomeMemoryView HomeMemoryEvidencePage HomeChapterList HomeProfileList
// @swift AdministrativeDrainSnapshot GatewayRestartResponse
// @swift SessionCommands CommandDetail TronModuleList PackageInventory PackageUpdates ModelPage
// @swift SessionPhase SessionSummaryUpdate
// @swift ExtensionRunLifecycle SessionProcessLifecycle
// @swift-codable SessionPhase
module Protocol {
  datatype Option<T> = None | Some(v: T)
  datatype Nullable<T> = Null | NonNull(v: T)
  datatype Absent = Absent

  // @wire bykind
  datatype JsonPrimitive = Null_ | String(s: string) | Number(n: real) | Boolean(b: bool)

  // @wire bykind
  datatype JsonValue = Null_ | String(s: string) | Number(n: real) | Boolean(b: bool) | Array(items: seq<JsonValue>) | Object(entries: map<string, JsonValue>)

  // @wire enum
  datatype CommandReceiptRouteCategory = {:wire "fresh"} fresh_ | replay

  // @wire
  datatype ModelRef = ModelRef(provider: string, id: string)

  // @wire enum
  datatype SessionPhase = idle | running | compacting | retrying | interrupted

  // @wire enum
  datatype SessionKind = user | subagent

  /// Where an available resource comes from, derived by the Gateway from Pi
  /// `sourceInfo`; absent for Pi built-ins. Distinct from Pi's `origin`.
  // @wire enum
  datatype ResourceDistribution = external | {:wire "module"} module_ | local

  // @wire enum
  datatype SessionCreationOriginKind = automation

  // @wire
  datatype SessionCreationOrigin = SessionCreationOrigin(
      kind: SessionCreationOriginKind,
      /// Stable Automation definition identity; no action content is projected.
      automationId: string
    )

  // @wire enum
  datatype AdministrativeDrainPhase = idle | preparing | waiting | complete | failed

  // @wire enum
  datatype AdministrativeDrainBlockerCategory = {:wire "slot-admission"} slotAdmission | {:wire "prompt-preflight"} promptPreflight | {:wire "foreground-agent-operation"} foregroundAgentOperation | {:wire "queued-mutation"} queuedMutation | {:wire "compaction-export"} compactionExport | {:wire "detached-extension-run"} detachedExtensionRun | {:wire "terminal-receipt-persistence"} terminalReceiptPersistence | {:wire "rpc-mutation"} rpcMutation | {:wire "extension-command-prompt-ui"} extensionCommandPromptUi | {:wire "administrative-provider-package-operation"} administrativeProviderPackageOperation | {:wire "provider-login"} providerLogin | {:wire "automation-dispatch"} automationDispatch | {:wire "automation-terminal-persistence"} automationTerminalPersistence

  // @wire enum
  datatype AdministrativeDrainBlockerSummaryState = active | settling | suspect

  // @wire
  datatype AdministrativeDrainBlockerSummary = AdministrativeDrainBlockerSummary(
      /// Per-drain opaque identity. It is not a session, run, path, or token ID.
      id: string,
      category: AdministrativeDrainBlockerCategory,
      sessionId: Option<string>,
      /// For `rpc-mutation`, the receipt-backed RPC still executing.
      method_: Option<string>,
      state: AdministrativeDrainBlockerSummaryState,
      admittedAt: Option<string>,
      progressAt: Option<string>,
      ageMs: Option<real>
    )

  /// Bounded process-local diagnostic projection. It is never liveness authority.
  // @wire
  datatype AdministrativeDrainSnapshot = AdministrativeDrainSnapshot(
      drainId: string,
      revision: int,
      phase: AdministrativeDrainPhase,
      blockerCount: int,
      blockerCounts: map<AdministrativeDrainBlockerCategory, int>,
      blockers: seq<AdministrativeDrainBlockerSummary>,
      omittedCount: int,
      suspectProjectionCount: int
    )

  /// `gateway.restart`: whether the Gateway restarts now or after its administrative drain settles.
  /// A restart-now request while a drain is in progress answers only the flags and the drain.
  // @wire
  datatype GatewayRestartResponse = GatewayRestartResponse(
      restarting: bool,
      scheduled: bool,
      restartNow: Option<bool>,
      activeSessionIds: Option<seq<string>>,
      drainId: Option<string>,
      drainRevision: Option<int>,
      drain: AdministrativeDrainSnapshot
    )

  // @wire
  datatype SessionSummary = SessionSummary(
      id: string,
      name: Option<string>,
      cwd: string,
      kind: SessionKind := SessionKind.user,
      parentSessionId: Option<string>,
      /// Immutable creation provenance derived from canonical session receipts.
      creationOrigin: Option<SessionCreationOrigin>,
      /// The Home task that created this worker session, from the task ledger.
      /// Absent for every session no Home task dispatched.
      homeTaskId: Option<string>,
      createdAt: string,
      updatedAt: string,
      /// Stable Gateway-observed start of the current active dashboard period.
      activeSince: Option<string>,
      messageCount: int,
      firstMessage: string,
      phase: SessionPhase,
      /// Narrow foreground agent phase. When this is settled while `phase` remains
      /// active, detached subagents are the only remaining dashboard work.
      foregroundPhase: Option<SessionPhase>,
      /// True when at least one detached subagent activity remains active.
      hasActiveSubagents: Option<bool> := Some(false),
      /// True while the authoritative runtime is blocked on a semantic user interaction.
      waitingForUser: Option<bool> := Some(false),
      summaryRevision: int := 0,
      /// Gateway-canonical cross-client attention projection. Missing only during a rolling upgrade.
      completionRevision: Option<int> := Some(0),
      attentionRevision: Option<int> := Some(0),
      isUnread: Option<bool> := Some(false),
      /// Set only on an archived row. Archiving hides a session from the dashboard
      /// without changing its canonical file.
      archivedAt: Option<string>
    )

  /// `session.list`: one page of the session catalog. `notModified` answers a first page whose
  /// projection token is the client's own, with no sessions.
  // @wire
  datatype SessionListPage = SessionListPage(
      sessions: seq<SessionSummary>,
      listRevision: int,
      projectionToken: string,
      nextCursor: Option<string>,
      archivedCount: Option<int>,
      notModified: Option<bool>
    )

  /// `session.list` archive filter. `exclude` is the dashboard projection; `only`
  /// is the archived container.
  // @wire enum
  datatype SessionArchiveFilter = exclude | only

  /// Bounded global projection used to update dashboard rows without subscribing
  /// every client to every full session transcript.
  // @wire
  datatype SessionSummaryUpdate = SessionSummaryUpdate(
      sessionId: string,
      summaryRevision: int,
      phase: SessionPhase,
      /// Narrow foreground agent phase; omitted by older Gateway builds.
      foregroundPhase: Option<SessionPhase>,
      /// True when at least one detached subagent activity remains active.
      hasActiveSubagents: Option<bool> := Some(false),
      /// True while the authoritative runtime is blocked on a semantic user interaction.
      waitingForUser: Option<bool> := Some(false),
      name: Option<string>,
      updatedAt: string,
      /// Stable Gateway-observed start of the current active dashboard period.
      activeSince: Option<string>,
      messageCount: int,
      firstMessage: string,
      completionRevision: Option<int> := Some(0),
      attentionRevision: Option<int> := Some(0),
      isUnread: Option<bool> := Some(false)
    )

  // @wire
  datatype ContentPartTextAttachment = ContentPartTextAttachment(name: string, mimeType: string, size: real)

  // @wire tag=type
  datatype ContentPart =
    | {:wire "text"} Text(
        id: string,
        ordinal: real,
        text: string,
        attachment: Option<ContentPartTextAttachment>
      )
    | {:wire "thinking"} Thinking(
        id: string,
        ordinal: real,
        thinkingRunOrdinal: real,
        text: string,
        redacted: Option<bool>
      )
    | {:wire "image"} Image(
        id: string,
        ordinal: real,
        mimeType: string,
        blobId: string
      )
    | {:wire "toolCall"} ToolCall(
        id: string,
        ordinal: real,
        toolCallId: string,
        name: string,
        /// Extension-authored human-readable label from Pi's registered tool definition.
        label_: Option<string>,
        arguments: JsonValue,
        /// Gateway-owned active-turn identity. Equal values may share one display run.
        toolSegmentId: Option<string>,
        /// Disposable declaration metadata; never persisted to Pi JSONL.
        groupId: Option<string>,
        groupIndex: Option<real>,
        groupCount: Option<real>,
        groupFinalized: Option<bool>
      )

  // @wire enum
  datatype Literal1 = {:wire 1} v1

  // @wire enum
  datatype ChatDirection = inboundContext | agentOutput | agentInvocation | ambientStatus | hiddenInternal

  // @wire enum
  datatype ChatContextEffect = none | modelInput | hiddenModelInput | toolResult

  // @wire enum
  datatype ChatDelivery = stored | nextTurn | steer | followUp | triggeredTurn | continuedTurn | beforeAgentStart | toolResult | unknown

  // @wire enum
  datatype ChatSemanticMetadataVisibility = visible | hidden

  // @wire enum
  datatype ChatSemanticKind = prompt | resourcePrompt | command | message | tool | status | state | unknown

  // @wire enum
  datatype ChatOriginKind = user | subagent | extension | process | gateway | assistant | unknown

  // @wire enum
  datatype ChatOriginConfidence = boundary | receipt | adapter | unknown

  // @wire
  datatype ChatOrigin = ChatOrigin(
      kind: ChatOriginKind,
      ownerId: Option<string>,
      title: Option<string>,
      confidence: ChatOriginConfidence
    )

  // @wire enum
  datatype InvocationLifecycle = staged | accepted | running | waitingForInput | queued | retrying | settling | completed | failed | interrupted | outcomeUnknown

  // @wire enum
  datatype ResourceInvocationSource = skill | prompt | extension

  // @wire
  datatype ResourceInvocation = ResourceInvocation(
      source: ResourceInvocationSource,
      /// Canonical resource name; skills omit the `skill:` transport prefix.
      name: string,
      /// Exact visible arguments, bounded to 5,000 UTF-8 bytes for receipt safety. Empty is valid.
      /// An extension command's arguments are the message text; a chat skill or prompt
      /// carries none (the message text follows every expansion once).
      arguments: string
    )

  // @wire enum
  datatype LiteralTrue = {:wire true} yes

  /// Independent semantic axes used by every transcript renderer.
  // @wire
  datatype ChatSemanticMetadata = ChatSemanticMetadata(
      version: Literal1,
      direction: ChatDirection,
      contextEffect: ChatContextEffect,
      delivery: ChatDelivery,
      visibility: ChatSemanticMetadataVisibility,
      kind: ChatSemanticKind,
      origin: ChatOrigin,
      invocationId: Option<string>,
      operationId: Option<string>,
      sequence: real,
      lifecycle: Option<InvocationLifecycle>,
      /// Ordered resources this message invoked: skills and prompts in chip order, or one exclusive extension command.
      resourceInvocations: Option<seq<ResourceInvocation>>,
      /// Authored text retained for image prompts whose SDK history includes generated resize notes.
      submittedText: Option<string>,
      /// Set only on a command row a fork inherited from its origin, whose lifecycle settled there.
      settledInOriginSession: Option<LiteralTrue>
    )

  // @wire enum
  datatype TranscriptItemMessageRole = user | assistant | toolResult

  // @wire enum
  datatype UpstreamErrorInfoCategory = overloaded | {:wire "rate-limit"} rateLimit | {:wire "usage-limit"} usageLimit | authentication | entitlement | forbidden | unavailable | network | timeout | aborted | {:wire "not-found"} notFound | unknown

  /// Transport-independent classification of an upstream failure. Queue policy,
  /// account-usage reads and transcript presentation consume these same facts.
  // @wire import=../util/upstream-error.js
  datatype UpstreamErrorInfo = UpstreamErrorInfo(
      message: string,
      providerMessage: string,
      category: UpstreamErrorInfoCategory,
      type_: Option<string>,
      requestId: Option<string>,
      httpStatus: Option<real>
    )

  // @wire enum
  datatype NestedToolExecutionStateStatus = running | completed | failed | unfinished

  // @wire
  datatype NestedToolExecutionState = NestedToolExecutionState(
      id: string,
      parentToolCallId: string,
      toolName: string,
      status: NestedToolExecutionStateStatus,
      error: Option<string>,
      arguments: Option<JsonValue>,
      argumentsBytes: Option<real>,
      durationMs: Option<real>
    )

  // @wire
  datatype NestedToolCallsProjection = NestedToolCallsProjection(calls: seq<NestedToolExecutionState>, complete: bool)

  // @wire enum
  datatype DisplayProjectionSchema = {:wire "tron.display.v1"} tronDisplayV1

  // @wire enum import=../modules/display/contract.js
  datatype DisplayKind = image | markdown | text | code | pdf | html | video | audio | document | webpage | hls | {:wire "browser_live"} browserLive | {:wire "native_live"} nativeLive

  // @wire enum import=../modules/display/contract.js
  datatype DisplaySurface = sheet | inline | floating

  // @wire enum import=../modules/display/contract.js
  datatype DisplayInlineTapAction = sheet | none

  // @wire import=../modules/display/contract.js
  datatype DisplayPresentationPreference = DisplayPresentationPreference(requestedSurface: DisplaySurface, inlineTapAction: DisplayInlineTapAction)

  // @wire enum import=../modules/display/contract.js
  datatype DisplayArtifactKind = image | markdown | text | code | pdf | html | video | audio | document

  // @wire import=../modules/display/contract.js
  datatype DisplayArtifactDescriptor = DisplayArtifactDescriptor(
      id: string,
      name: string,
      mimeType: string,
      size: real,
      kind: DisplayArtifactKind
    )

  // @wire import=../modules/display/contract.js
  datatype DisplayMarkdownImage = DisplayMarkdownImage(destination: string, artifact: DisplayArtifactDescriptor)

  // @wire tag=schema import=../modules/display/contract.js
  datatype LiveViewDescriptor =
    | {:wire "tron.browser-live-view.v1"} TronBrowserLiveViewV1(
        viewId: string,
        generation: string,
        title: string,
        fallbackText: string
      )
    | {:wire "tron.native-live-view.v1"} TronNativeLiveViewV1(
        viewId: string,
        generation: string,
        title: string,
        fallbackText: string
      )

  // @wire import=../modules/display/contract.js
  datatype DisplayProjection = DisplayProjection(
      schema: DisplayProjectionSchema,
      displayId: string,
      revision: real,
      title: string,
      caption: Option<string>,
      altText: string,
      kind: DisplayKind,
      presentation: DisplayPresentationPreference,
      eligibleSurfaces: seq<DisplaySurface>,
      fallbackText: string,
      artifact: Option<DisplayArtifactDescriptor>,
      markdownImages: Option<seq<DisplayMarkdownImage>>,
      remoteURL: Option<string>,
      liveView: Option<LiveViewDescriptor>
    )

  /// Gateway-classified capability, independent of the package source spelling.
  /// Canonical receipts written before classification may omit it.
  // @wire enum
  datatype ExtensionOwnerKind = subagent | extension

  // @wire
  datatype ExtensionOwner = ExtensionOwner(
      id: string,
      title: string,
      source: string,
      /// Gateway-classified capability, independent of the package source spelling.
      /// Canonical receipts written before classification may omit it.
      kind: Option<ExtensionOwnerKind>
    )

  // @wire
  datatype ExtensionToolOrigin = ExtensionToolOrigin(
      /// Bounded producer source attribution. This is required even when owner is present.
      source: string,
      /// Exact opaque owner attribution captured at the extension boundary.
      owner: Option<ExtensionOwner>
    )

  // @wire tag=kind
  datatype TranscriptItem =
    | {:wire "message"} Message(
        id: string,
        parentId: Nullable<string>,
        timestamp: string,
        /// Typed direction/context/provenance semantics for every projected row.
        semantic: Option<ChatSemanticMetadata>,
        role: TranscriptItemMessageRole,
        /// Stable presentation identity for this runtime epoch. Canonical entry id remains authoritative.
        presentationId: string,
        content: seq<ContentPart>,
        provider: Option<string>,
        modelId: Option<string>,
        /// Pi thinking level used for this physical assistant response.
        thinkingLevel: Option<string>,
        stopReason: Option<string>,
        errorMessage: Option<string>,
        errorInfo: Option<UpstreamErrorInfo>,
        toolCallId: Option<string>,
        toolName: Option<string>,
        /// Extension-authored human-readable label from the mounted runtime.
        toolLabel: Option<string>,
        isError: Option<bool>,
        /// Bounded record of child executions, not their result payloads.
        nestedCalls: Option<NestedToolCallsProjection>,
        details: Option<JsonValue>,
        /// Strictly admitted first-party display descriptor. Raw tool details
        /// remain available for technical inspection but never select a renderer.
        display: Option<DisplayProjection>,
        usage: Option<JsonValue>,
        /// Exact runtime timing when the owning Gateway observed this call. Older
        /// canonical entries may omit it and clients derive an observed interval.
        startedAt: Option<string>,
        completedAt: Option<string>,
        durationMs: Option<real>,
        lastProgressAt: Option<string>,
        progressSequence: Option<real>,
        /// Disposable provenance derived from public Pi sourceInfo; absent means unknown/ambiguous.
        extensionOrigin: Option<ExtensionToolOrigin>,
        /// Gateway-owned active-turn identity for an orphan canonical result.
        toolSegmentId: Option<string>,
        groupId: Option<string>,
        groupIndex: Option<real>,
        groupCount: Option<real>,
        groupFinalized: Option<bool>
      )
    | {:wire "bash"} Bash(
        id: string,
        parentId: Nullable<string>,
        timestamp: string,
        /// Typed direction/context/provenance semantics for every projected row.
        semantic: Option<ChatSemanticMetadata>,
        command: string,
        output: string,
        exitCode: Option<real>,
        cancelled: bool,
        truncated: bool,
        fullOutputPath: Option<string>,
        excludeFromContext: Option<bool>,
        /// Exact runtime timing is available for direct Bash executed by the
        /// current Gateway; older canonical history omits these fields.
        startedAt: Option<string>,
        completedAt: Option<string>,
        durationMs: Option<real>
      )
    | {:wire "customMessage"} CustomMessage(
        id: string,
        parentId: Nullable<string>,
        timestamp: string,
        /// Typed direction/context/provenance semantics for every projected row.
        semantic: Option<ChatSemanticMetadata>,
        customType: string,
        content: seq<ContentPart>,
        details: Option<JsonValue>
      )
    | {:wire "customEntry"} CustomEntry(
        id: string,
        parentId: Nullable<string>,
        timestamp: string,
        /// Typed direction/context/provenance semantics for every projected row.
        semantic: Option<ChatSemanticMetadata>,
        customType: string,
        data: Option<JsonValue>
      )
    | {:wire "compaction"} Compaction(
        id: string,
        parentId: Nullable<string>,
        timestamp: string,
        /// Typed direction/context/provenance semantics for every projected row.
        semantic: Option<ChatSemanticMetadata>,
        /// Stable live-to-canonical presentation identity when the Gateway
        /// observed the producing operation. Canonical entry id remains truth.
        presentationId_: Option<string>,
        summary: string,
        tokensBefore: Option<real>,
        details: Option<JsonValue>,
        usage: Option<JsonValue>,
        fromHook: Option<bool>
      )
    | {:wire "branchSummary"} BranchSummary(
        id: string,
        parentId: Nullable<string>,
        timestamp: string,
        /// Typed direction/context/provenance semantics for every projected row.
        semantic: Option<ChatSemanticMetadata>,
        /// Stable live-to-canonical presentation identity when the Gateway
        /// observed the producing operation. Canonical entry id remains truth.
        presentationId_: Option<string>,
        summary: string,
        tokensBefore: Option<real>,
        details: Option<JsonValue>,
        usage: Option<JsonValue>,
        fromHook: Option<bool>
      )
    | {:wire "modelChange"} ModelChange(
        id: string,
        parentId: Nullable<string>,
        timestamp: string,
        /// Typed direction/context/provenance semantics for every projected row.
        semantic: Option<ChatSemanticMetadata>,
        modelRef: ModelRef
      )
    | {:wire "thinkingChange"} ThinkingChange(
        id: string,
        parentId: Nullable<string>,
        timestamp: string,
        /// Typed direction/context/provenance semantics for every projected row.
        semantic: Option<ChatSemanticMetadata>,
        level: string
      )
    | {:wire "label"} Label(
        id: string,
        parentId: Nullable<string>,
        timestamp: string,
        /// Typed direction/context/provenance semantics for every projected row.
        semantic: Option<ChatSemanticMetadata>,
        targetId: string,
        label_: Option<string>
      )

  // @wire enum
  datatype ContextDeliveryMetadataSource = extension

  // @wire enum
  datatype ContextDeliveryMetadataDelivery = stored | triggeredTurn

  // @wire
  datatype ContextDeliveryMetadata = ContextDeliveryMetadata(
      /// Exact canonical user entry of a receipt-bound internal wake, when present.
      wakeEntryId: Option<string>,
      source: ContextDeliveryMetadataSource,
      delivery: ContextDeliveryMetadataDelivery,
      origin: Option<ExtensionToolOrigin>
    )

  // @wire enum
  datatype ExtensionRunStatus = running | completed | failed

  /// Rich lifecycle state. `status` remains the coarse compatibility field above.
  // @wire enum
  datatype ExtensionRunLifecycleState = queued | running | paused | completed | failed | stopped | rejected | unknown

  // @wire enum
  datatype ExtensionRunAttention = none | activeLongRunning | needsAttention

  // @wire enum
  datatype ExtensionRunVisibility = current | recent | historical | unknown

  // @wire
  datatype ExtensionRunLifecycle = ExtensionRunLifecycle(
      version: Literal1,
      state: ExtensionRunLifecycleState,
      attention: ExtensionRunAttention,
      /// Monotonic Gateway projection sequence, not producer wall time.
      sequence: real,
      observedAt: string,
      producerUpdatedAt: Option<string>,
      terminalAt: Option<string>,
      recentUntil: Option<string>,
      visibility: Option<ExtensionRunVisibility>,
      remainingMs: Option<real>
    )

  // @wire enum
  datatype ExtensionRunHostStepKind = command | ci | gate

  // @wire enum
  datatype ExtensionRunHostStepState = pending | running | done | error | cancelled

  // @wire enum
  datatype ExtensionRunHostStepVerdict = pass | fail | inconclusive

  /// Structured, bounded progress emitted by an extension-owned delegated run.
  /// This is intentionally presentation-neutral: native clients may render it
  /// as a live card while the extension remains the authority for execution.
  // @wire
  datatype ExtensionRunHostStep = ExtensionRunHostStep(
      kind: ExtensionRunHostStepKind,
      provider: Option<string>,
      role: Option<string>,
      state: ExtensionRunHostStepState,
      verdict: Option<ExtensionRunHostStepVerdict>,
      reasonCode: Option<string>,
      detail: Option<string>,
      target: Option<string>,
      stale: Option<bool>,
      report: Option<string>
    )

  // @wire
  datatype ExtensionRunChild = ExtensionRunChild(
      id: string,
      /// Exact producer identity. Absent when `id` is only a compatibility display fallback.
      producerId: Option<string>,
      label_: string,
      /// Opaque validated child-session identity. Absolute paths never cross the wire.
      childSessionRef: Option<string>,
      /// Exact run that reserved a fresh child path when it differs from this
      /// stable process producer. Opaque and absent for fork-context children.
      sessionOwnerId: Option<string>,
      /// Coarse compatibility status retained for older native clients.
      status: ExtensionRunStatus,
      /// Rich delegated-run state, independent of the parent tool status.
      lifecycle: Option<ExtensionRunLifecycleState>,
      attention: Option<ExtensionRunAttention>,
      task: Option<string>,
      lastActivityAt: Option<string>,
      currentTool: Option<string>,
      currentToolStartedAt: Option<string>,
      currentPath: Option<string>,
      /// Optional resolved child model metadata read from canonical producer status.
      model: Option<string>,
      thinking: Option<string>,
      /// Producer-authored child timing; never inherited from the parent duration.
      startedAt: Option<string>,
      endedAt: Option<string>,
      toolCount: Option<real>,
      turnCount: Option<real>,
      durationMs: Option<real>,
      output: Option<string>,
      children: Option<seq<ExtensionRunChild>>,
      hostStep: Option<ExtensionRunHostStep>
    )

  /// Exact bounded child omission reported by the producer header.
  // @wire
  datatype ExtensionRunActivityLifecycleOmissions = ExtensionRunActivityLifecycleOmissions(children: real, byteLimitExceeded: bool)

  // @wire
  datatype ExtensionRunActivity = ExtensionRunActivity(
      /// Compatibility row identity. New clients use activityId when present.
      id: string,
      /// Deterministic identity derived from canonical session + real tool call.
      activityId: Option<string>,
      runId: Option<string>,
      toolCallId: string,
      source: ExtensionToolOrigin,
      title: string,
      mode: Option<string>,
      status: ExtensionRunStatus,
      startedAt: string,
      updatedAt: string,
      completedAt: Option<string>,
      lastActivityAt: Option<string>,
      currentTool: Option<string>,
      currentToolStartedAt: Option<string>,
      currentPath: Option<string>,
      toolCount: Option<real>,
      turnCount: Option<real>,
      durationMs: Option<real>,
      output: Option<string>,
      children: seq<ExtensionRunChild>,
      /// Additive rich lifecycle projection; absent on old Gateway snapshots.
      lifecycle: Option<ExtensionRunLifecycle>,
      /// Exact bounded child omission reported by the producer header.
      lifecycleOmissions: Option<ExtensionRunActivityLifecycleOmissions>
    )

  // @wire enum
  datatype SessionProcessKind = command | subagent

  // @wire enum
  datatype SessionProcessExecutionMode = foreground | background | synchronous | asynchronous | unknown

  // @wire enum
  datatype SessionProcessSource = mainAssistant | delegatedAgent | admittedExtension

  // @wire enum
  datatype SessionProcessState = queued | running | paused | completed | failed | stopped | rejected | interrupted | unknown

  // @wire enum
  datatype SessionProcessAttention = none | activeLongRunning | needsAttention

  // @wire enum
  datatype SessionProcessVisibility = active | recent | historical | unknown

  // @wire
  datatype SessionProcessLifecycle = SessionProcessLifecycle(
      version: Literal1,
      state: SessionProcessState,
      attention: SessionProcessAttention,
      /// Monotonic within one runtime's process projection.
      sequence: real,
      observedAt: string,
      producerUpdatedAt: Option<string>,
      terminalAt: Option<string>,
      recentUntil: Option<string>
    )

  /// Package-agnostic bounded projection of process activity Tron already observes.
  /// It never implies that Tron owns or can control the underlying process.
  // @wire
  datatype SessionProcessActivity = SessionProcessActivity(
      version: Literal1,
      processId: string,
      kind: SessionProcessKind,
      executionMode: SessionProcessExecutionMode,
      source: SessionProcessSource,
      parentProcessId: Option<string>,
      lifecycle: SessionProcessLifecycle,
      visibility: SessionProcessVisibility,
      startedAt: Option<string>,
      /// Bounded producer/canonical elapsed time; absent when no authoritative interval exists.
      durationMs: Option<real>,
      title: string,
      command: Option<string>,
      currentTool: Option<string>,
