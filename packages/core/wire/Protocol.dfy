      transcriptTotal: real,
      streaming: Option<TranscriptItem>,
      leafEntryId: Option<string>,
      operation: Option<SessionOperationState>,
      retry: Option<RetryState>,
      /// Exact Gateway-owned tool-segment authority for the running Pi agent; a barrier generation may match no call yet.
      activeToolSegmentId: Option<string>,
      toolExecutions: seq<ToolExecutionState>,
      /// Bounded recent extension-owned run history. Live entries are also carried
      /// on their owning toolExecution so progress can update without a snapshot.
      extensionActivities: Option<seq<ExtensionRunActivity>>,
      extensionActivityOmissions: Option<SessionProcessOverviewOmissions>,
      /// Monotonic Gateway revision for disposable current/recent activity.
      liveActivityRevision: real,
      /// Wall-clock observation time for the activity projection, including expiry.
