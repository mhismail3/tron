      purpose: string,
      tools: seq<string>,
      commands: seq<string>
    )

  /// `modules.list`: the built-in Tron extension definitions.
  // @wire
  datatype TronModuleList = TronModuleList(modules: seq<TronModuleSummary>)

  // @wire enum
  datatype PackageNodeRequirementStatus = satisfied | unsatisfied | invalid

  /// An installed package's declared `engines.node` evaluated against the Node
  /// that runs this Gateway (and so the package). `unsatisfied` and `invalid` are
  /// warnings only (D-2, #243): the package still installs and loads. Absent when
  /// the package declares no requirement.
  // @wire
  datatype PackageNodeRequirement = PackageNodeRequirement(
      /// The declared range, truncated to a bounded length.
      range: string,
      /// `process.versions.node` of the running Gateway.
      runtime: string,
      status: PackageNodeRequirementStatus
    )

  // @wire enum
  datatype PackageConflictCode = {:wire "managed-provider"} managedProvider

  /// A configured user package excluded from execution by Tron's managed owner.
  // @wire
  datatype PackageConflict = PackageConflict(code: PackageConflictCode, message: string)

  // @wire
  datatype PackageProvides = PackageProvides(
      skills: seq<string>,
      prompts: seq<string>,
      themes: seq<string>,
      subagents: seq<string>,
      tools: seq<string>,
      commands: seq<string>
    )

  // @wire enum
  datatype PackageScope = user | project

  /// One configured package as `packages.list` answers it: Pi's configured package, what it
  /// provides, and why it is ignored or may not run, when it is.
  // @wire
  datatype PackageSummary = PackageSummary(
      source: string,
      scope: PackageScope,
      filtered: bool,
      installedPath: Option<string>,
      provides_: Option<PackageProvides>,
      conflict: Option<PackageConflict>,
      nodeRequirement: Option<PackageNodeRequirement>
    )

  /// `packages.list`: the configured packages and Pi's resolved resources for the directory.
  // @wire
  datatype PackageInventory = PackageInventory(packages: seq<PackageSummary>, resources: JsonValue, providesDiagnostic: Option<string>)

  // @wire
  datatype PackageUpdate = PackageUpdate(source: string, displayName: string, type_: string, scope: PackageScope)

  /// `packages.checkUpdates`: the configured packages with an available update.
  // @wire
  datatype PackageUpdates = PackageUpdates(updates: seq<PackageUpdate>)

  // @wire enum
  datatype HomeProfileListItemKind = preference | {:wire "standing-decision"} standingDecision | {:wire "delegation-default"} delegationDefault | fact | correction

  // @wire enum
  datatype HomeProfileListItemStatus = active | superseded | retired

  /// One learned-profile item as `home.profileList` answers it: the Knowledge note's
  /// identity, its kind label, its one-line text and whether the maintainer confirmed it.
  /// `status` is derived the way Home's instructions derive it: only `active` applies.
  // @wire
  datatype HomeProfileListItem = HomeProfileListItem(
      id: string,
      revisionId: string,
      kind: HomeProfileListItemKind,
      path: string,
      text: string,
      confirmed: bool,
      status: HomeProfileListItemStatus,
      createdAt: string,
      updatedAt: string
    )

  /// `home.profileList`: every profile-tagged personal note, classified, in Home's
  /// order (kind, then creation); `unclassified` counts notes without one kind label.
  // @wire
  datatype HomeProfileList = HomeProfileList(items: seq<HomeProfileListItem>, unclassified: int)

  // @wire enum
  datatype HomeChapterSummaryState = active | sealed | reserved | materializing

  /// A chapter's contents as `home.chapterList` answers them. Counts are canonical entries:
  /// `userMessages` are maintainer messages, `homeReplies` Home's replies, and `tasksDelegated`
  /// the `delegate` calls the chapter's history accepted.
  // @wire
  datatype HomeChapterContents = HomeChapterContents(
      /// Canonical timestamps of the chapter's first and last entries.
      firstAt: Option<string>,
      lastAt: Option<string>,
      userMessages: int,
      homeReplies: int,
      tasksDelegated: int,
      /// At most 8 useful recent merged memory summaries, each at most 1000 characters
      /// with its lines kept (markdown). Empty when Home's memory is not open.
      topics: seq<string>
    )

  /// One ledger chapter as `home.chapterList` answers it. Sealed chapters carry
  /// exactly their recorded seal metrics (a disable-sealed chapter has none); the
  /// active chapter is measured live only while its session is present, so absent
  /// sizes mean "not measured", never zero.
  // @wire
  datatype HomeChapterSummary = HomeChapterSummary(
      sessionId: string,
      ordinal: int,
      state: HomeChapterSummaryState,
      createdAt: string,
      activationStarted: bool,
      /// Whether the chapter's session exists right now, live or on disk.
      sessionPresent: bool,
      sealedAt: Option<string>,
      bytes: Option<int>,
      entries: Option<int>,
      /// What the chapter holds, read from its canonical history and memory. Absent when the
      /// chapter's history could not be read; a chapter with no file has zero counts.
      contents: Option<HomeChapterContents>
    )

  // @wire
  datatype HomeChapterListLimits = HomeChapterListLimits(
      softBytes: int,
      softEntries: int,
      hardBytes: int,
      hardEntries: int
    )

  /// `home.chapterList`: the whole chapter ledger in ledger (ordinal) order, with
  /// the shared soft and hard rollover limits. A bounded read: at most the ledger's
  /// chapters, and one live measurement for the active chapter.
  // @wire
  datatype HomeChapterList = HomeChapterList(
      homeId: string,
      generation: int,
      enabled: bool,
      limits: HomeChapterListLimits,
      chapters: seq<HomeChapterSummary>
    )

  /// Physical canonical identity, never a projected memory line address.
  // @wire
  datatype HomeMemoryEvidence = HomeMemoryEvidence(
      index: int,
      sessionId: string,
      entryId: string,
      sourceDigest: string
    )

  // @wire enum
  datatype HomeMemoryItemKind = user | talk | echo | event

  // @wire enum
  datatype HomeMemoryItemAttribution = user | assistant | tool | event

  // @wire enum
  datatype HomeMemoryItemDisplayKind = message | {:wire "tool-call"} toolCall | {:wire "tool-result"} toolResult

  // @wire enum
  datatype HomeMemoryItemDisplayStatus = ok | error

  /// Browser-only facts from the digest-verified canonical entry, never parsed from model prose.
  // @wire
  datatype HomeMemoryItemDisplay = HomeMemoryItemDisplay(
      kind: HomeMemoryItemDisplayKind,
      toolName: Option<string>,
      target: Option<string>,
      toolCount: Option<int>,
      status: Option<HomeMemoryItemDisplayStatus>
    )

  // @wire enum
  datatype HomeMemoryItemProjectionFormat = {:wire "memory-projection"} memoryProjection

  // @wire
  datatype HomeMemoryItemProjection = HomeMemoryItemProjection(
      format: HomeMemoryItemProjectionFormat,
      text: string,
      omitted: bool,
      omissions: seq<string>
    )

  // @wire enum
  datatype HomeMemoryItemSummaryFormat = {:wire "memory-summary"} memorySummary

  /// A leaf summary, not canonical evidence; null while unbuilt/invalidated.
  // @wire
  datatype HomeMemoryItemSummary = HomeMemoryItemSummary(format: HomeMemoryItemSummaryFormat, text: string, truncated: bool)

  // @wire
  datatype HomeMemoryItem = HomeMemoryItem(
      index: int,
      kind: HomeMemoryItemKind,
      attribution: HomeMemoryItemAttribution,
      timestamp: Option<string>,
      evidence: HomeMemoryEvidence,
      /// Browser-only facts from the digest-verified canonical entry, never parsed from model prose.
      display: Option<HomeMemoryItemDisplay>,
      projection: HomeMemoryItemProjection,
      /// A leaf summary, not canonical evidence; null while unbuilt/invalidated.
      summary: Nullable<HomeMemoryItemSummary>
    )

  /// One range in Home's rendered memory view. Leaf messages carry the same
  /// bounded projection/evidence object as the independent evidence read.
  // @wire
  datatype HomeMemoryViewLine = HomeMemoryViewLine(
      /// Exact member of the live tree view, not a child opened by filtering or zoom.
      inCurrentView: bool,
      /// Oldest leaf of the contiguous individual-message tail, when older summaries exist.
      startsIndividualMessages: bool,
      start: int,
      span: int,
      text: Nullable<string>,
      truncated: bool,
      kind: Option<HomeMemoryItemKind>,
      firstAt: Option<string>,
      lastAt: Option<string>,
      item: Option<HomeMemoryItem>
    )

  /// home.memory.view: at most 50 lines and 128 KiB encoded JSON.
  // @wire
  datatype HomeMemoryView = HomeMemoryView(
      homeId: string,
      revision: string,
      totalMessages: int,
      lines: seq<HomeMemoryViewLine>,
      nextCursor: Option<string>
    )

  // @wire enum
  datatype HomeMemoryEvidencePageFormat = {:wire "canonical-history"} canonicalHistory

  /// home.memory.evidence: the shared history owner's bounded content rendering.
  /// Not raw JSONL or attachment bytes. Off-branch/context-edited originals remain
  /// canonical facts; their projected exclusions do not erase the source.
  // @wire
  datatype HomeMemoryEvidencePage = HomeMemoryEvidencePage(
      format: HomeMemoryEvidencePageFormat,
      evidence: HomeMemoryEvidence,
      text: string,
      offset: int,
      nextOffset: Option<int>,
      previousOffset: Option<int>,
      totalCharacters: int,
      metadata: map<string, JsonValue>
    )

  // @wire enum
  datatype HomeOpenLogicalSessionId = home

  /// `home.open`: a logical route and its current physical binding. It does not
  /// materialize a reserved chapter; clients attach physically only when an active
  /// chapter exists.
  // @wire
  datatype HomeOpen = HomeOpen(
      logicalSessionId: HomeOpenLogicalSessionId,
      homeId: string,
      bindingRevision: real,
      sessionId: string,
      generation: real,
      chapterState: HomeChapterSummaryState
    )

  /// Process-owned task recovery projection; refusal fences only task surfaces
  /// until the next Gateway start, never ordinary session readiness.
  // @wire tag=available
  datatype HomeStatusTaskRecovery =
    | {:wire true} AvailableTrue
    | {:wire false} AvailableFalse(
        reason: string
      )

  // @wire enum
  datatype HomeStatusHostPressureLevel = normal | elevated | critical

  /// Host pressure at this read (#915, docs/host-load.md); informational: workers are never held back.
  // @wire
  datatype HomeStatusHostPressure = HomeStatusHostPressure(
      level: HomeStatusHostPressureLevel,
      load1PerCpu: real,
      eventLoopUtilization: real,
      sampledAt: string
    )

  /// Home workers running (or launching) now; there is no running cap (#1023).
  // @wire
  datatype HomeStatusWorkers = HomeStatusWorkers(running: int)

  /// Derived from the durable designation, runtime presence, memory and current/last activation.
  // @wire enum
  datatype HomeStatusPhase = unavailable | undesignated | disabled | {:wire "missing-session"} missingSession | {:wire "rollover-pending"} rolloverPending | blocked | paused | active | ready

  // @wire enum
  datatype HomeContextBreakdownActivationState = running | settled

  // @wire enum
  datatype HomeContextBreakdownActivationKind = user | wake

  // @wire
  datatype HomeContextBreakdownActivation = HomeContextBreakdownActivation(state: HomeContextBreakdownActivationState, kind: HomeContextBreakdownActivationKind, startedAt: string)

  // @wire enum
  datatype HomeContextSectionId = instructions | profile | memory | chapter | results | input

  /// One section of a Home request's effective size. Tokens are estimates; the sections
  /// sum to the breakdown's `effectiveTokens`.
  // @wire
  datatype HomeContextSection = HomeContextSection(
      id: HomeContextSectionId,
      tokens: int,
      /// The section's own unit: profile notes, memory summary lines, chapter entries or
      /// task results. Absent for instructions and input.
      count: Option<int>
    )

  /// The last request an activation prepared, by section.
  // @wire
  datatype HomeContextBreakdown = HomeContextBreakdown(
      activation: HomeContextBreakdownActivation,
      contextWindow: int,
      effectiveTokens: int,
      sections: seq<HomeContextSection>
    )

  /// `home.context`: the bounded request context of Home's current or last
  /// activation, and nothing else. It carries no message body: the activation's
  /// start entry is named by id, the memory view only by its line and byte counts,
  /// and the refusal only by its reason and detail. A caller that needs the
  /// conversation reads the transcript, and the view text never leaves the request
  /// that carried it.
  // @wire tag=available
  datatype HomeContextProjection =
    | {:wire false} AvailableFalse
    | {:wire true} AvailableTrue(
        /// The canonical entry the activation's input followed; null when nothing
        /// preceded it (the first activation of an empty Home).
        activationStartEntryId: Nullable<string>,
        /// Whether that activation is still open (its run has not settled).
        activationOpen: bool,
        /// The sizes of the request that activation prepared. Absent when it was
        /// refused before it prepared one: the start entry and the refusal below are
        /// still this activation's, never another's.
        viewLines: Option<int>,
        viewBytes: Option<int>,
        effectiveTokens: Option<int>,
        contextWindow: Option<int>,
        /// The request's effective size by section, present with the sizes above.
        breakdown: Option<HomeContextBreakdown>,
        /// This activation's own refusal, when it was refused.
        lastRefusalReason: Option<string>,
        lastRefusalDetail: Option<string>
      )

  // @wire
  datatype HomeStatusReadiness = HomeStatusReadiness(ready: bool, gaps: seq<string>)

  // @wire enum
  datatype HomeStatusRecoveryAction = {:wire "inspect-record"} inspectRecord | designate | {:wire "configure-memory"} configureMemory | {:wire "resume-memory"} resumeMemory | none

  // @wire
  datatype HomeStatusRecovery = HomeStatusRecovery(action: HomeStatusRecoveryAction, reason: Option<string>)

  // @wire enum
  datatype HomeStatusChapterRecoveryDecision = none | reserved | materializing

  // @wire
  datatype HomeStatusChapter = HomeStatusChapter(
      count: int,
      currentBytes: Option<int>,
      currentEntries: Option<int>,
      recoveryDecision: HomeStatusChapterRecoveryDecision
    )

  // @wire
  datatype HomeMemoryStatusEpisodicNodesByLevelItem = HomeMemoryStatusEpisodicNodesByLevelItem(level: real, count: real)

  // @wire
  datatype HomeMemoryStatusEpisodicNodes = HomeMemoryStatusEpisodicNodes(
      total: real,
      free: real,
      summary: real,
      byLevel: seq<HomeMemoryStatusEpisodicNodesByLevelItem>
    )

  // @wire
  datatype HomeMemoryStatusEpisodicViewPartsItem = HomeMemoryStatusEpisodicViewPartsItem(
      address: string,
      start: real,
      messages: real,
      bytes: real,
      built: bool
    )

  // @wire
  datatype HomeMemoryStatusEpisodicView = HomeMemoryStatusEpisodicView(
      parts: seq<HomeMemoryStatusEpisodicViewPartsItem>,
      truncatedParts: real,
      bytes: real,
      budgetBytes: real,
      built: int,
      unbuilt: int
    )

  // @wire
  datatype HomeMemoryStatusEpisodicCoverage = HomeMemoryStatusEpisodicCoverage(admitted: real, summarized: real)

  // @wire
  datatype HomeMemoryStatusEpisodicPump = HomeMemoryStatusEpisodicPump(busy: real)

  // @wire
  datatype HomeMemoryStatusEpisodicBlocked = HomeMemoryStatusEpisodicBlocked(reason: string, detail: Option<string>)

  // @wire
  datatype HomeMemoryStatusEpisodicTokensSinceOpen = HomeMemoryStatusEpisodicTokensSinceOpen(
      input: real,
      output: real,
      cacheRead: real,
      cacheWrite: real
    )

  /// Spend, reported and never a ceiling (#493).
  // @wire
  datatype HomeMemoryStatusEpisodicTokens = HomeMemoryStatusEpisodicTokens(used: real, sinceOpen: HomeMemoryStatusEpisodicTokensSinceOpen)

  // @wire
  datatype HomeMemoryStatusEpisodic = HomeMemoryStatusEpisodic(
      sourceSessionId: string,
      generation: real,
      messages: int,
      nodes: HomeMemoryStatusEpisodicNodes,
      view: HomeMemoryStatusEpisodicView,
      coverage: HomeMemoryStatusEpisodicCoverage,
      pump: HomeMemoryStatusEpisodicPump,
      blocked: Nullable<HomeMemoryStatusEpisodicBlocked>,
      /// Spend, reported and never a ceiling (#493).
      tokens: HomeMemoryStatusEpisodicTokens
    )

  /// `home.status`'s memory part. `configured` is the record's decision, `open` is
  /// whether the memory's store is serving, `episodic` is the memory owner's own
  /// bounded status (view sizes, coverage, pump, blocked state, token spend) and is
  /// absent until that store is open, and `blocked` is the block's reason, reported
  /// even when the store is not open.
  // @wire
  datatype HomeMemoryStatus = HomeMemoryStatus(
      /// Durable operator suspension. Independent of a compactor/source block.
      paused: Option<bool>,
      configured: bool,
      open: bool,
      /// The background model queue the memory summarizes with, `provider/id` in order.
      models: Option<seq<string>>,
      /// Tokens this memory has spent over its life, read from its persisted state;
      /// present whenever a store exists, open or not, because a restart restores it.
      /// Reported, never a ceiling: the memory regulates its own spend (#493).
      spentTokens: Option<int>,
      episodic: Option<HomeMemoryStatusEpisodic>,
      blocked: Option<string>,
      reason: Option<string>
    )

  /// `home.status`: the one bounded Home projection. It is a read and performs no
  /// inference. `available` is false only when a stored record exists but cannot be
  /// used, which `reason` explains; the preserved record is never overwritten.
  /// `live` is whether the session holds a runtime right now; `sessionPresent` is
  /// whether it exists at all, live or still on disk.
  // @wire
  datatype HomeStatus = HomeStatus(
      /// Process-owned task recovery projection; refusal fences only task surfaces
      /// until the next Gateway start, never ordinary session readiness.
      taskRecovery: HomeStatusTaskRecovery,
      /// Host pressure at this read (#915, docs/host-load.md); informational: workers are never held back.
      hostPressure: HomeStatusHostPressure,
      /// Home workers running (or launching) now; there is no running cap (#1023).
      workers: HomeStatusWorkers,
      /// Derived from the durable designation, runtime presence, memory and current/last activation.
      phase: HomeStatusPhase,
      /// Current or last activation evidence; never includes message or memory-view bodies.
      activation: HomeContextProjection,
      readiness: HomeStatusReadiness,
      recovery: HomeStatusRecovery,
      available: bool,
      reason: Option<string>,
      enabled: bool,
      homeId: Option<string>,
      sessionId: Option<string>,
      /// The newest chapter a client may open: `sessionId` when it is present, or the
      /// sealed predecessor while `rollover-pending`. Absent when nothing is openable.
      /// Sends from it still go through `home.prompt`, which materializes the successor.
      openSessionId: Option<string>,
      bindingRevision: Option<real>,
      generation: Option<int>,
      routeGeneration: Option<int>,
      chapter: Option<HomeStatusChapter>,
      live: bool,
      sessionPresent: bool,
      /// True while Home's live openable chapter is blocked on a semantic user
      /// interaction (a pending ask_user question). Absent on an undesignated Home.
      waitingForUser: Option<bool>,
      /// Home's memory, once a record names one. There are no memory defaults
      /// (decision D4), so a Home whose memory is unconfigured refuses its
      /// activations until the memory model is set (`model.ref[role=memory]`).
      memory: HomeMemoryStatus
    )

  // @wire
  datatype HomeDesignation = HomeDesignation(homeId: string, sessionId: string, generation: real)

  /// The name a task is shown by: its worker session's name when set, else its brief's first
  /// non-empty line, and at most 80 characters.
  // @wire
  datatype HomeTaskDisplay = HomeTaskDisplay(
      title: string,
      /// The target directory's last path component.
      project: string
    )

  /// Exact counts over the queried catalog, independent of any page: taskList counts
  /// current lineages; the task tool counts operation records. `active` is non-terminal.
  // @wire
  datatype HomeTaskCounts = HomeTaskCounts(active: real, finished: real)

  // @wire
  datatype HomeTaskCheckinRequestRefs = HomeTaskCheckinRequestRefs(branch: Option<string>, commit: Option<string>, issue: Option<string>)

  // @wire
  datatype HomeTaskCheckinRequest = HomeTaskCheckinRequest(
      step: string,
      done: string,
      next: string,
      blocker: Option<string>,
      refs: Option<HomeTaskCheckinRequestRefs>,
      needsAttention: Option<bool>
    )

  // @wire enum
  datatype HomeTaskCheckinAttention = none | requested | {:wire "rate-limited"} rateLimited | pending

  // @wire
  datatype HomeTaskCheckin = HomeTaskCheckin(
      step: string,
      done: string,
      next: string,
      blocker: Option<string>,
      refs: Option<HomeTaskCheckinRequestRefs>,
      needsAttention: Option<bool>,
      id: string,
      taskId: string,
      sessionId: string,
      operationId: string,
      at: string,
      attention: HomeTaskCheckinAttention := HomeTaskCheckinAttention.none
    )

  // @wire enum
  datatype HomeTaskLifecycle = pending | active | terminal

  // @wire enum
  datatype HomeTaskOutcome = progress | {:wire "needs-input"} needsInput | final | limited | interrupted | unknown

  /// `inputTokens` is fresh input; cache read/write are separate (#1250). Records
  /// from before that omit both cache fields and count cache inside `inputTokens`.
  // @wire
  datatype HomeTaskSummarySpend = HomeTaskSummarySpend(
      sourceDigest: string,
      inputTokens: int,
      outputTokens: int,
      cacheReadTokens: Option<int>,
      cacheWriteTokens: Option<int>
    )

  /// home.taskList: one current row per resume lineage, newest first; no canonical reports.
  // @wire
  datatype HomeTaskSummary = HomeTaskSummary(
      title: string,
      /// The target directory's last path component.
      project: string,
      taskId: string,
      createdAt: int,
      updatedAt: int,
      /// The worker session the task dispatched (the task's `sessionId`), or null before dispatch.
      sessionId: Nullable<string>,
      target: string,
      lifecycle: HomeTaskLifecycle,
      outcome: Nullable<HomeTaskOutcome>,
      /// `inputTokens` is fresh input; cache read/write are separate (#1250). Records
      /// from before that omit both cache fields and count cache inside `inputTokens`.
      spend: Nullable<HomeTaskSummarySpend>,
      attention: bool,
      checkins: seq<HomeTaskCheckin>,
      pendingGrant: bool
    )

  // @wire
  datatype HomeTaskTerminalEvidence = HomeTaskTerminalEvidence(outcome: HomeTaskOutcome, reason: string)

  // @wire
  datatype HomeTaskIntent = HomeTaskIntent(text: string)

  // @wire enum
  datatype HomeTaskWakeState = pending | claimed | admitted | terminal | acknowledged | blocked | {:wire "outcome-unknown"} outcomeUnknown

  /// The session operation a task's result wake was delivered into.
  // @wire
  datatype HomeTaskWakeDelivery = HomeTaskWakeDelivery(
      sessionId: string,
      operationId: string,
      generation: int,
      routeGeneration: int,
      messageDigest: string
    )

  /// The task's result wake to Home; null until the task is terminal.
  // @wire
  datatype HomeTaskWake = HomeTaskWake(
      state: HomeTaskWakeState,
      routeGeneration: int,
      delivery: Nullable<HomeTaskWakeDelivery>
    )

  /// Subagents the worker started, and how many were still running when its operation ended.
  // @wire
  datatype HomeTaskSubagents = HomeTaskSubagents(started: int, stoppedAtEnd: Nullable<int>)

  // @wire
  datatype HomeTaskSubagentRun = HomeTaskSubagentRun(
      runId: string,
      agent: string,
      state: ExtensionRunLifecycleState,
      startedAt: string,
      lastActivityAt: Nullable<string>
    )

  /// The worker's live subagent runs: at most 20 of `total`.
  // @wire
  datatype HomeTaskSubagentRuns = HomeTaskSubagentRuns(total: int, runs: seq<HomeTaskSubagentRun>)

  /// The model of the task's worker session.
  // @wire
  datatype HomeTaskWorkerModel = HomeTaskWorkerModel(provider: string, id: string)

  /// home.taskStatus: the fields a client reads from one task's current status. The
  /// Gateway's status value is checked against this type where the RPC returns it.
  // @wire
  datatype HomeTaskStatusResult = HomeTaskStatusResult(
      taskId: string,
      homeId: string,
      createdAt: int,
      updatedAt: int,
      intent: HomeTaskIntent,
      /// The name a task is shown by (HomeTaskDisplay).
      title: string,
      /// The target directory's last path component.
      project: string,
      /// The worker session the task dispatched, or null before dispatch.
      sessionId: Nullable<string>,
      target: string,
      lifecycle: HomeTaskLifecycle,
      operationId: Nullable<string>,
      spend: Nullable<HomeTaskSummarySpend>,
      terminalEvidence: Nullable<HomeTaskTerminalEvidence>,
      wake: Nullable<HomeTaskWake>,
      workerModel: Nullable<HomeTaskWorkerModel>,
      subagents: HomeTaskSubagents,
      subagentRuns: HomeTaskSubagentRuns,
      /// The latest check-ins, oldest first.
      checkins: seq<HomeTaskCheckin>
    )

  /// A finite lineage event: every operation, including those with no check-ins, and
  /// every accepted canonical check-in. Operation state is current, not state at check-in.
  // @wire
  datatype HomeTaskHistoryItem = HomeTaskHistoryItem(
      id: string,
      at: string,
      taskId: string,
      operationId: Nullable<string>,
      operationNumber: int,
      lifecycle: HomeTaskLifecycle,
      outcome: Nullable<HomeTaskOutcome>,
      checkin: Option<HomeTaskCheckin>
    )

  // @wire
  datatype HomeTaskHistoryPage = HomeTaskHistoryPage(
      items: seq<HomeTaskHistoryItem>,
      total: int,
      /// False when canonical nested-call details cannot prove older exact records.
      complete: bool,
      nextCursor: Option<string>
    )

  // @wire
  datatype HomeTaskPage = HomeTaskPage(
      items: seq<HomeTaskSummary>,
      nextCursor: Option<string>,
      /// Exact current-lineage counts, read with this page; never capped by `limit`.
      counts: HomeTaskCounts
    )
}
