// DevicePerformance.xcconfig - Optimized hosted-test measurement build on the production identity.
// scripts/tron-profile ios (simulator) and the pinned-device baseline run
// hosted XCTest scenarios against this build, so it compiles like the shipping
// app: Swift -O with whole-module optimization (the LocalDevice/Release codegen,
// including cross-file inlining and generic specialization) and optimized Clang.
// Testability and HOSTED_TEST stay on only because the hosted test bundle
// imports the app with @testable and uses hosted fixtures.
#include "Base.xcconfig"

DEBUG_INFORMATION_FORMAT = dwarf
GCC_OPTIMIZATION_LEVEL = 3
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
ENABLE_TESTABILITY = YES
ENABLE_NS_ASSERTIONS = NO
ONLY_ACTIVE_ARCH = YES
MTL_ENABLE_DEBUG_INFO = NO

SWIFT_ACTIVE_COMPILATION_CONDITIONS = HOSTED_TEST
PRODUCT_BUNDLE_IDENTIFIER = com.tron.mobile
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
TRON_BUILD_ROLE = device-performance
TRON_PUSH_ROUTE = production-sandbox
TRON_PRIVATE_BLUR_ENABLED = NO
TRON_APNS_ENVIRONMENT = development
TRON_APP_ATTEST_ENVIRONMENT = development
