// Test.xcconfig - Hosted-test app identity; beta relay route is not a real APNs lane
#include "Debug.xcconfig"

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG HOSTED_TEST
PRODUCT_BUNDLE_IDENTIFIER = com.tron.mobile.testhost
ASSETCATALOG_COMPILER_APPICON_NAME = AppIconBeta
TRON_BUILD_ROLE = hosted-test
