// Base.xcconfig - Shared settings for all configurations

TRON_MAC_DOWNLOAD_URL = https:/$()/github.com/tron-owner/tron/releases
// Public product endpoint only. Official archives override this in Local.xcconfig;
// no push credential is compiled into the application.
TRON_PUSH_SERVICE_ORIGIN =

// App info lives in project.yml and is generated from VERSION.env.
// Local.xcconfig may override release URLs without committing
// maintainer-specific values.
#include? "Local.xcconfig"
